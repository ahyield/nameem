<%= render "backoffice/shared/page_header", count: @pagy.count %>

<%= render "backoffice/shared/toolbar", url: backoffice_tags_path %>

<% if @tags.any? %>
  <ul class="bo-panel divide-y divide-gray-200/70">
    <% @tags.each do |tag| %>
      <li>
        <%= link_to backoffice_tag_path(tag), class: "bo-row" do %>
          <span class="min-w-0 flex-1 truncate text-sm font-medium"><%= tag.name %></span>
          <span class="w-20 shrink-0 text-xs text-gray-500 tabular-nums"><%= number_with_delimiter(tag.articles_count) %> مقال</span>
          <span class="hidden sm:block w-20 shrink-0 text-xs text-gray-500 tabular-nums"><%= number_with_delimiter(tag.followers_count) %> متابع</span>
          <svg class="h-4 w-4 shrink-0 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
        <% end %>
      </li>
    <% end %>
  </ul>
  <% if @pagy.last > 1 %>
    <div class="mt-4"><%== @pagy.series_nav %></div>
  <% end %>
<% else %>
  <%= render "backoffice/shared/empty_state", message: "لا توجد مواضيع" %>
<% end %>
