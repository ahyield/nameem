<!-- Search -->
<div class="flex items-center justify-end mb-6">
  <div data-controller="backoffice-search">
    <%= form_with url: backoffice_tags_path, method: :get, data: { backoffice_search_target: "form" } do |f| %>
      <div class="relative">
        <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3">
          <svg class="h-3.5 w-3.5 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
        </div>
        <%= f.text_field :q, value: params[:q],
            placeholder: "بحث...",
            class: "block w-72 border border-input bg-transparent rounded-md py-1.5 pr-9 pl-3 text-[13px] text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-1 focus:ring-ring focus:border-ring transition-colors",
            data: { action: "input->backoffice-search#search" } %>
      </div>
    <% end %>
  </div>
</div>

<!-- Table Card -->
<% if @tags.any? %>
  <div class="rounded-xl border border-border bg-card">
    <div class="overflow-x-auto">
      <table class="min-w-full">
        <thead>
          <tr class="border-b border-border">
            <th class="px-6 py-3 text-right text-[11px] font-medium text-muted-foreground uppercase tracking-wider">الاسم</th>
            <th class="px-4 py-3 text-right text-[11px] font-medium text-muted-foreground uppercase tracking-wider">المعرف</th>
            <th class="px-4 py-3 text-right text-[11px] font-medium text-muted-foreground uppercase tracking-wider">المقالات</th>
            <th class="px-4 py-3 text-right text-[11px] font-medium text-muted-foreground uppercase tracking-wider">المتابعين</th>
            <th class="px-6 py-3 text-left text-[11px] font-medium text-muted-foreground uppercase tracking-wider"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border">
          <% @tags.each do |tag| %>
            <tr class="group hover:bg-muted/50 transition-colors">
              <td class="px-6 py-3 whitespace-nowrap">
                <%= link_to tag.name, backoffice_tag_path(tag), class: "text-[13px] font-medium text-foreground hover:text-muted-foreground" %>
              </td>
              <td class="px-4 py-3 whitespace-nowrap text-[13px] text-muted-foreground"><%= tag.slug %></td>
              <td class="px-4 py-3 whitespace-nowrap text-[13px] text-muted-foreground tabular-nums"><%= tag.articles_count %></td>
              <td class="px-4 py-3 whitespace-nowrap text-[13px] text-muted-foreground tabular-nums"><%= tag.followers.count %></td>
              <td class="px-6 py-3 whitespace-nowrap text-left">
                <div class="flex items-center gap-3 opacity-0 group-hover:opacity-100 transition-opacity">
                  <%= link_to backoffice_tag_path(tag), class: "text-muted-foreground hover:text-foreground", title: "عرض" do %>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                  <% end %>
                  <%= link_to edit_backoffice_tag_path(tag), class: "text-muted-foreground hover:text-foreground", title: "تعديل" do %>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                  <% end %>
                  <%= button_to backoffice_tag_path(tag), method: :delete, class: "text-muted-foreground hover:text-destructive", title: "حذف", data: { turbo_confirm: "هل أنت متأكد من حذف هذا الموضوع؟" } do %>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <div class="border-t border-border px-6 py-3">
      <%== @pagy.series_nav %>
    </div>
  </div>
<% else %>
  <%= render "backoffice/shared/empty_state", message: "لا توجد مواضيع" %>
<% end %>
