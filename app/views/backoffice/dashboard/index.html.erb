<%= render "shared/nav" %>
<%= render "flashes/alert", alert: flash[:alert] if !flash[:alert].nil? %>
<%= render "flashes/notice", notice: flash[:notice] if !flash[:notice].nil? %>
<%= render "flashes/error", error: flash[:error] if !flash[:error].nil? %>

<main class="font-montserrat">
  <div class="pt-16">
    <%= render "backoffice/nav" %>
    <div>
      <dl class="mt-5 grid grid-cols-1 gap-5 sm:grid-cols-3">
        <div class="overflow-hidden rounded-lg bg-white px-4 py-5 shadow sm:p-6">
          <%= link_to backoffice_users_path, class: "text-sm font-medium text-gray-500" do %>
            <dt class="truncate text-sm font-medium text-gray-500">المستخدمين</dt>
            <dd class="mt-1 text-3xl font-semibold tracking-tight text-gray-900"><%= User.all.size %></dd>
          <% end %>
        </div>
        <div class="overflow-hidden rounded-lg bg-white px-4 py-5 shadow sm:p-6">
          <%= link_to backoffice_articles_path, class: "text-sm font-medium text-gray-500" do %>
            <dt class="truncate text-sm font-medium text-gray-500">المقالات المنشورة</dt>
            <dd class="mt-1 text-3xl font-semibold tracking-tight text-gray-900"><%= Article.published.size %></dd>
          <% end %>
        </div>
      </dl>
    </div>
  </div>
</main>
