<!-- Stat Cards -->
<div class="grid grid-cols-2 lg:grid-cols-5 gap-4 mb-6">
  <%= render "backoffice/shared/stat_card", label: "المقالات المنشورة", value: @stats[:published_articles] %>
  <%= render "backoffice/shared/stat_card", label: "المستخدمين", value: @stats[:total_users] %>
  <%= render "backoffice/shared/stat_card", label: "التعليقات", value: @stats[:total_comments] %>
  <%= render "backoffice/shared/stat_card", label: "الإعجابات", value: @stats[:total_likes] %>
  <%= render "backoffice/shared/stat_card", label: "المواضيع", value: @stats[:total_tags] %>
</div>

<!-- New this week -->
<div class="mb-6">
  <span class="text-[13px] text-gray-500"><span class="text-gray-950 font-semibold tabular-nums"><%= @this_week[:new_users] %></span> مستخدم جديد هذا الأسبوع</span>
</div>

<!-- Activity Feed -->
<div class="rounded-xl border border-gray-200 bg-white">
  <div class="p-6 pb-4">
    <h2 class="text-[15px] font-semibold text-gray-950">النشاط الأخير</h2>
  </div>
  <div class="px-6 pb-6">
    <%
      activity = []
      @recent_users.each { |u| activity << { type: :user, obj: u, time: u.created_at } }
      @recent_articles.each { |a| activity << { type: :article, obj: a, time: a.published_at || a.created_at } }
      @recent_comments.each { |c| activity << { type: :comment, obj: c, time: c.created_at } }
      activity.sort_by! { |a| -a[:time].to_i }
    %>
    <div class="divide-y divide-gray-200">
      <% activity.first(20).each do |item| %>
        <div class="flex items-center gap-4 py-2.5">
          <% case item[:type] %>
          <% when :user %>
            <span class="text-[11px] font-medium text-gray-500 uppercase tracking-wider w-14 shrink-0">مستخدم</span>
            <div class="flex-1 min-w-0">
              <%= link_to backoffice_user_path(item[:obj]), class: "text-[13px] text-gray-950 hover:text-gray-500 truncate block" do %>
                <%= item[:obj].name %>
              <% end %>
            </div>
            <span class="text-[12px] text-gray-500 shrink-0"><%= item[:obj].email %></span>
          <% when :article %>
            <span class="text-[11px] font-medium text-gray-500 uppercase tracking-wider w-14 shrink-0">مقال</span>
            <div class="flex-1 min-w-0">
              <%= link_to backoffice_article_path(item[:obj]), class: "text-[13px] text-gray-950 hover:text-gray-500 truncate block" do %>
                <%= item[:obj].title.presence || item[:obj].uuid %>
              <% end %>
            </div>
            <span class="text-[12px] text-gray-500 shrink-0"><%= item[:obj].user.name %></span>
          <% when :comment %>
            <span class="text-[11px] font-medium text-gray-500 uppercase tracking-wider w-14 shrink-0">تعليق</span>
            <div class="flex-1 min-w-0">
              <%= link_to backoffice_comment_path(item[:obj]), class: "text-[13px] text-gray-950 hover:text-gray-500 truncate block" do %>
                <%= item[:obj].body.to_plain_text.truncate(60) %>
              <% end %>
            </div>
            <span class="text-[12px] text-gray-500 shrink-0"><%= item[:obj].user.name %></span>
          <% end %>
          <span class="text-[12px] text-gray-500 shrink-0 tabular-nums"><%= time_ago_in_words(item[:time]) %></span>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- Trending -->
<% if @trending_articles.any? %>
  <div class="rounded-xl border border-gray-200 bg-white mt-6">
    <div class="p-6 pb-4">
      <h2 class="text-[15px] font-semibold text-gray-950">الرائجة</h2>
    </div>
    <div class="px-6 pb-6">
      <div class="divide-y divide-gray-200">
        <% @trending_articles.each_with_index do |article, index| %>
          <div class="flex items-center gap-4 py-2.5">
            <span class="text-[13px] font-semibold text-gray-500 tabular-nums w-5 shrink-0 text-center"><%= index + 1 %></span>
            <div class="flex-1 min-w-0">
              <%= link_to backoffice_article_path(article), class: "text-[13px] text-gray-950 hover:text-gray-500 truncate block" do %>
                <%= article.title.presence || article.uuid %>
              <% end %>
            </div>
            <span class="text-[12px] text-gray-500 shrink-0"><%= article.user.name %></span>
            <span class="text-[12px] text-gray-500 shrink-0 tabular-nums"><%= article.real_views_count || 0 %> مشاهدة</span>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
