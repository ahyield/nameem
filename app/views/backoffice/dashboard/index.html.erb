<%= render "backoffice/shared/page_header" %>

<dl class="mb-8 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-px overflow-hidden rounded-xl border border-gray-200/70 bg-gray-200/70">
  <% @stats.each_with_index do |stat, index| %>
    <div class="bg-surface p-5 <%= "col-span-2 sm:col-span-1" if @stats.size.odd? && index == @stats.size - 1 %>">
      <dt class="bo-label"><%= stat[:label] %></dt>
      <dd class="mt-1 text-2xl font-semibold text-gray-900 tabular-nums"><%= number_with_delimiter(stat[:value]) %></dd>
      <% if stat[:week].to_i.positive? %>
        <dd class="mt-0.5 text-xs text-gray-500"><span class="text-orange-700 tabular-nums">+<%= number_with_delimiter(stat[:week]) %></span> هذا الأسبوع</dd>
      <% end %>
    </div>
  <% end %>
</dl>

<div class="grid gap-8 lg:grid-cols-5">
  <section class="lg:col-span-3">
    <h2 class="mb-3 text-sm font-semibold text-gray-900">النشاط الأخير</h2>
    <div class="bo-panel divide-y divide-gray-200/70">
      <% @activity.each do |item| %>
        <% record = item[:record] %>
        <% case item[:type] %>
        <% when :user %>
          <%= link_to backoffice_user_path(record), class: "bo-row" do %>
            <%= backoffice_avatar(record, size: 24) %>
            <span class="min-w-0 flex-1 truncate text-sm"><span class="font-medium"><%= record.name %></span> <span class="text-gray-500">انضم</span></span>
            <span class="shrink-0 text-xs text-gray-500"><%= time_ago_in_words(item[:time]) %></span>
          <% end %>
        <% when :article %>
          <%= link_to backoffice_article_path(record), class: "bo-row" do %>
            <%= backoffice_avatar(record.user, size: 24) %>
            <span class="min-w-0 flex-1 truncate text-sm"><span class="text-gray-500">نشر</span> <span class="font-medium"><%= record.title.presence || record.uuid %></span></span>
            <span class="shrink-0 text-xs text-gray-500"><%= time_ago_in_words(item[:time]) %></span>
          <% end %>
        <% when :comment %>
          <%= link_to backoffice_comment_path(record), class: "bo-row" do %>
            <%= backoffice_avatar(record.user, size: 24) %>
            <span class="min-w-0 flex-1 truncate text-sm"><span class="text-gray-500">علّق:</span> <%= record.body.to_plain_text.truncate(80) %></span>
            <span class="shrink-0 text-xs text-gray-500"><%= time_ago_in_words(item[:time]) %></span>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </section>

  <section class="lg:col-span-2">
    <h2 class="mb-3 text-sm font-semibold text-gray-900">الرائجة هذا الأسبوع</h2>
    <% if @trending_articles.any? %>
      <ol class="bo-panel divide-y divide-gray-200/70">
        <% @trending_articles.each_with_index do |article, index| %>
          <li>
            <%= link_to backoffice_article_path(article), class: "bo-row" do %>
              <span class="w-4 shrink-0 text-center text-sm font-semibold text-gray-400 tabular-nums"><%= index + 1 %></span>
              <span class="min-w-0 flex-1">
                <span class="block truncate text-sm font-medium"><%= article.title.presence || article.uuid %></span>
                <span class="block truncate text-xs text-gray-500"><%= article.user.name %></span>
              </span>
              <span class="shrink-0 text-xs text-gray-500 tabular-nums" title="درجة الرواج: تفاعل الأيام الأخيرة، والأحدث أثقل وزناً">
                <%= number_with_precision(article.trending_score, precision: 1) %> نقطة · <%= number_with_delimiter(article.real_views_count || 0) %> مشاهدة
              </span>
            <% end %>
          </li>
        <% end %>
      </ol>
    <% else %>
      <%= render "backoffice/shared/empty_state", message: "لا توجد مقالات رائجة هذا الأسبوع" %>
    <% end %>
  </section>
</div>
