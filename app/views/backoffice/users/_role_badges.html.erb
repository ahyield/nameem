<span class="inline-flex flex-wrap gap-1">
  <% { admin?: "مدير", editor?: "محرر", featured?: "مميز", picked?: "مختار" }.each do |role, label| %>
    <% if user.public_send(role) %>
      <%= status_badge(label, :active) %>
    <% end %>
  <% end %>
  <% if user.suspended? %>
    <%= status_badge("موقوف") %>
  <% end %>
  <% if !user.confirmed? %>
    <%= status_badge("غير مؤكد") %>
  <% end %>
</span>
