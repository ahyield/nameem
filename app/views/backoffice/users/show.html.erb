<div class="mb-8 flex flex-wrap items-start gap-4">
  <%= backoffice_avatar(@user, size: 56) %>
  <div class="min-w-0 flex-1">
    <h1 class="text-xl font-semibold text-gray-900"><%= @user.name %></h1>
    <div class="mt-2 flex flex-wrap gap-1.5">
      <% [
        ["@#{@user.slug}", "اسم المستخدم", "M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207"],
        [@user.email, "البريد الإلكتروني", "M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"]
      ].each do |value, label, icon| %>
        <span data-controller="clipboard" data-clipboard-success-content-value="تم النسخ ✓" class="contents">
          <input type="hidden" value="<%= value %>" data-clipboard-target="source">
          <button type="button" data-action="clipboard#copy" data-clipboard-target="button" title="نسخ <%= label %>"
                  class="bo-btn inline-flex max-w-full items-center gap-1.5 rounded-md bg-gray-100 px-2 py-1 text-xs font-normal text-gray-700 hover:bg-gray-200">
            <svg class="h-3.5 w-3.5 shrink-0 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="<%= icon %>" />
            </svg>
            <bdi dir="ltr" class="truncate font-montserrat"><%= value %></bdi>
          </button>
        </span>
      <% end %>
    </div>
    <% if @user.bio.present? %>
      <p class="mt-2 max-w-prose text-sm text-gray-600"><%= @user.bio %></p>
    <% end %>
  </div>
  <%= link_to "عرض الملف", user_path(@user), class: "bo-btn bo-btn-ghost", target: "_blank", rel: "noopener" %>
</div>

<dl class="mb-8 flex flex-wrap gap-x-8 gap-y-3">
  <% [
    ["مقال", @user.articles.count],
    ["متابع", @user.followers_count],
    ["يتابع", @user.following_count],
    ["إعجاب", @user.article_likes.count],
    ["تعليق", @user.comments.count]
  ].each do |label, value| %>
    <div class="flex items-baseline gap-1.5">
      <dt class="order-2 text-sm text-gray-500"><%= label %></dt>
      <dd class="order-1 text-lg font-semibold text-gray-900 tabular-nums"><%= number_with_delimiter(value) %></dd>
    </div>
  <% end %>
</dl>

<div class="grid gap-8 lg:grid-cols-5">
  <section class="lg:col-span-2">
    <h2 class="mb-3 text-sm font-semibold text-gray-900">الأدوار</h2>
    <div class="bo-panel divide-y divide-gray-200/70 px-4">
      <% roles = [
        ["confirmed", "مؤكد", "تأكيد حساب المستخدم"],
        ["featured", "مميز", "يظهر في الصفحة الرئيسية"],
        ["picked", "مختار", "ضمن اختيارات المحررين"]
      ] %>
      <% if current_user.admin? %>
        <% roles += [
          ["editor", "محرر", "يدخل لوحة التحكم"],
          ["admin", "مدير", "صلاحيات كاملة"]
        ] %>
      <% end %>
      <% roles.each do |role, label, description| %>
        <%= render "backoffice/shared/switch",
            id: "role-#{role}", label: label, description: description, on: @user.public_send(role),
            url: toggle_role_backoffice_user_path(@user), params: { role: role } %>
      <% end %>
    </div>
  </section>

  <section class="lg:col-span-3">
    <h2 class="mb-3 text-sm font-semibold text-gray-900">أحدث المقالات</h2>
    <% if @recent_articles.any? %>
      <ul class="bo-panel divide-y divide-gray-200/70">
        <% @recent_articles.each do |article| %>
          <li>
            <%= link_to backoffice_article_path(article), class: "bo-row" do %>
              <span class="min-w-0 flex-1 truncate text-sm font-medium"><%= article.title.presence || article.uuid %></span>
              <% if !article.published? %>
                <%= status_badge("مسودة") %>
              <% end %>
              <span class="shrink-0 text-xs text-gray-500"><%= time_ago_in_words(article.created_at) %></span>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <%= render "backoffice/shared/empty_state", message: "لا توجد مقالات" %>
    <% end %>
  </section>
</div>

<% if @reports_received.any? %>
  <section class="mt-8">
    <h2 class="mb-3 text-sm font-semibold text-gray-900">بلاغات عن محتواه</h2>
    <ul class="bo-panel divide-y divide-gray-200/70">
      <% @reports_received.each do |report| %>
        <li>
          <%= link_to backoffice_report_path(report), class: "bo-row" do %>
            <span class="min-w-0 flex-1 truncate text-sm"><%= report.snapshot.to_s.truncate(100) %></span>
            <span class="shrink-0 text-xs text-gray-500"><%= report.reason_label %></span>
            <%= status_badge({ "pending" => "معلق", "actioned" => "اتُّخذ إجراء", "dismissed" => "مرفوض" }[report.status],
                             report.pending? ? :active : :default) %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>

<% if current_user.admin? && @user != current_user %>
  <section class="mt-12 border-t border-gray-200/70 pt-6">
    <h2 class="text-sm font-semibold text-gray-900">إيقاف الحساب</h2>
    <% if @user.suspended? %>
      <p class="mt-1 mb-3 text-sm text-gray-500">
        موقوف منذ <%= time_ago_in_words(@user.suspended_at) %> · <%= @user.suspension_reason %>
      </p>
      <%= button_to "رفع الإيقاف", unsuspend_backoffice_user_path(@user), method: :post, class: "bo-btn bo-btn-ghost -mr-3" %>
    <% else %>
      <p class="mt-1 mb-3 text-sm text-gray-500">يبقى الحساب قادراً على القراءة، لكنه لا يستطيع النشر أو التعليق أو الإعجاب.</p>
      <%= form_with url: suspend_backoffice_user_path(@user), method: :post, class: "flex flex-wrap items-center gap-2" do %>
        <%= text_field_tag :reason, nil, placeholder: "السبب", class: "bo-input sm:w-64", autocomplete: "off", aria: { label: "سبب الإيقاف" } %>
        <%= submit_tag "إيقاف الحساب", class: "bo-btn bo-btn-danger", data: { turbo_confirm: "هل أنت متأكد من إيقاف هذا الحساب؟" } %>
      <% end %>
    <% end %>
  </section>

  <section class="mt-12 border-t border-gray-200/70 pt-6">
    <h2 class="text-sm font-semibold text-gray-900">حذف المستخدم</h2>
    <p class="mt-1 mb-3 text-sm text-gray-500">يحذف الحساب وكل مقالاته وتعليقاته. لا يمكن التراجع عن ذلك.</p>
    <%= button_to "حذف المستخدم", backoffice_user_path(@user), method: :delete, class: "bo-btn bo-btn-danger -mr-3",
        data: { turbo_confirm: "هل أنت متأكد من حذف هذا المستخدم؟" } %>
  </section>
<% end %>
