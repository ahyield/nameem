<div class="space-y-6">
  <!-- User Info Card -->
  <div class="rounded-[20px] bg-white shadow-xl shadow-gray-100/60 p-6">
    <div class="flex items-center gap-4 mb-5">
      <% if @user.avatar.attached? %>
        <%= image_tag @user.avatar.variant(resize_to_fill: [48, 48]), class: "h-12 w-12 rounded-full" %>
      <% else %>
        <span class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-indigo-100">
          <span class="text-base font-medium text-indigo-600"><%= @user.name&.first %></span>
        </span>
      <% end %>
      <div>
        <h2 class="text-[15px] font-semibold text-gray-950"><%= @user.name %></h2>
        <p class="text-[13px] text-gray-400"><%= @user.email %></p>
      </div>
    </div>

    <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <dt class="text-[11px] font-medium text-gray-400 uppercase tracking-wider">اسم المستخدم</dt>
        <dd class="mt-1 text-[13px] text-gray-950">@<%= @user.slug %></dd>
      </div>
      <div>
        <dt class="text-[11px] font-medium text-gray-400 uppercase tracking-wider">النبذة</dt>
        <dd class="mt-1 text-[13px] text-gray-950"><%= @user.bio.presence || "\u2014" %></dd>
      </div>
    </dl>
  </div>

  <!-- Edit Form Card -->
  <div class="rounded-[20px] bg-white shadow-xl shadow-gray-100/60 p-6">
    <h3 class="text-[11px] font-medium text-gray-400 uppercase tracking-wider mb-4">الأدوار والحالات</h3>

    <%= form_with model: @user, url: backoffice_user_path(@user), method: :put do |form| %>
      <div class="space-y-4">
        <label class="flex items-center gap-3 cursor-pointer group">
          <%= form.check_box :confirmed, class: "h-4 w-4 rounded border-gray-200 text-indigo-600 focus:ring-indigo-600" %>
          <div>
            <span class="text-[13px] font-medium text-gray-950">مؤكد</span>
            <p class="text-[12px] text-gray-400">تأكيد حساب المستخدم</p>
          </div>
        </label>

        <label class="flex items-center gap-3 cursor-pointer group">
          <%= form.check_box :featured, class: "h-4 w-4 rounded border-gray-200 text-indigo-600 focus:ring-indigo-600" %>
          <div>
            <span class="text-[13px] font-medium text-gray-950">مميز</span>
            <p class="text-[12px] text-gray-400">عرض في الصفحة الرئيسية</p>
          </div>
        </label>

        <label class="flex items-center gap-3 cursor-pointer group">
          <%= form.check_box :picked, class: "h-4 w-4 rounded border-gray-200 text-indigo-600 focus:ring-indigo-600" %>
          <div>
            <span class="text-[13px] font-medium text-gray-950">مختار</span>
            <p class="text-[12px] text-gray-400">اختيارات المحررين</p>
          </div>
        </label>

        <% if current_user.admin? %>
          <div class="pt-4 border-t border-gray-100">
            <p class="text-[11px] font-medium text-gray-400 uppercase tracking-wider mb-3">صلاحيات متقدمة</p>

            <div class="space-y-4">
              <label class="flex items-center gap-3 cursor-pointer group">
                <%= form.check_box :admin, class: "h-4 w-4 rounded border-gray-200 text-indigo-600 focus:ring-indigo-600" %>
                <div>
                  <span class="text-[13px] font-medium text-gray-950">مدير</span>
                  <p class="text-[12px] text-gray-400">صلاحيات كاملة</p>
                </div>
              </label>

              <label class="flex items-center gap-3 cursor-pointer group">
                <%= form.check_box :editor, class: "h-4 w-4 rounded border-gray-200 text-indigo-600 focus:ring-indigo-600" %>
                <div>
                  <span class="text-[13px] font-medium text-gray-950">محرر</span>
                  <p class="text-[12px] text-gray-400">دخول لوحة التحكم</p>
                </div>
              </label>
            </div>
          </div>
        <% end %>
      </div>

      <div class="mt-6 flex items-center gap-3">
        <%= form.submit "حفظ", class: "px-4 py-1.5 rounded-xl bg-indigo-600 text-white text-[13px] font-medium hover:bg-indigo-700 transition-colors cursor-pointer" %>
        <%= link_to "إلغاء", backoffice_user_path(@user), class: "text-[13px] font-medium text-gray-400 hover:text-gray-950 transition-colors" %>
      </div>
    <% end %>
  </div>
</div>
