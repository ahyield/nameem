<%= render "backoffice/shared/page_header", count: @pagy.count %>

<%= render "backoffice/shared/toolbar", url: backoffice_users_path, current: @filter, filters: [
  ["all", "الكل"],
  ["confirmed", "مؤكدين"],
  ["unconfirmed", "غير مؤكدين"],
  ["featured", "مميزين"],
  ["picked", "مختارين"],
  ["admins", "مدراء"],
  ["editors", "محررين"]
] %>

<% if @users.any? %>
  <ul class="bo-panel divide-y divide-gray-200/70">
    <% @users.each do |user| %>
      <li>
        <%= link_to backoffice_user_path(user), class: "bo-row" do %>
          <%= backoffice_avatar(user, size: 32) %>
          <span class="min-w-0 flex-1">
            <span class="block truncate text-sm font-medium"><%= user.name %></span>
            <span class="block truncate text-xs text-gray-500"><%= user.email %></span>
          </span>
          <span class="hidden md:block shrink-0"><%= render "backoffice/users/role_badges", user: user %></span>
          <span class="hidden sm:block w-20 shrink-0 text-xs text-gray-500 tabular-nums"><%= user.articles_total %> مقال</span>
          <span class="hidden sm:block w-24 shrink-0 text-xs text-gray-500"><%= time_ago_in_words(user.created_at) %></span>
          <svg class="h-4 w-4 shrink-0 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
        <% end %>
      </li>
    <% end %>
  </ul>
  <% if @pagy.last > 1 %>
    <div class="mt-4"><%== @pagy.series_nav %></div>
  <% end %>
<% else %>
  <%= render "backoffice/shared/empty_state", message: "لا يوجد مستخدمين" %>
<% end %>
