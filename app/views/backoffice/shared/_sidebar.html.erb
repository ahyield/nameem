<aside data-backoffice-sidebar-target="sidebar"
       class="fixed right-0 top-0 bottom-0 z-40 w-[232px] bg-sidebar border-l border-sidebar-border flex flex-col transform translate-x-0 transition-transform duration-200 ease-in-out lg:translate-x-0 translate-x-full lg:relative lg:z-auto">

  <!-- Logo -->
  <div class="flex items-center px-6 py-5">
    <span class="text-[15px] font-bold text-sidebar-foreground">نميم</span>
  </div>

  <!-- Navigation -->
  <nav class="flex-1 px-3 py-2 space-y-0.5 overflow-y-auto">
    <% [
      ["dashboard", backoffice_dashboard_path, "الرئيسية", "M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"],
      ["articles", backoffice_articles_path, "المقالات", "M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"],
      ["users", backoffice_users_path, "المستخدمين", "M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"],
      ["tags", backoffice_tags_path, "المواضيع", "M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"],
      ["comments", backoffice_comments_path, "التعليقات", "M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"]
    ].each do |ctrl, path, label, icon_path| %>
      <%= link_to path, class: "flex items-center gap-3 px-3 py-2 text-[13px] font-medium rounded-lg transition-colors #{active_backoffice_nav(ctrl)}" do %>
        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="<%= icon_path %>"/>
        </svg>
        <%= label %>
      <% end %>
    <% end %>
  </nav>

  <!-- User + Back to site -->
  <div class="px-3 py-4 border-t border-sidebar-border space-y-1">
    <div class="flex items-center gap-3 px-3 py-2">
      <% if current_user.avatar.attached? %>
        <%= image_tag current_user.avatar.variant(resize_to_fill: [28, 28]), class: "h-7 w-7 rounded-full shrink-0" %>
      <% else %>
        <span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-sidebar-accent shrink-0">
          <span class="text-[11px] font-medium text-sidebar-muted-foreground"><%= current_user.name&.first %></span>
        </span>
      <% end %>
      <div class="min-w-0">
        <p class="text-[13px] font-medium text-sidebar-foreground truncate"><%= current_user.name %></p>
        <p class="text-[11px] text-sidebar-muted-foreground truncate"><%= current_user.email %></p>
      </div>
    </div>

    <%= link_to root_path, class: "flex items-center gap-3 px-3 py-2 text-[13px] font-medium text-sidebar-muted-foreground hover:text-sidebar-foreground rounded-lg transition-colors" do %>
      <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11 15l-3-3m0 0l3-3m-3 3h8M3 12a9 9 0 1118 0 9 9 0 01-18 0z"/>
      </svg>
      العودة إلى الموقع
    <% end %>
  </div>
</aside>
