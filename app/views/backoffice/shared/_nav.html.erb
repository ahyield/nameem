<header class="sticky top-0 z-20 border-b border-gray-200/70 bg-surface/90 backdrop-blur">
  <div class="max-w-5xl mx-auto flex h-14 items-center gap-6 px-4 sm:px-6">
    <%= link_to "نميم", backoffice_root_path, class: "text-base font-bold text-gray-900 shrink-0" %>

    <nav class="flex h-full flex-1 items-stretch gap-5 overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
      <% BackofficeHelper::NAV_ITEMS.each do |ctrl, path, label| %>
        <%= link_to public_send(path),
            class: "relative flex items-center gap-1.5 whitespace-nowrap text-sm font-medium #{active_backoffice_nav(ctrl)}",
            aria: { current: (controller_name == ctrl ? "page" : nil) } do %>
          <%= label %>
          <% if ctrl == "reports" && pending_reports_count.positive? %>
            <span class="rounded-full bg-orange-600 px-1.5 text-xs font-medium text-white tabular-nums"><%= pending_reports_count %></span>
          <% end %>
        <% end %>
      <% end %>
    </nav>

    <div class="flex items-center gap-3 shrink-0">
      <%= link_to root_path, class: "hidden sm:inline-flex items-center gap-1 text-sm text-gray-500 hover:text-gray-900" do %>
        العودة إلى الموقع
        <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17L7 7m0 0h10M7 7v10" />
        </svg>
      <% end %>
      <%= backoffice_avatar(current_user, size: 28) %>
    </div>
  </div>
</header>
