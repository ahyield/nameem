<% { notice: "border-gray-200 bg-gray-50 text-gray-900",
     alert:  "border-orange-200 bg-orange-50 text-orange-900",
     error:  "border-red-200 bg-red-50 text-red-700" }.each do |type, classes| %>
  <% if flash[type].present? %>
    <div class="bo-flash mb-6 <%= classes %>" role="<%= type == :notice ? "status" : "alert" %>">
      <%= flash[type] %>
    </div>
  <% end %>
<% end %>
