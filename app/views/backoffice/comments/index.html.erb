<!-- Filter Tabs + Search -->
<div class="flex items-center justify-between gap-4 mb-6">
  <div class="inline-flex items-center rounded-lg bg-muted p-1 gap-0.5">
    <% [
      ["all", "الكل"],
      ["top_level", "تعليقات رئيسية"],
      ["replies", "ردود"]
    ].each do |key, label| %>
      <%= link_to label, backoffice_comments_path(filter: key, q: params[:q]),
          class: "px-3 py-1.5 text-[13px] font-medium transition-all #{active_filter_tab(@filter, key)}" %>
    <% end %>
  </div>

  <div data-controller="backoffice-search">
    <%= form_with url: backoffice_comments_path, method: :get, data: { backoffice_search_target: "form" } do |f| %>
      <%= f.hidden_field :filter, value: @filter %>
      <div class="relative">
        <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3">
          <svg class="h-3.5 w-3.5 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
        </div>
        <%= f.text_field :q, value: params[:q],
            placeholder: "بحث...",
            class: "block w-72 border border-input bg-transparent rounded-md py-1.5 pr-9 pl-3 text-[13px] text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-1 focus:ring-ring focus:border-ring transition-colors",
            data: { action: "input->backoffice-search#search" } %>
      </div>
    <% end %>
  </div>
</div>

<!-- Table Card -->
<% if @comments.any? %>
  <div class="rounded-xl border border-border bg-card">
    <div class="overflow-x-auto">
      <table class="min-w-full">
        <thead>
          <tr class="border-b border-border">
            <th class="px-6 py-3 text-right text-[11px] font-medium text-muted-foreground uppercase tracking-wider">التعليق</th>
            <th class="px-4 py-3 text-right text-[11px] font-medium text-muted-foreground uppercase tracking-wider">الكاتب</th>
            <th class="px-4 py-3 text-right text-[11px] font-medium text-muted-foreground uppercase tracking-wider">المقال</th>
            <th class="px-4 py-3 text-right text-[11px] font-medium text-muted-foreground uppercase tracking-wider">النوع</th>
            <th class="px-4 py-3 text-right text-[11px] font-medium text-muted-foreground uppercase tracking-wider">إعجابات</th>
            <th class="px-4 py-3 text-right text-[11px] font-medium text-muted-foreground uppercase tracking-wider">ردود</th>
            <th class="px-4 py-3 text-right text-[11px] font-medium text-muted-foreground uppercase tracking-wider">التاريخ</th>
            <th class="px-6 py-3 text-left text-[11px] font-medium text-muted-foreground uppercase tracking-wider"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border">
          <% @comments.each do |comment| %>
            <tr class="group hover:bg-muted/50 transition-colors">
              <td class="px-6 py-3">
                <div class="max-w-xs">
                  <%= link_to backoffice_comment_path(comment), class: "text-[13px] text-foreground hover:text-muted-foreground line-clamp-1" do %>
                    <%= comment.body.to_plain_text.truncate(80) %>
                  <% end %>
                </div>
              </td>
              <td class="px-4 py-3 whitespace-nowrap text-[13px] text-muted-foreground">
                <%= link_to comment.user.name, backoffice_user_path(comment.user), class: "hover:text-foreground" %>
              </td>
              <td class="px-4 py-3 whitespace-nowrap text-[13px] text-muted-foreground">
                <%= link_to (comment.article.title.presence || comment.article.uuid).truncate(30), backoffice_article_path(comment.article), class: "hover:text-foreground" %>
              </td>
              <td class="px-4 py-3 whitespace-nowrap">
                <% if comment.parent_id.nil? %>
                  <%= status_badge("تعليق", :active) %>
                <% else %>
                  <%= status_badge("رد", :default) %>
                <% end %>
              </td>
              <td class="px-4 py-3 whitespace-nowrap text-[13px] text-muted-foreground tabular-nums"><%= comment.comment_likes.count %></td>
              <td class="px-4 py-3 whitespace-nowrap text-[13px] text-muted-foreground tabular-nums"><%= comment.replies_count %></td>
              <td class="px-4 py-3 whitespace-nowrap text-[12px] text-muted-foreground"><%= time_ago_in_words(comment.created_at) %></td>
              <td class="px-6 py-3 whitespace-nowrap text-left">
                <div class="flex items-center gap-3 opacity-0 group-hover:opacity-100 transition-opacity">
                  <%= link_to backoffice_comment_path(comment), class: "text-muted-foreground hover:text-foreground", title: "عرض" do %>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                  <% end %>
                  <%= button_to backoffice_comment_path(comment), method: :delete, class: "text-muted-foreground hover:text-destructive", title: "حذف", data: { turbo_confirm: "هل أنت متأكد من حذف هذا التعليق؟" } do %>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <div class="border-t border-border px-6 py-3">
      <%== @pagy.series_nav %>
    </div>
  </div>
<% else %>
  <%= render "backoffice/shared/empty_state", message: "لا توجد تعليقات" %>
<% end %>
