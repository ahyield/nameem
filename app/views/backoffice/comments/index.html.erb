<%= render "backoffice/shared/page_header", count: @pagy.count %>

<%= render "backoffice/shared/toolbar", url: backoffice_comments_path, current: @filter, filters: [
  ["all", "الكل"],
  ["top_level", "تعليقات رئيسية"],
  ["replies", "ردود"]
] %>

<% if @comments.any? %>
  <ul class="bo-panel divide-y divide-gray-200/70">
    <% @comments.each do |comment| %>
      <li>
        <%= link_to backoffice_comment_path(comment), class: "bo-row items-start" do %>
          <%= backoffice_avatar(comment.user, size: 28) %>
          <span class="min-w-0 flex-1">
            <span class="block text-sm line-clamp-2"><%= comment.body.to_plain_text.truncate(160) %></span>
            <span class="mt-0.5 block truncate text-xs text-gray-500">
              <%= comment.user.name %> · <%= comment.parent_id.nil? ? "على" : "رد على" %>
              <%= comment.article&.title.presence || "مقال محذوف" %> · <%= time_ago_in_words(comment.created_at) %>
            </span>
          </span>
          <span class="hidden sm:block w-16 shrink-0 text-xs text-gray-500 tabular-nums"><%= comment.likes_count %> إعجاب</span>
          <span class="hidden sm:block w-14 shrink-0 text-xs text-gray-500 tabular-nums"><%= comment.replies_count %> رد</span>
        <% end %>
      </li>
    <% end %>
  </ul>
  <% if @pagy.last > 1 %>
    <div class="mt-4"><%== @pagy.series_nav %></div>
  <% end %>
<% else %>
  <%= render "backoffice/shared/empty_state", message: "لا توجد تعليقات" %>
<% end %>
