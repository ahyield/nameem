<div class="mb-6 flex items-center gap-3">
  <%= backoffice_avatar(@comment.user, size: 40) %>
  <div class="min-w-0 flex-1">
    <h1 class="text-base font-semibold text-gray-900">
      <%= link_to @comment.user.name, backoffice_user_path(@comment.user), class: "hover:underline" %>
    </h1>
    <p class="truncate text-sm text-gray-500">
      <%= @comment.parent_id.nil? ? "علّق على" : "ردّ على" %>
      <%= link_to (@comment.article.title.presence || @comment.article.uuid), backoffice_article_path(@comment.article),
          class: "text-gray-900 hover:underline" %>
      · <%= time_ago_in_words(@comment.created_at) %>
    </p>
  </div>
</div>

<% if @comment.parent.present? %>
  <div class="mb-3 flex gap-3 rounded-xl bg-gray-50 p-4">
    <%= backoffice_avatar(@comment.parent.user, size: 24) %>
    <div class="min-w-0 text-sm">
      <span class="font-medium text-gray-900"><%= @comment.parent.user.name %></span>
      <p class="mt-0.5 text-gray-600"><%= @comment.parent.body.to_plain_text.truncate(200) %></p>
    </div>
  </div>
<% end %>

<div class="bo-panel p-5">
  <div class="prose prose-sm max-w-none text-gray-900"><%= @comment.body %></div>
  <p class="mt-4 text-xs text-gray-500 tabular-nums">
    <%= @comment.likes_count %> إعجاب · <%= @comment.replies_count %> رد
  </p>
</div>

<% if @replies.present? %>
  <section class="mt-8">
    <h2 class="mb-3 text-sm font-semibold text-gray-900">الردود <span class="font-normal text-gray-400 tabular-nums"><%= @replies.size %></span></h2>
    <ul class="bo-panel divide-y divide-gray-200/70">
      <% @replies.each do |reply| %>
        <li class="flex items-start gap-3 px-4 py-3">
          <%= backoffice_avatar(reply.user, size: 28) %>
          <div class="min-w-0 flex-1 text-sm">
            <p>
              <span class="font-medium text-gray-900"><%= reply.user.name %></span>
              <span class="text-xs text-gray-500"><%= time_ago_in_words(reply.created_at) %></span>
            </p>
            <p class="mt-0.5 text-gray-700"><%= reply.body.to_plain_text.truncate(200) %></p>
          </div>
          <%= button_to "حذف", backoffice_comment_path(reply), method: :delete, class: "bo-btn bo-btn-danger shrink-0 px-2 py-1 text-xs",
              data: { turbo_confirm: "هل أنت متأكد من حذف هذا الرد؟" } %>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>

<section class="mt-12 border-t border-gray-200/70 pt-6">
  <h2 class="text-sm font-semibold text-gray-900">حذف التعليق</h2>
  <p class="mt-1 mb-3 text-sm text-gray-500">
    <%= @comment.parent_id.nil? ? "يحذف التعليق وكل الردود عليه." : "يحذف هذا الرد." %> لا يمكن التراجع عن ذلك.
  </p>
  <%= button_to "حذف التعليق", backoffice_comment_path(@comment), method: :delete, class: "bo-btn bo-btn-danger -mr-3",
      data: { turbo_confirm: "هل أنت متأكد من حذف هذا التعليق؟" } %>
</section>
