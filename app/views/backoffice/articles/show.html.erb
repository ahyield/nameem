<div class="mb-8 flex flex-wrap items-start justify-between gap-4">
  <div class="min-w-0 flex-1">
    <h1 class="text-xl font-semibold text-gray-900 break-words"><%= @article.title.presence || @article.uuid %></h1>
    <p class="mt-1 text-sm text-gray-500">
      <%= link_to @article.user.name, backoffice_user_path(@article.user), class: "text-gray-900 hover:underline" %>
      <% if @article.published_at.present? %>
        · نُشر <%= l(@article.published_at.to_date, format: :long) %>
      <% else %>
        · مسودة
      <% end %>
    </p>
    <% if @article.description.present? %>
      <p class="mt-3 max-w-prose text-sm leading-relaxed text-gray-600"><%= @article.description %></p>
    <% end %>
  </div>
  <% if @article.published? %>
    <%= link_to "عرض في الموقع", article_link(@article),
        class: "bo-btn bo-btn-ghost", target: "_blank", rel: "noopener" %>
  <% end %>
</div>

<dl class="mb-8 flex flex-wrap gap-x-8 gap-y-3">
  <% [
    ["مشاهدة", @article.real_views_count || 0],
    ["إعجاب", @article.likes_count],
    ["تعليق", @article.comments_count],
    ["حفظ", @article.bookmarks.count],
    ["دقائق قراءة", @article.reading_time_minutes || 0]
  ].each do |label, value| %>
    <div class="flex items-baseline gap-1.5">
      <dt class="order-2 text-sm text-gray-500"><%= label %></dt>
      <dd class="order-1 text-lg font-semibold text-gray-900 tabular-nums"><%= number_with_delimiter(value) %></dd>
    </div>
  <% end %>
</dl>

<div class="grid gap-8 lg:grid-cols-5">
  <section class="lg:col-span-2">
    <h2 class="mb-3 text-sm font-semibold text-gray-900">الإعدادات</h2>
    <div class="bo-panel divide-y divide-gray-200/70 px-4">
      <% [
        ["published", "منشور", "ظاهر للقراء"],
        ["featured", "مميز", "يظهر في الصفحة الرئيسية"],
        ["picked", "مختار", "ضمن اختيارات المحررين"]
      ].each do |field, label, description| %>
        <%= render "backoffice/shared/switch",
            id: "article-#{field}", label: label, description: description, on: @article.public_send(field),
            url: backoffice_article_path(@article), method: :put,
            params: { article: { field => !@article.public_send(field) } } %>
      <% end %>
    </div>
  </section>

  <section class="lg:col-span-3">
    <h2 class="mb-3 text-sm font-semibold text-gray-900">المواضيع</h2>
    <% if @article.tags.any? %>
      <div class="flex flex-wrap gap-1.5">
        <% @article.tags.each do |tag| %>
          <%= link_to tag.name, backoffice_tag_path(tag),
              class: "rounded-md bg-gray-100 px-2 py-1 text-sm text-gray-700 hover:bg-gray-200" %>
        <% end %>
      </div>
    <% else %>
      <p class="text-sm text-gray-500">بدون مواضيع</p>
    <% end %>
  </section>
</div>

<section class="mt-12 border-t border-gray-200/70 pt-6">
  <h2 class="text-sm font-semibold text-gray-900">حذف المقال</h2>
  <p class="mt-1 mb-3 text-sm text-gray-500">يحذف المقال وتعليقاته نهائيًا. لا يمكن التراجع عن ذلك.</p>
  <%= button_to "حذف المقال", backoffice_article_path(@article), method: :delete, class: "bo-btn bo-btn-danger -mr-3",
      data: { turbo_confirm: "هل أنت متأكد من حذف هذا المقال؟", confirm_label: "حذف", confirm_destructive: true } %>
</section>
