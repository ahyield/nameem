<div class="space-y-6">
  <!-- Article Info Card -->
  <div class="rounded-xl border border-border bg-card p-6">
    <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <dt class="text-[11px] font-medium text-muted-foreground uppercase tracking-wider">العنوان</dt>
        <dd class="mt-1 text-[13px] font-medium text-foreground"><%= @article.title.presence || @article.uuid %></dd>
      </div>
      <div>
        <dt class="text-[11px] font-medium text-muted-foreground uppercase tracking-wider">الكاتب</dt>
        <dd class="mt-1 text-[13px] text-foreground"><%= link_to @article.user.name, backoffice_user_path(@article.user), class: "text-foreground hover:text-muted-foreground" %></dd>
      </div>
    </dl>
  </div>

  <!-- Edit Form Card -->
  <div class="rounded-xl border border-border bg-card p-6">
    <h3 class="text-[11px] font-medium text-muted-foreground uppercase tracking-wider mb-4">إعدادات المقال</h3>

    <%= form_with model: @article, url: backoffice_article_path(@article), method: :put do |form| %>
      <div class="space-y-4">
        <label class="flex items-center gap-3 cursor-pointer group">
          <%= form.check_box :published, class: "h-4 w-4 rounded border-input text-primary focus:ring-ring" %>
          <div>
            <span class="text-[13px] font-medium text-foreground">منشور</span>
            <p class="text-[12px] text-muted-foreground">نشر المقال للجمهور</p>
          </div>
        </label>

        <label class="flex items-center gap-3 cursor-pointer group">
          <%= form.check_box :featured, class: "h-4 w-4 rounded border-input text-primary focus:ring-ring" %>
          <div>
            <span class="text-[13px] font-medium text-foreground">مميز</span>
            <p class="text-[12px] text-muted-foreground">عرض في الصفحة الرئيسية</p>
          </div>
        </label>

        <label class="flex items-center gap-3 cursor-pointer group">
          <%= form.check_box :picked, class: "h-4 w-4 rounded border-input text-primary focus:ring-ring" %>
          <div>
            <span class="text-[13px] font-medium text-foreground">مختار</span>
            <p class="text-[12px] text-muted-foreground">اختيارات المحررين</p>
          </div>
        </label>
      </div>

      <div class="mt-6 flex items-center gap-3">
        <%= form.submit "حفظ", class: "px-4 py-1.5 rounded-md bg-primary text-primary-foreground text-[13px] font-medium hover:bg-primary/90 transition-colors cursor-pointer" %>
        <%= link_to "إلغاء", backoffice_article_path(@article), class: "text-[13px] font-medium text-muted-foreground hover:text-foreground transition-colors" %>
      </div>
    <% end %>
  </div>
</div>
