<%= render "shared/nav" %>
<%= render "flashes/alert", alert: flash[:alert] if !flash[:alert].nil? %>
<%= render "flashes/notice", notice: flash[:notice] if !flash[:notice].nil? %>
<%= render "flashes/error", error: flash[:error] if !flash[:error].nil? %>

<main class="font-montserrat">
  <div class="pt-16">
    <%= render "backoffice/nav" %>
  </div>

  <div class="space-y-16 py-16 xl:space-y-20" dir="ltr">
    <!-- Recent activity table -->
    <div class="px-4 sm:px-6 lg:px-8">
      <div class="mt-8 flow-root">
        <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
          <div class="inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8">
            <table class="min-w-full divide-y divide-gray-300">
              <thead>
                  <tr>
                    <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 sm:pl-0">Title</th>
                    <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Username</th>
                    <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">User</th>
                    <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Featured</th>
                    <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Picked</th>
                    <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-0"></th>
                    <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-0"></th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-gray-200 bg-white">
                <% @articles.each do |article| %>
                  <tr>
                    <td class="whitespace-nowrap py-5 pl-4 pr-3 text-sm sm:pl-0">
                      <div class="flex items-center">
                        <div class="ml-4">
                          <%= link_to edit_backoffice_article_path(user_slug: article.user.slug, uuid: article.uuid), class: "text-sm font-medium text-gray-900" do %>
                            <div class="font-medium text-gray-900"><%= article.title || article.uuid %></div>
                          <% end %>
                        </div>
                      </div>
                    </td>
                    <td class="whitespace-nowrap px-3 py-5 text-sm text-gray-500">
                      <div class="text-gray-900"><%= article.user.slug %></div>
                    </td>
                    <td class="whitespace-nowrap px-3 py-5 text-sm text-gray-500">
                      <div class="text-gray-900"><%= article.user.name %></div>
                    </td>
                      <td class="whitespace-nowrap px-3 py-5 text-sm text-gray-500"><%= check_box_tag :featured, class: "h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600", checked: article.featured?, diasabled: true %></td>
                      <td class="whitespace-nowrap px-3 py-5 text-sm text-gray-500"><%= check_box_tag :picked, class: "h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600", checked: article.picked?, disabled: true %></td>
                    <td class="relative whitespace-nowrap py-5 pl-3 pr-4 text-right text-sm font-medium sm:pr-0">
                      <%= link_to "view", user_article_path(slug: article.user, uuid: article.uuid), class: "text-indigo-600 hover:text-indigo-900" %>
                    </td>
                    <td class="relative whitespace-nowrap py-5 pl-3 pr-4 text-right text-sm font-medium sm:pr-0">
                      <%= link_to "Edit", edit_backoffice_article_path(user_slug: article.user.slug, uuid: article.uuid), class: "text-indigo-600 hover:text-indigo-900" %>
                    </td>
                  </tr>

                <% end %>
              </tbody>
            </table>
            <%== pagy_nav(@pagy) %>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>
