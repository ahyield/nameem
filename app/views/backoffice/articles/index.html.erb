<%= render "backoffice/shared/page_header", count: @pagy.count %>

<%= render "backoffice/shared/toolbar", url: backoffice_articles_path, current: @filter, filters: [
  ["all", "الكل"],
  ["published", "منشورة"],
  ["drafts", "مسودات"],
  ["featured", "مميزة"],
  ["picked", "مختارة"]
] %>

<% if @articles.any? %>
  <ul class="bo-panel divide-y divide-gray-200/70">
    <% @articles.each do |article| %>
      <li>
        <%= link_to backoffice_article_path(article), class: "bo-row" do %>
          <span class="min-w-0 flex-1">
            <span class="block truncate text-sm font-medium"><%= article.title.presence || article.uuid %></span>
            <span class="block truncate text-xs text-gray-500"><%= article.user.name %> · <%= time_ago_in_words(article.created_at) %></span>
          </span>
          <span class="hidden md:inline-flex shrink-0 gap-1">
            <% if !article.published? %>
              <%= status_badge("مسودة") %>
            <% end %>
            <% if article.featured? %>
              <%= status_badge("مميز", :active) %>
            <% end %>
            <% if article.picked? %>
              <%= status_badge("مختار", :active) %>
            <% end %>
          </span>
          <span class="hidden sm:block w-20 shrink-0 text-xs text-gray-500 tabular-nums"><%= number_with_delimiter(article.real_views_count || 0) %> مشاهدة</span>
          <span class="hidden sm:block w-16 shrink-0 text-xs text-gray-500 tabular-nums"><%= article.likes_count %> إعجاب</span>
          <svg class="h-4 w-4 shrink-0 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
        <% end %>
      </li>
    <% end %>
  </ul>
  <% if @pagy.last > 1 %>
    <div class="mt-4"><%== @pagy.series_nav %></div>
  <% end %>
<% else %>
  <%= render "backoffice/shared/empty_state", message: "لا توجد مقالات" %>
<% end %>
