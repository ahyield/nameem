<!DOCTYPE html>
<html dir="rtl" lang="ar">
  <head>
    <%= render "shared/head" %>
    <%= Sentry.get_trace_propagation_meta.html_safe %>
  </head>
  <body class="font-montserrat bg-background min-h-screen antialiased" data-controller="backoffice-sidebar">
    <div class="flex min-h-screen">
      <%= render "backoffice/shared/sidebar" %>

      <div class="flex-1 flex flex-col min-w-0">
        <%= render "backoffice/shared/flashes" %>

        <!-- Mobile hamburger -->
        <div class="lg:hidden flex items-center px-8 pt-6">
          <button data-action="click->backoffice-sidebar#toggle" class="text-muted-foreground hover:text-foreground transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
          </button>
        </div>

        <main class="flex-1 px-8 py-8">
          <div class="max-w-6xl mx-auto">
            <%= yield %>
          </div>
        </main>
      </div>
    </div>

    <!-- Mobile overlay -->
    <div data-backoffice-sidebar-target="overlay"
         data-action="click->backoffice-sidebar#close"
         class="fixed inset-0 bg-foreground/50 backdrop-blur-sm z-30 hidden lg:hidden"></div>
  </body>
</html>
