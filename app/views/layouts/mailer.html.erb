<!DOCTYPE html>
<html lang="ar" dir="rtl" xmlns="http://www.w3.org/1999/xhtml">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="x-apple-disable-message-reformatting">
  <meta name="color-scheme" content="light">
  <meta name="supported-color-schemes" content="light">
  <title><%= yield(:title).presence || "نميم" %></title>
  <style>
    body { margin: 0; padding: 0; width: 100%; background-color: #f6f5f3; }
    .body { background-color: #f6f5f3; padding: 32px 12px; }
    .container { width: 100%; max-width: 560px; margin: 0 auto; }
    .brand { padding: 0 8px 24px; text-align: right; }
    .card { background-color: #ffffff; border-radius: 16px; padding: 36px 32px; }
    .text, .card p, .card li { font-family: "Noto Naskh Arabic", "Geeza Pro", Tahoma, Arial, sans-serif; font-size: 16px; line-height: 1.75; color: #374151; direction: rtl; text-align: right; }
    .card p { margin: 0 0 16px; }
    .h1 { margin: 0 0 16px; font-family: "Noto Naskh Arabic", "Geeza Pro", Tahoma, Arial, sans-serif; font-size: 24px; line-height: 1.4; font-weight: 700; color: #111827; text-align: right; }
    .h2 { margin: 0 0 8px; font-family: "Noto Naskh Arabic", "Geeza Pro", Tahoma, Arial, sans-serif; font-size: 18px; line-height: 1.5; font-weight: 700; color: #111827; text-align: right; }
    .muted { color: #6b7280; font-size: 14px; }
    .small { font-size: 13px; line-height: 1.6; }
    .link { color: #c2410c; text-decoration: underline; }
    .button { display: inline-block; background-color: #111827; color: #ffffff; border-radius: 9999px; padding: 12px 28px; font-family: "Noto Naskh Arabic", "Geeza Pro", Tahoma, Arial, sans-serif; font-size: 15px; font-weight: 700; text-decoration: none; }
    .code { font-family: "SFMono-Regular", Menlo, Consolas, monospace; font-size: 36px; font-weight: 700; letter-spacing: 8px; color: #111827; text-align: center; direction: ltr; padding: 20px 0; background-color: #f6f5f3; border-radius: 12px; }
    .divider { height: 1px; line-height: 1px; background-color: #e5e7eb; margin: 28px 0; }
    .item { padding: 16px 0; border-bottom: 1px solid #f1f1ef; }
    .item-title { font-family: "Noto Naskh Arabic", "Geeza Pro", Tahoma, Arial, sans-serif; font-size: 17px; line-height: 1.5; font-weight: 700; color: #111827; text-decoration: none; }
    .quote { border-right: 3px solid #fdba74; padding: 4px 14px 4px 0; color: #4b5563; }
    .footer { padding: 24px 8px 0; text-align: center; }
    .footer p { margin: 0 0 8px; font-family: "Noto Naskh Arabic", "Geeza Pro", Tahoma, Arial, sans-serif; font-size: 12px; line-height: 1.7; color: #9ca3af; }
    .footer a { color: #6b7280; text-decoration: underline; }
    /* Weekly newsletter */
    .card .eyebrow { margin: 0 0 6px; font-family: "Noto Naskh Arabic", "Geeza Pro", Tahoma, Arial, sans-serif; font-size: 13px; line-height: 1.5; font-weight: 700; color: #c2410c; text-align: right; }
    .masthead-title { margin: 0 0 10px; font-family: "Noto Naskh Arabic", "Geeza Pro", Tahoma, Arial, sans-serif; font-size: 30px; line-height: 1.35; font-weight: 700; color: #111827; text-align: right; }
    .lead-image { display: block; width: 100%; height: auto; border-radius: 12px; background-color: #f3f4f6; }
    .lead-title { font-family: "Noto Naskh Arabic", "Geeza Pro", Tahoma, Arial, sans-serif; font-size: 22px; line-height: 1.45; font-weight: 700; color: #111827; text-decoration: none; }
    .story-title { font-family: "Noto Naskh Arabic", "Geeza Pro", Tahoma, Arial, sans-serif; font-size: 17px; line-height: 1.5; font-weight: 700; color: #111827; text-decoration: none; }
    .excerpt { margin: 6px 0 0 !important; font-size: 14px !important; line-height: 1.7 !important; color: #4b5563 !important; }
    .meta { margin: 8px 0 0 !important; font-size: 13px !important; line-height: 1.5 !important; color: #6b7280 !important; }
    .rank { width: 48px; padding-top: 2px; font-family: Georgia, "Times New Roman", serif; font-size: 30px; line-height: 1; font-weight: 700; color: #d6d3d1; text-align: right; vertical-align: top; }
    .story { padding: 20px 0; border-top: 1px solid #f0efed; vertical-align: top; }
    .thumb-cell { width: 76px; padding: 20px 16px 20px 0; border-top: 1px solid #f0efed; vertical-align: top; }
    .thumb { display: block; width: 76px; height: 76px; border-radius: 10px; object-fit: cover; background-color: #f3f4f6; }
    .card .section-title { margin: 0 0 4px; font-family: "Noto Naskh Arabic", "Geeza Pro", Tahoma, Arial, sans-serif; font-size: 18px; line-height: 1.5; font-weight: 700; color: #111827; text-align: right; }
    .panel { background-color: #fff7ed; border-radius: 14px; padding: 22px 22px 8px; }
    .pick { padding: 0 0 14px; }
    .avatar { width: 40px; height: 40px; border-radius: 9999px; background-color: #ffedd5; color: #c2410c; font-family: "Noto Naskh Arabic", "Geeza Pro", Tahoma, Arial, sans-serif; font-size: 17px; font-weight: 700; text-align: center; line-height: 40px; }
    .avatar-team { background-color: #111827; color: #ffffff; }
    .activity { padding: 16px 0; border-top: 1px solid #f0efed; vertical-align: top; }
    .label { display: inline-block; margin-top: 2px; font-family: "Noto Naskh Arabic", "Geeza Pro", Tahoma, Arial, sans-serif; font-size: 14px; line-height: 1.6; color: #4b5563; }
    .time { font-family: "Noto Naskh Arabic", "Geeza Pro", Tahoma, Arial, sans-serif; font-size: 12px; color: #9ca3af; white-space: nowrap; }
    .summary { display: inline-block; background-color: #f6f5f3; border-radius: 9999px; padding: 6px 14px; font-family: "Noto Naskh Arabic", "Geeza Pro", Tahoma, Arial, sans-serif; font-size: 13px; color: #374151; }
    .step-number { width: 40px; font-family: Georgia, "Times New Roman", serif; font-size: 24px; line-height: 1; font-weight: 700; color: #fdba74; vertical-align: top; padding: 14px 0; }
    .step { padding: 14px 0; border-top: 1px solid #f0efed; vertical-align: top; }
    .writer { padding: 14px 0; border-top: 1px solid #f0efed; vertical-align: middle; }
    .follow { font-family: "Noto Naskh Arabic", "Geeza Pro", Tahoma, Arial, sans-serif; font-size: 13px; font-weight: 700; color: #c2410c; text-decoration: none; border: 1px solid #fed7aa; border-radius: 9999px; padding: 6px 14px; white-space: nowrap; }
    .preheader { display: none; max-height: 0; max-width: 0; overflow: hidden; opacity: 0; font-size: 1px; line-height: 1px; color: #f6f5f3; }
    @media (max-width: 600px) {
      .card { padding: 28px 20px !important; border-radius: 12px !important; }
      .h1 { font-size: 22px !important; }
      .masthead-title { font-size: 26px !important; }
      .thumb-cell { display: none !important; }
    }
  </style>
</head>
<body dir="rtl">
  <% if content_for?(:preheader) %>
    <div class="preheader"><%= yield :preheader %></div>
  <% end %>

  <div class="body" role="article" aria-roledescription="email" lang="ar" dir="rtl">
    <table class="container" align="center" cellpadding="0" cellspacing="0" role="presentation">
      <tr>
        <td class="brand">
          <a href="<%= root_url %>"><%= image_tag attachments["logo.png"].url, width: 44, height: 44, alt: "نميم" %></a>
        </td>
      </tr>
      <tr>
        <td class="card">
          <%= yield %>
        </td>
      </tr>
      <tr>
        <td>
          <%= render "layouts/mailer_footer" %>
        </td>
      </tr>
    </table>
  </div>
</body>
</html>
