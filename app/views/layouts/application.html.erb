<!DOCTYPE html>
<html dir="rtl">
  <head>
    <%= render "shared/head" %>
  </head>
  <body>
    <% if current_page?(controller: "articles", action: "new") || current_page?(controller: "articles", action: "edit", uuid: (request.params[:uuid] || ""))%>
      <%= render "shared/editor_nav" %>
    <% else %>
      <%= render "shared/nav" %>
    <% end %>
    <main class="container mx-auto mt-2">
      <%= yield %>
    </main>

  </body>
</html>
