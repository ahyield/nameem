<!DOCTYPE html>
<html dir="rtl">
  <head>
    <%= render "shared/head" %>
    <%= Sentry.get_trace_propagation_meta.html_safe %>
  </head>
  <body class="font-naskh min-h-screen scroll-smooth">
    <% if current_page?(new_story_path) || current_page?(user_edit_article_path(slug: (params[:slug] || ""), uuid: (params[:uuid] || ""))) %>
      <%= render "shared/editor_nav" %>
    <% end %>

    <main class="container mx-auto mt-2">
      <%= yield %>
    </main>

  </body>
</html>
