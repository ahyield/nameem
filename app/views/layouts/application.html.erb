<!DOCTYPE html>
<html dir="rtl">
  <head>
    <%= render "shared/head" %>
  </head>
  <body class="font-naskh min-h-screen scroll-smooth">
    <% if current_page?(new_story_path) || current_page?(controller: "articles", action: "edit", uuid: (request.params[:uuid] || "")) %>
      <%= render "shared/editor_nav" %>
    <% end %>

    <main class="container mx-auto mt-2">
      <%= yield %>
    </main>

    <%= render "shared/footer" %>
  </body>
</html>
