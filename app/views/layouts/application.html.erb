<!DOCTYPE html>
<html dir="rtl" lang="ar" data-theme="<%= current_theme %>" class="<%= "dark" if current_theme == "dark" %>">
  <head>
    <%= render "shared/head" %>
  </head>
  <body class="font-naskh min-h-screen scroll-smooth" data-controller="search">
    <% if current_page?(new_story_path) || current_page?(user_edit_article_path(slug: (params[:slug] || ""), uuid: (params[:uuid] || ""))) %>
      <%= render "shared/editor_nav" %>
    <% end %>

    <% if current_user&.suspended? %>
      <div class="fixed inset-x-0 bottom-0 z-40 bg-gray-900 px-4 py-2 text-center text-sm text-surface" role="status">
        حسابك موقوف حالياً: يمكنك القراءة، لكن لا يمكنك النشر أو التعليق أو الإعجاب.
      </div>
    <% end %>
    <main class="container mx-auto mt-2">
      <%= yield %>
    </main>

    <%= render "shared/search_overlay" %>
  </body>
</html>
