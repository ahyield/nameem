<% content_for :title, "أهلاً بك في نميم" %>
<% content_for :preheader, "حسابك جاهز. مصطبة جديدة للكتابة، خارج غرف الصدى الرقمية." %>

<p class="eyebrow">حسابك جاهز</p>
<h1 class="masthead-title">أهلاً بك في نميم، <%= @user.first_name %></h1>
<p>نميم منصة عربية للتدوين الجماعي الحرّ؛ مصطبة نشتبك فيها مع أنفسنا ومع العالم بحرّية، بعيداً عن سباق القراءات والتحايل على الخوارزميات.</p>
<p style="color: #111827; font-weight: 700;">لا إعلانات، لا توجّهات، ولا سقف لحرّية التعبير. كتابة للكتابة؛ كتابة للجميع.</p>

<table width="100%" cellpadding="0" cellspacing="0" role="presentation" style="margin-top: 8px;">
  <% [
    ["اكتب", "ابدأ موضوعك الأول متى شئت؛ يُحفظ ما تكتبه تلقائياً حتى تقرّر نشره."],
    ["تابع", "تابع من تشتبك مع كتاباتهم والمواضيع التي تشغلك، ليصلك جديدهم في صفحتك."],
    ["احفظ", "احفظ ما يستحق العودة إليه، وشارك ما يستحق أن يُقرأ."]
  ].each_with_index do |(step, text), index| %>
    <tr>
      <td class="step step-number"><%= format("%02d", index + 1) %></td>
      <td class="step">
        <p style="margin: 0; font-weight: 700; color: #111827;"><%= step %></p>
        <p class="excerpt" style="margin-top: 2px !important;"><%= text %></p>
      </td>
    </tr>
  <% end %>
</table>

<p style="margin: 28px 0 8px; text-align: center;">
  <%= link_to "اكتب موضوعك الأول", new_story_url, class: "button" %>
</p>

<%= render "mailer/writers", writers: @writers, title: "كتّاب تبدأ بهم" %>
