<%= turbo_frame_tag dom_id(comment, :like) do %>
  <div class="inline-flex items-center gap-1" data-controller="<%= 'modal' if comment.likes_count > 0 %>">
    <% if current_user && current_user != comment.user %>
      <% if liked %>
        <%= button_to user_unlike_comment_path(slug: comment.article.user, uuid: comment.article, id: comment),
              method: :delete,
              class: "inline-flex items-center cursor-pointer group transition-colors text-red-500",
              data: { turbo_frame: dom_id(comment, :like) } do %>
          <%= heroicon "heart", variant: :solid, class: "w-3.5 h-3.5 group-hover:scale-110 transition-transform" %>
        <% end %>
      <% else %>
        <%= button_to user_like_comment_path(slug: comment.article.user, uuid: comment.article, id: comment),
              method: :post,
              class: "inline-flex items-center cursor-pointer group transition-colors text-gray-400 hover:text-red-400",
              data: { turbo_frame: dom_id(comment, :like) } do %>
          <%= heroicon "heart", class: "w-3.5 h-3.5 group-hover:scale-110 transition-transform" %>
        <% end %>
      <% end %>
    <% elsif comment.likes_count > 0 %>
      <button type="button" class="cursor-pointer" data-action="modal#open">
        <%= heroicon "heart", variant: :solid, class: "w-3.5 h-3.5 text-gray-400" %>
      </button>
    <% end %>
    <% if comment.likes_count > 0 %>
      <button type="button" class="text-xs text-gray-500 hover:text-gray-700 hover:underline cursor-pointer"
              data-action="modal#open">
        <%= comment.likes_count %>
      </button>
      <%= render "comment_likes/likers_modal", comment: comment %>
    <% end %>
  </div>
<% end %>
