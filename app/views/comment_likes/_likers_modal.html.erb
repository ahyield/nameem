<%# Comment Likers Modal %>
<div class="hidden relative z-50" data-modal-target="container" data-action="keydown@window->modal#escape" role="dialog" aria-modal="true" aria-label="المعجبون بالتعليق">
  <%# Backdrop %>
  <div class="fixed inset-0 bg-gray-500/75 transition-opacity duration-200 ease-out opacity-0" data-modal-target="overlay"></div>

  <div class="fixed inset-0 z-10 overflow-y-auto">
    <div class="flex min-h-full items-center justify-center p-4" data-action="click->modal#outside">
      <%# Panel %>
      <div class="relative w-full max-w-sm transform rounded-xl bg-white shadow-xl transition-all duration-200 ease-out opacity-0 scale-95" data-modal-target="panel">
        <%# Header %>
        <div class="flex items-center justify-between border-b border-gray-200 px-5 py-3">
          <h2 class="text-sm font-semibold text-gray-900">المعجبون (<%= comment.likes_count %>)</h2>
          <button type="button" class="text-gray-400 hover:text-gray-500 cursor-pointer" data-action="modal#close">
            <span class="sr-only">إغلاق</span>
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <%# Likers list %>
        <div class="max-h-64 overflow-y-auto px-5 py-3 space-y-1">
          <% comment.comment_likes.includes(user: { avatar_attachment: :blob }).each do |like| %>
            <%= link_to user_path(like.user), class: "flex items-center gap-3 rounded-lg p-2 hover:bg-gray-50 transition-colors", data: { turbo: false } do %>
              <% if like.user.avatar.attached? %>
                <%= image_tag like.user.avatar.variant(resize_to_fill: [64, 64]), class: "size-7 flex-none rounded-full bg-gray-50 object-cover", alt: like.user.name %>
              <% else %>
                <span class="size-7 flex-none overflow-hidden rounded-full bg-gray-100">
                  <svg class="size-7 text-gray-300" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M24 20.993V24H0v-2.996A14.977 14.977 0 0112.004 15c4.904 0 9.26 2.354 11.996 5.993zM16.002 8.999a4 4 0 11-8 0 4 4 0 018 0z" />
                  </svg>
                </span>
              <% end %>
              <span class="text-sm text-gray-700"><%= like.user.name %></span>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
