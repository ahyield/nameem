<%= turbo_frame_tag dom_id(user, :follow) do %>
  <% if Current.user && Current.user != user %>
    <% if following %>
      <%= button_to user_unfollow_path(slug: user), method: :delete,
            class: "inline-flex items-center gap-x-1.5 rounded-full bg-surface px-4 py-1.5 text-sm font-medium text-gray-700 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 transition-colors" do %>
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
          <path d="M10.375 2.25a4.125 4.125 0 100 8.25 4.125 4.125 0 000-8.25zM7.25 12.75a4.75 4.75 0 00-4.75 4.75c0 .414.336.75.75.75h14.25a.75.75 0 00.75-.75 4.75 4.75 0 00-4.75-4.75H7.25zM16.5 6.75a.75.75 0 000 1.5h4.5a.75.75 0 000-1.5h-4.5z" />
        </svg>
        إلغاء المتابعة
      <% end %>
    <% else %>
      <%= button_to user_follow_path(slug: user), method: :post,
            class: "inline-flex items-center gap-x-1.5 rounded-full bg-gray-900 px-4 py-1.5 text-sm font-medium text-surface hover:bg-gray-700 transition-colors" do %>
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
          <path d="M10.375 2.25a4.125 4.125 0 100 8.25 4.125 4.125 0 000-8.25zM7.25 12.75a4.75 4.75 0 00-4.75 4.75c0 .414.336.75.75.75h14.25a.75.75 0 00.75-.75 4.75 4.75 0 00-4.75-4.75H7.25zM18.75 6a.75.75 0 01.75.75v2.25h2.25a.75.75 0 010 1.5H19.5v2.25a.75.75 0 01-1.5 0v-2.25H15.75a.75.75 0 010-1.5H18V6.75a.75.75 0 01.75-.75z" />
        </svg>
        متابعة
      <% end %>
    <% end %>
  <% end %>
<% end %>
