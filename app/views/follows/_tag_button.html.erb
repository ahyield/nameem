<%= turbo_frame_tag dom_id(tag, :follow) do %>
  <% if Current.user %>
    <% if following %>
      <%= button_to unfollow_topic_path(tag), method: :delete,
            class: "inline-flex items-center gap-x-1.5 rounded-full bg-white px-4 py-1.5 text-sm font-medium text-gray-700 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 transition-colors" do %>
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
          <path fill-rule="evenodd" d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25zm3 10.5a.75.75 0 000-1.5H9a.75.75 0 000 1.5h6z" clip-rule="evenodd" />
        </svg>
        إلغاء المتابعة
      <% end %>
    <% else %>
      <%= button_to follow_topic_path(tag), method: :post,
            class: "inline-flex items-center gap-x-1.5 rounded-full bg-gray-900 px-4 py-1.5 text-sm font-medium text-white hover:bg-gray-700 transition-colors" do %>
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
          <path fill-rule="evenodd" d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25zM12.75 9a.75.75 0 00-1.5 0v2.25H9a.75.75 0 000 1.5h2.25V15a.75.75 0 001.5 0v-2.25H15a.75.75 0 000-1.5h-2.25V9z" clip-rule="evenodd" />
        </svg>
        متابعة
      <% end %>
    <% end %>
  <% end %>
<% end %>
