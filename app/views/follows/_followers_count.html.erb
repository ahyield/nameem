<%# locals: (user:, animate: false) %>
<div id="<%= dom_id(user, :followers_count) %>" class="flex items-center gap-x-2 text-sm text-gray-500">
  <%= link_to user_followers_path(slug: user), class: "hover:text-gray-900 transition-colors" do %>
    <span class="font-semibold text-gray-900 tabular-nums <%= "count-changed" if animate %>"><%= number_with_delimiter(user.followers_count) %></span> متابِع
  <% end %>
  <span class="text-gray-300" aria-hidden="true">·</span>
  <%= link_to user_following_path(slug: user), class: "hover:text-gray-900 transition-colors" do %>
    <span class="font-semibold text-gray-900 tabular-nums"><%= number_with_delimiter(user.following_count) %></span> يتابع
  <% end %>
</div>
