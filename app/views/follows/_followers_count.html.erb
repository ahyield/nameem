<div id="<%= dom_id(user, :followers_count) %>" class="flex gap-x-4 text-sm">
  <%= link_to user_followers_path(slug: user), class: "text-gray-500 hover:text-gray-700" do %>
    <span class="font-semibold text-gray-900"><%= user.followers_count %></span> متابِع
  <% end %>
  <%= link_to user_following_path(slug: user), class: "text-gray-500 hover:text-gray-700" do %>
    <span class="font-semibold text-gray-900"><%= user.following_count %></span> يتابع
  <% end %>
</div>
