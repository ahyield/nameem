<% title "#{@tag.name}" %>
<% description "مقالات عن #{@tag.name} على نميم" %>
<% set_meta_tags og: { description: "مقالات عن #{@tag.name} على نميم" } %>

<%= render "shared/nav" %>

<div class="bg-white px-6 py-24 lg:px-8" dir="rtl">
  <div class="mx-auto max-w-3xl">
    <div class="flex items-center justify-between mb-8">
      <h1 class="text-3xl font-bold tracking-tight text-gray-900"><%= @tag.name %></h1>
      <% if Current.user %>
        <%= render "follows/tag_button", tag: @tag, following: Current.user.following?(@tag) %>
      <% end %>
    </div>

    <div class="space-y-2">
      <%= turbo_frame_tag "topic_feed", src: articles_topic_path(@tag, format: :turbo_stream), loading: "lazy" %>

      <%= turbo_frame_tag "topic_feed_pagination" %>
    </div>
  </div>
</div>

<%= render "shared/footer" %>
