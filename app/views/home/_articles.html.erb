<div class="relative isolate px-6 pt-8 lg:px-8">
  <div class="grid w-full grid-cols-1 gap-x-16 gap-y-8">
    <h1 class="text-9xl opacity-80 bg-gradient-to-r from-slate-100 to-blue-400 inline-block text-transparent bg-clip-text">اختيارات المحررين</h1>
  </div>

  <ul role="list" class="grid mx-auto grid-cols-1 pt-8 relative gap-6 sm:grid-cols-2 lg:grid-cols-3">
    <% @articles.each do |article| %>
      <li class="col-span-1 flex rounded">
        <div class="flex w-full items-center justify-between p-6">
          <div class="flex-1 truncate">
            <div class="flex items-center">

              <%= link_to user_path(article.user) do %>
                <img class="shrink-0 h-6 w-6 rounded-full" src="<%= article.user.avatar %>" alt="">
              <% end %>
              <%= link_to user_path(article.user) do %>
                <h3 class="truncate text-sm mr-2 text-gray-900"><%= article.user.name %></h3>
              <% end %>

            </div>

            <%= link_to article_path(article) do %>
              <h1 class="mt-1 truncate text-2xl text-black"><%= first_paragraph(article) %></h1>
            <% end %>

            <span class="mt-1 text-sm text-gray-400"><%= article.created_at %></span>
          </div>
        <div>
      </li>
    <% end %>
  </ul>
</div>
