<div class="relative isolate px-6 pt-8 lg:px-8">
  <div class="grid w-full grid-cols-1 gap-x-16 gap-y-8">
    <h1 class="text-9xl opacity-80 bg-gradient-to-r from-slate-100 to-orange-400 inline-block text-transparent bg-clip-text">اختيارات المحررين</h1>
  </div>

  <ul role="list" class="grid mx-auto grid-cols-1 pt-8 relative gap-6 sm:grid-cols-2 lg:grid-cols-3">
    <% @picked.each do |article| %>
      <li class="col-span-1 flex rounded">
        <div class="flex w-full justify-between p-6">
          <div class="flex-1">
            <div class="flex">
              <%= link_to user_path(article.user) do %>
                <% if article.user.avatar.attached? %>
                  <%= image_tag article.user.avatar.variant(resize_to_fill: [600, 600]), class: "shrink-0 h-6 w-6 rounded-full" %>
                <% else %>
                    <span class="shrink-0 inline-block h-6 w-6 overflow-hidden rounded-full bg-gray-100">
                    <svg class="h-full w-full text-gray-300" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M24 20.993V24H0v-2.996A14.977 14.977 0 0112.004 15c4.904 0 9.26 2.354 11.996 5.993zM16.002 8.999a4 4 0 11-8 0 4 4 0 018 0z" />
                    </svg>
                <% end %>
              <% end %>
              <%= link_to user_path(article.user) do %>
                <h3 class="truncate text-sm mr-2 mt-1 text-gray-900"><%= article.user.name %></h3>
              <% end %>

            </div>

            <%= link_to user_article_path(uuid: article, slug: article.user) do %>
              <% if article.title.blank? %>
                <h1 class="mt-1 text-xl text-gray-950"><%= first_paragraph(article) %></h1>
              <% else %>
                <h1 class="mt-1 text-xl text-gray-950"><%= article.title %></h1>
              <% end %>

            <% end %>

            <div class="mt-1 flex items-center gap-x-2 text-sm text-gray-400">
              <span><%= short_date(article.published_at) %></span>
              <% if article.reading_time_minutes.present? %>
                <span>.</span>
                <span><%= reading_time_label(article.reading_time_minutes) %></span>
              <% end %>
            </div>

            <p class="mt-1 text-sm text-gray-500 line-clamp-2"><%= article.description&.truncate(160) %></p>

            <% if article.tags.any? %>
              <div class="mt-2 flex flex-wrap gap-1">
                <% article.tags.limit(3).each do |tag| %>
                  <%= link_to tag.name, topic_path(tag), class: "inline-block rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-600" %>
                <% end %>
              </div>
            <% end %>
          </div>
        <div>
      </li>
    <% end %>
  </ul>
</div>
