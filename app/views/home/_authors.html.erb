<div class="relative isolate px-6 pt-8 lg:px-8">
  <div class="grid w-full grid-cols-1 gap-x-16 gap-y-8">
    <h1 class="text-9xl opacity-80 bg-gradient-to-r from-slate-100 to-blue-400 inline-block text-transparent bg-clip-text">مناورون</h1>
  </div>

  <div class="py-8 -mx-6 px-6 overflow-x-auto scrollbar-hide">
    <div class="flex gap-4" style="min-width: max-content;">
      <% @users.each do |user| %>
        <div class="group relative w-48 shrink-0 overflow-hidden rounded-lg">
          <div class="aspect-square">
            <% if user.avatar.attached? %>
              <%= image_tag user.avatar.variant(resize_to_fill: [300, 300]), class: "h-full w-full object-cover object-center group-hover:opacity-75" %>
            <% else %>
              <%= image_tag asset_path("brand/logo.png"), class: "h-full w-full object-cover object-center group-hover:opacity-75" %>
            <% end %>
            <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-b from-transparent to-black opacity-50"></div>
          </div>
          <div class="absolute inset-0 flex items-end p-4">
            <div>
              <h3 class="font-semibold text-white text-lg">
                <%= link_to user.slug do %>
                  <span class="absolute inset-0"></span>
                  <%= user.name %>
                <% end %>
              </h3>
              <p class="text-xs text-gray-300"><%= user.articles.published.count %> مقال</p>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <p class="text-sm text-gray-500">
    <%= link_to "سجّل لمتابعة كتّابك المفضلين", signup_path, class: "text-blue-500 hover:text-blue-700" %>
  </p>
</div>
