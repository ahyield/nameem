<div class="relative isolate px-6 pt-8 lg:px-8">
  <div class="grid w-full grid-cols-1 gap-x-16 gap-y-8">
    <h1 class="text-9xl opacity-80 bg-gradient-to-r from-slate-100 to-blue-400 inline-block text-transparent bg-clip-text">مناورون</h1>
  </div>

  <div class="mx-auto w-full py-8 sm:py-8">
    <div class="mt-6 grid grid-cols-1 gap-y-6 sm:grid-cols-2 sm:grid-rows-2 sm:gap-x-6 lg:gap-8">

      <% @users.each do |user| %>
        <div class="group aspect-h-1 aspect-w-2 overflow-hidden rounded-lg sm:aspect-h-1 sm:aspect-w-1 sm:row-span-2">
          <% if user.avatar.attached? %>
            <%= image_tag user.avatar, class: "object-cover object-center group-hover:opacity-75" %>
          <% else %>
            <%= image_tag asset_path("brand/logo.png"), class: "object-cover object-center group-hover:opacity-75" %>
          <% end %>
          <div aria-hidden="true" class="bg-gradient-to-b from-transparent to-black opacity-50"></div>
          <div class="flex items-end p-6">
            <div>
              <h3 class="font-semibold text-white text-3xl">
                <%= link_to user.slug do %>
                  <span class="absolute inset-0"></span>
                  <%= user.name %>
                <% end %>
              </h3>
              <p aria-hidden="true" class="mt-1 text-black opacity-40 bg-white"><%= user.bio&.truncate(50) %></p>
            </div>
          </div>
        </div>
      <% end %>

    </div>
  </div>
</div>
