<div class="relative isolate px-6 pt-8 lg:px-8">
  <div class="grid w-full grid-cols-1 gap-x-16 gap-y-8">
    <h1 class="text-9xl opacity-80 bg-gradient-to-r from-orange-200 to-orange-500 inline-block text-transparent bg-clip-text">المواضيع</h1>
  </div>

  <div class="space-y-12 py-8">
    <% @tags.each do |tag| %>
      <div>
        <div class="flex items-center justify-between mb-4">
          <%= link_to topic_path(tag), class: "group" do %>
            <h2 class="text-2xl font-bold text-gray-900 group-hover:text-orange-600 transition-colors"><%= tag.name %></h2>
          <% end %>
        </div>

        <div class="grid grid-cols-2 lg:grid-cols-4 gap-6">
          <% tag.articles.published.where("content_html LIKE '%<img%'").order(published_at: :desc).limit(4).each do |article| %>
            <div class="group relative min-w-0">
              <%= link_to article_link(article), data: { turbo: false }, class: "block" do %>
                <div class="h-48 w-full rounded-lg bg-gray-100 overflow-hidden mb-3">
                  <%= image_tag card_cover_url(article, [640, 480]), alt: "", loading: "lazy", decoding: "async",
                                class: "h-48 w-full object-cover group-hover:opacity-75 transition-opacity" %>
                </div>
                <h3 class="text-sm font-semibold text-gray-900 line-clamp-2 group-hover:text-orange-600 transition-colors">
                  <%= article.title.presence || first_paragraph(article)&.truncate(80) %>
                </h3>
                <p class="mt-1 text-xs text-gray-500 line-clamp-2"><%= article.description&.truncate(120) %></p>
              <% end %>
              <p class="mt-1 text-xs text-gray-400"><%= article.user.name %></p>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
