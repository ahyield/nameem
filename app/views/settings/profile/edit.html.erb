<%= content_for :title, "نميم - #{@user.name} - تعديل الحساب" %>

<%= render "shared/nav" %>
<%= render "flashes/alert", alert: flash[:alert] if !flash[:alert].nil? %>
<%= render "flashes/notice", notice: flash[:notice] if !flash[:notice].nil? %>
<%= render "flashes/error", error: flash[:error] if !flash[:error].nil? %>

<div class="mx-auto max-w-7xl pt-16 lg:flex lg:gap-x-16 lg:px-8">

  <aside class="flex overflow-x-auto border-b border-gray-900/5 py-4 lg:block lg:w-64 lg:flex-none lg:border-0 lg:py-20">
    <%= render "settings/sidebar" %>
  </aside>

  <main class="px-4 py-16 sm:px-6 lg:flex-auto lg:px-0 lg:py-20">
    <div class="mx-auto max-w-2xl space-y-16 sm:space-y-20 lg:mx-0 lg:max-w-none">
      <div class="">
        <%= form_with model: @user, url: settings_update_profile_path, html: { class: "md:col-span-2" }, method: :put do |form| %>
          <div class="grid grid-cols-1 gap-x-6 gap-y-8 sm:max-w-xl sm:grid-cols-6">

            <div class="col-span-full flex items-center gap-x-8" data-controller="image-preview">
              <% if @user.avatar.attached? %>
                <%= image_tag current_user.avatar.variant(resize_to_fill: [600, 600]), class: "h-24 w-24 flex-none rounded-full bg-gray-800", data: { target: "image-preview.output" } %>
              <% else %>
                <span class="inline-block h-24 w-24 overflow-hidden rounded-full bg-gray-100">
                  <svg class="image-preview-span h-full w-full text-gray-300" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M24 20.993V24H0v-2.996A14.977 14.977 0 0112.004 15c4.904 0 9.26 2.354 11.996 5.993zM16.002 8.999a4 4 0 11-8 0 4 4 0 018 0z" />
                  </svg>
                  <%= image_tag "brand/logo.png", data: { target: "image-preview.output" }, class: "hidden h-24 w-24 flex-none rounded-full bg-gray-800 object-cover" %>
                </span>
              <% end %>
              <div>
                <%= form.file_field :avatar, class: " hidden", accept: "image/*", data: { target: "image-preview.input",  action: "image-preview#readURL" } %>
                <label for="user_avatar" class=" custom-file-input rounded-md bg-white px-2.5 py-1.5 text-sm font-semibold text-gray-900
                shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50"> تغيير الصورة الشخصية </label>
              </div>
            </div>

            <div class="sm:col-span-full">
              <label for="user_name" class="block text-sm font-medium leading-6 ">الإسم</label>
              <div class="mt-2">
                <%= form.text_field :name, value: @user.name, class: "block w-full rounded-md border-0 py-1.5 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-500 sm:text-sm sm:leading-6", autocomplete: "name" %>
              </div>
            </div>

            <div class="col-span-full">
              <label for="user_slug" class="block text-sm font-medium leading-6">اسم المستخدم</label>
              <div class="mt-2 font-montserrat" dir="ltr">
                <div class="flex rounded-md bg-white/5 ring-1 ring-inset ring-gray-300 focus-within:ring-2 focus-within:ring-inset focus-within:ring-indigo-500">
                  <span class="flex select-none items-center pl-3 text-gray-400 sm:text-sm">nameem.com/</span>
                  <%= form.text_field :slug, value: @user.slug, class: "flex-1 border-0 bg-transparent py-1.5 pl-1 focus:ring-0 sm:text-sm sm:leading-6", autocomplete: "username", placeholder: "username", minlength: "4" %>
                </div>
              </div>
            </div>

            <div class="col-span-full">
              <label for="user_bio" class="block text-sm font-medium leading-6">عن <%= @user.name.first %></label>
              <div class="mt-2" dir="ltr">
                <div class="flex rounded-md bg-white/5 ring-1 ring-inset ring-gray-300 focus-within:ring-2 focus-within:ring-inset focus-within:ring-indigo-500">
                  <%= form.text_area :bio, value: @user.bio, class: "flex-1 border-0 bg-transparent py-1.5 pl-1 focus:ring-0 sm:text-sm sm:leading-6", dir: "rtl" %>
                </div>
              </div>
            </div>
          </div>

          <div class="mt-8 flex">
            <%= form.submit "حفظ", class: "rounded-md bg-blue-50 px-3.5 py-2.5 text-sm font-semibold text-blue-600 shadow-sm hover:bg-blue-100" %>
          </div>
        <% end %>
      </div>
    </div>
  </main>
</div>
<%= render "shared/footer" %>
