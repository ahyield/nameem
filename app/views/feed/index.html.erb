<%= render "shared/nav" %>

<div class="mx-auto max-w-3xl px-4 py-14 sm:px-6 lg:max-w-7xl lg:px-8">
  <h1 class="sr-only">Page title</h1>
  <!-- Main 3 column grid -->
  <div class="grid grid-cols-1 items-start gap-1 lg:grid-cols-3">
    <!-- Right column -->
    <div class="grid grid-cols-1 gap-4 lg:col-span-2">
      <section aria-labelledby="section-1-title">
        <h2 class="sr-only" id="section-1-title">Section title</h2>
        <div class="overflow-hidden rounded-lg bg-white">
          <div class="p-6">

            <div>
              <div class="sm:hidden">
                <label for="tabs" class="sr-only">اختر من القائمة</label>
                <!-- Use an "onChange" listener to redirect the user to the selected tab URL. -->
                <select id="tabs" name="tabs" class="block w-full rounded-md border-gray-300 py-2 pl-3 pr-10 text-base focus:border-indigo-500 focus:outline-none focus:ring-indigo-500 sm:text-sm">
                  <option>الأحدث</option>
                  <option>اختيارات المحررين</option>
                  <option selected>الشائع</option>
                </select>
              </div>
              <div class="hidden sm:block">
                <div class="border-b border-gray-200">
                  <nav class="-mb-px flex space-x-4 rtl:space-x-reverse" aria-label="Tabs">
                    <!-- Current: "border-indigo-500 text-indigo-600", Default: "border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700" -->
                    <a href="#" class="border-indigo-500 text-indigo-600 whitespace-nowrap border-b-2 text-lg py-4 px-1 font-medium">الأحدث</a>
                    <a href="#" class="border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700 text-lg whitespace-nowrap border-b-2 py-4 px-1 font-medium">اختيارات المحررين</a>
                    <a href="#" class="border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700 text-lg whitespace-nowrap border-b-2 py-4 px-1 font-medium">الشائع</a>
                  </nav>
                </div>
              </div>
            </div>

            <div class="my-8 content-center space-y-14 lg:my-8 lg:py-6 lg:space-y-10">

              <% @articles.each do |article| %>
                <article class="relative pb-8 border-gray-200 border-b isolate gap-x-6 flex flex-1 flex-row">
                  <div class="grow max-h-42">
                    <div class="flex items-center gap-x-4 text-xs">
                      <div class="flex  ">
                        <div class="relative flex items-center gap-x-4">
                          <% if article.user.avatar.attached? %>
                            <%= image_tag article.user.avatar.url(:thumb), class: "h-9 w-9 rounded-full bg-gray-50" %>
                          <% else %>
                            <span class="inline-block h-8 w-8 overflow-hidden rounded-full bg-gray-100">
                              <svg class="h-full w-full text-gray-300" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M24 20.993V24H0v-2.996A14.977 14.977 0 0112.004 15c4.904 0 9.26 2.354 11.996 5.993zM16.002 8.999a4 4 0 11-8 0 4 4 0 018 0z" />
                              </svg>
                            </span>
                          <% end %>
                          <div class="text-sm leading-6">
                            <p class="font-semibold text-gray-900">
                            <%= link_to user_path(article.user) do %>
                              <%= article.user.name %>
                              <span class="absolute inset-0"></span>
                            <% end %>
                            </p>
                          </div>
                        </div>
                      </div>
                      <span>.</span>
                      <time datetime="2020-03-16" class="text-gray-500"><%= article.published_at %> </time>
                    </div>
                    <div class="group relative max-w-xl">
                      <%= link_to article_path(article) do %>
                        <h1 class="mt-2 text-2xl font-semibold text-gray-900">
                          <span class="absolute inset-0"></span>
                          <% if article.title.blank? %>
                            <%= first_paragraph(article)&.truncate(150) %>
                          <% else %>
                            <%= article.title.truncate(150) %>
                          <% end %>
                        </h1>
                      <% end %>
                      <p class="hidden lg:block mt-2 text-sm leading-6 text-gray-600"><%= article_description(article)&.truncate(320) %></p>
                    </div>
                  </div>
                  <%= link_to article_path(article) do %>
                    <div class="relative mt-4 aspect-[112/112] lg:aspect-square w-24 h-24 md:w-24 md:h-24 lg:w-32 lg:h-32">
                      <% if article_cover(article) %>
                        <%= image_tag article_cover(article), class: "absolute inset-0 h-full w-full bg-gray-50 object-cover" %>
                      <% else %>
                        <img src="https://images.unsplash.com/photo-1496128858413-b36217c2ce36?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=crop&w=3603&q=80" alt="" class="absolute inset-0 h-full w-full bg-gray-50 object-cover">
                      <% end %>
                      <div class="absolute inset-0 ring-1 ring-inset ring-gray-900/10"></div>
                    </div>
                  <% end %>
                </article>
              <% end %>
            </div>

          </div>
        </div>
      </section>
    </div>

    <!-- Left column -->
    <div class="grid grid-cols-1 gap-4">
      <section aria-labelledby="section-2-title">
        <h2 class="sr-only" id="section-2-title">اخترنا لك</h2>
        <div class="overflow-hidden rounded-lg bg-white">
          <div class="p-6">
            <h1>اخترنا لك</h1>
          </div>

          <ul role="list" class="grid p-6 gap-y-4 sm:grid-cols-1 sm:gap-y-8 xl:col-span-1">

            <% @users.each do |user| %>
              <li>
                <div class="flex gap-x-3">
                  <% if user.avatar.attached? %>
                    <%= image_tag user.avatar.url(:thumb), class: "h-8 w-8 inline-block flex-shrink-0 overflow-hidden rounded-full" %>
                  <% else %>
                    <span class="inline-block h-8 w-8 flex-shrink-0 overflow-hidden rounded-full bg-gray-100">
                      <svg class="h-full w-full text-gray-300" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M24 20.993V24H0v-2.996A14.977 14.977 0 0112.004 15c4.904 0 9.26 2.354 11.996 5.993zM16.002 8.999a4 4 0 11-8 0 4 4 0 018 0z" />
                      </svg>
                    </span>
                  <% end %>
                  <div>
                    <h3 class="text-base text-sm font-semibold leading-7 tracking-tight text-gray-900"><%= user.name %></h3>
                    <p class="text-xs leading-6 text-gray-500">
                    <%= user.bio&.truncate(120) %>
                    </p>
                  </div>
                </div>
              </li>
            <% end %>

          </ul>
        </div>
      </section>

      <%= render "shared/footer" %>
    </div>
  </div>
</div>
