<% title "" %>

<%= render "shared/nav" %>
<%= render "flashes/alert", alert: flash[:alert] if !flash[:alert].nil? %>
<%= render "flashes/notice", notice: flash[:notice] if !flash[:notice].nil? %>
<%= render "flashes/error", error: flash[:error] if !flash[:error].nil? %>

<div class="mx-auto max-w-3xl px-4 py-14 sm:px-6 lg:max-w-7xl lg:px-8">
  <h1 class="sr-only">Page title</h1>
  <!-- Main 3 column grid -->
  <div class="grid grid-cols-1 items-start gap-1 lg:grid-cols-3">
    <!-- Right column -->
    <div class="grid grid-cols-1 gap-4 lg:col-span-2">
      <section aria-labelledby="section-1-title">
        <h2 class="sr-only" id="section-1-title">Section title</h2>
        <div class="rounded-lg bg-white">
          <div class="p-6">

            <div class="self-start sticky top-0 z-20 bg-white">
              <div class="block">
                <div class="border-b border-gray-200">
                  <nav class="-mb-px flex space-x-4 rtl:space-x-reverse" data-controller="feed-active-link" data-turbo-frame="feed" aria-label="Tabs">
                    <%= link_to "اختيارات المحررين", picked_feed_path, data: { turbo_stream: "feed" },
                      class: "text-lg whitespace-nowrap border-b-2 py-4 px-1 font-medium", "data-feed-active-link-target": "link" %>
                    <%= link_to "الرائج", trending_feed_path, data: { turbo_stream: "feed" },
                      class: "text-lg whitespace-nowrap border-b-2 py-4 px-1 font-medium", "data-feed-active-link-target": "link" %>
                    <%= link_to "الأحدث", latest_feed_path, data: { turbo_stream: "feed" },
                      class: "text-lg whitespace-nowrap border-b-2 py-4 px-1 font-medium", "data-feed-active-link-target": "link" %>
                    <% if Current.user %>
                      <%= link_to "المتابَعون", following_feed_path, data: { turbo_stream: "feed" },
                        class: "text-lg whitespace-nowrap border-b-2 border-transparent text-gray-400 hover:text-gray-600 py-4 px-1 font-medium", "data-feed-active-link-target": "link" %>
                    <% end %>
                  </nav>
                </div>
              </div>
            </div>

            <div class="my-6 content-center">
              <%= turbo_frame_tag "feed", src: picked_feed_path(format: :turbo_stream, page: params[:page]), loading: "lazy" %>

              <%= turbo_frame_tag "feed_pagination" %>
            </div>

          </div>
        </div>
      </section>
    </div>

    <!-- Left column -->
    <div class="grid my-6 grid-cols-1 gap-4 self-start sticky top-0">
      <section aria-labelledby="section-2-title">
        <h2 class="sr-only" id="section-2-title">اخترنا لك</h2>
        <div class="overflow-hidden rounded-lg bg-white">
          <div class="p-6 pb-3">
            <h1 class="font-bold text-gray-900">اخترنا لك</h1>
          </div>

          <ul role="list" class="grid p-6 pt-0 gap-y-8 sm:grid-cols-1 xl:col-span-1">

            <% @users.each do |user| %>
              <li>
                <div class="flex gap-x-3 items-start">
                  <div class="shrink-0">
                    <%= link_to user_path(user) do %>
                      <% if user.avatar.attached? %>
                        <%= image_tag user.avatar.variant(resize_to_fill: [600, 600]), class: "h-8 w-8 inline-block overflow-hidden rounded-full" %>
                      <% else %>
                        <span class="inline-block h-8 w-8 flex-shrink-0 overflow-hidden rounded-full bg-gray-100">
                          <svg class="h-full w-full text-gray-300" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M24 20.993V24H0v-2.996A14.977 14.977 0 0112.004 15c4.904 0 9.26 2.354 11.996 5.993zM16.002 8.999a4 4 0 11-8 0 4 4 0 018 0z" />
                          </svg>
                        </span>
                      <% end %>
                    <% end %>
                  </div>
                  <div class="min-w-0">
                    <%= link_to user_path(user) do %>
                      <h3 class="text-sm font-semibold leading-6 text-gray-900"><%= user.name %></h3>
                      <p class="text-xs leading-5 text-gray-500 line-clamp-1"><%= user.bio&.truncate(120) %></p>
                    <% end %>
                  </div>
                </div>
              </li>
            <% end %>

          </ul>
        </div>
      </section>

      <% if @trending.any? %>
        <section aria-labelledby="section-trending-title">
          <h2 class="sr-only" id="section-trending-title">الرائج هذا الأسبوع</h2>
          <div class="overflow-hidden rounded-lg bg-white">
            <div class="p-6 pb-2">
              <h1 class="font-bold text-gray-900">الرائج هذا الأسبوع</h1>
            </div>
            <ol class="px-6 pb-6">
              <% @trending.each_with_index do |article, i| %>
                <li class="py-3 <%= 'border-b border-gray-100' unless i == @trending.size - 1 %>">
                  <div class="flex gap-x-3">
                    <span class="text-2xl font-bold text-gray-200 leading-none mt-1"><%= format("%02d", i + 1) %></span>
                    <div class="min-w-0">
                      <div class="flex items-center gap-x-2 mb-1">
                        <% if article.user.avatar.attached? %>
                          <%= image_tag article.user.avatar.variant(resize_to_fill: [64, 64]), class: "h-5 w-5 rounded-full bg-gray-50" %>
                        <% end %>
                        <span class="text-xs text-gray-500 truncate"><%= article.user.name %></span>
                      </div>
                      <%= link_to user_article_path(uuid: article, slug: article.user), data: { turbo: false },
                          class: "text-sm font-semibold text-gray-900 hover:text-gray-600 transition-colors line-clamp-2" do %>
                        <%= article.title&.truncate(80) %>
                      <% end %>
                      <div class="flex items-center gap-3 mt-1 text-xs text-gray-400">
                        <time><%= short_date(article.published_at) %></time>
                        <% if article.reading_time_minutes.present? %>
                          <span><%= article.reading_time_minutes %> د قراءة</span>
                        <% end %>
                      </div>
                    </div>
                  </div>
                </li>
              <% end %>
            </ol>
          </div>
        </section>
      <% end %>

      <% if @tags.any? %>
        <section aria-labelledby="section-topics-title">
          <h2 class="sr-only" id="section-topics-title">المواضيع</h2>
          <div class="overflow-hidden rounded-lg bg-white">
            <div class="p-6 pb-3">
              <h1 class="font-bold text-gray-900">المواضيع</h1>
            </div>
            <div class="px-6 pb-4 flex flex-wrap gap-2">
              <% @tags.each do |tag| %>
                <%= link_to tag.name, topic_path(tag), class: "inline-block rounded-full bg-gray-100 px-3 py-1 text-sm font-medium text-gray-600 hover:bg-gray-200 transition-colors", data: { turbo: false } %>
              <% end %>
            </div>
            <div class="px-6 pb-6">
              <%= link_to "عرض الكل", topics_path, class: "text-sm text-blue-500 hover:text-blue-700", data: { turbo: false } %>
            </div>
          </div>
        </section>
      <% end %>

      <%= render "shared/footer" %>
    </div>
  </div>
</div>
