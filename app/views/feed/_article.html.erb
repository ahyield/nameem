<article class="relative my-6 pb-8 border-gray-200 z-10 border-b isolate gap-x-6 flex flex-1 flex-row">
  <div class="grow max-h-42">
    <div class="flex items-center gap-x-4 text-xs">
      <div class="flex">
        <div class="relative flex items-center gap-x-4">
          <% if article.user.avatar.attached? %>
            <%= image_tag article.user.avatar.variant(resize_to_fill: [600, 600]), class: "h-9 w-9 rounded-full bg-gray-50" %>
          <% else %>
            <span class="inline-block h-8 w-8 overflow-hidden rounded-full bg-gray-100">
              <svg class="h-full w-full text-gray-300" fill="currentColor" viewBox="0 0 24 24">
                <path d="M24 20.993V24H0v-2.996A14.977 14.977 0 0112.004 15c4.904 0 9.26 2.354 11.996 5.993zM16.002 8.999a4 4 0 11-8 0 4 4 0 018 0z" />
              </svg>
            </span>
          <% end %>
          <div class="text-sm leading-6">
            <p class="font-semibold text-gray-900">
            <%= link_to user_path(article.user), data: { turbo: false } do %>
              <%= article.user.name %>
              <span class="absolute inset-0"></span>
            <% end %>
            </p>
          </div>
        </div>
      </div>
      <span>.</span>
      <time class="text-gray-500"><%= short_date(article.published_at) %> </time>
    </div>
    <div class="group relative max-w-xl">
      <%= link_to user_article_path(uuid: article, slug: article.user), data: { turbo: false } do %>
        <h1 class="mt-2 text-2xl font-semibold text-gray-900">
          <span class="absolute inset-0"></span>
          <% if article.title.blank? %>
            <%= first_paragraph(article)&.truncate(150) %>
          <% else %>
            <%= article.title.truncate(150) %>
          <% end %>
        </h1>
      <% end %>
      <p class="hidden lg:block mt-2 text-sm leading-6 text-gray-600"><%= article.description&.truncate(320) %></p>
    </div>
  </div>
  <%= link_to user_article_path(uuid: article, slug: article.user), data: { turbo: false } do %>
    <div class="relative mt-4 aspect-[112/112] lg:aspect-square w-24 h-24 md:w-24 md:h-24 lg:w-32 lg:h-32">
      <% if article_cover(article) %>
        <%= image_tag article_cover(article), class: "absolute inset-0 h-full w-full bg-gray-50 object-cover" %>
      <% end %>
      <div class="absolute inset-0 ring-inset ring-gray-900/10"></div>
    </div>
  <% end %>
</article>
