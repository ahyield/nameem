<%= render "shared/nav" %>
<%= render "flashes/error", error: flash[:error] if !flash[:error].nil? %>

<div class="login-accounts-form flex min-h-full flex-col justify-center py-12 sm:px-6 lg:px-8 pt-20" dir="ltr">
  <div class="sm:mx-auto sm:w-full sm:max-w-md">
    <img class="mx-auto h-10 w-auto" src="<%= asset_path("brand/logo.png") %>" alt="نميم">
    <h2 class="mt-6 text-center text-2xl font-bold leading-9 tracking-tight text-gray-900">تسجيل الدخول</h2>
  </div>

  <div class="mt-10 sm:mx-auto sm:w-full sm:max-w-[480px]">
    <div class="bg-white px-6 space-y-4 py-12 shadow sm:rounded-lg sm:px-12">
      <%= button_to "/auth/facebook", data: { turbo: false }, class: "flex w-full items-center justify-center gap-3
      rounded-md bg-[#1877f2] px-3 py-1.5 text-white focus-visible:outline hover:opacity-90 focus-visible:outline-2
      focus-visible:outline-offset-2 focus-visible:outline-[#24292F]" do %>
        <svg style="fill-rule:evenodd;clip-rule:evenodd;stroke-linejoin:round;stroke-miterlimit:2;" version="1.1" viewBox="0 0 512 512" width="7%" xml:space="preserve" xmlns="http://www.w3.org/2000/svg" xmlns:serif="http://www.serif.com/" xmlns:xlink="http://www.w3.org/1999/xlink"><g><path d="M512,256c0,-141.385 -114.615,-256 -256,-256c-141.385,0 -256,114.615 -256,256c0,127.777 93.616,233.685 216,252.89l0,-178.89l-65,0l0,-74l65,0l0,-56.4c0,-64.16 38.219,-99.6 96.695,-99.6c28.009,0 57.305,5 57.305,5l0,63l-32.281,0c-31.801,0 -41.719,19.733 -41.719,39.978l0,48.022l71,0l-11.35,74l-59.65,0l0,178.89c122.385,-19.205 216,-125.113 216,-252.89Z" style="fill:#1877f2;fill-rule:nonzero;" /><path d="M355.65,330l11.35,-74l-71,0l0,-48.022c0,-20.245 9.917,-39.978 41.719,-39.978l32.281,0l0,-63c0,0 -29.297,-5 -57.305,-5c-58.476,0 -96.695,35.44 -96.695,99.6l0,56.4l-65,0l0,74l65,0l0,178.89c13.033,2.045 26.392,3.11 40,3.11c13.608,0 26.966,-1.065 40,-3.11l0,-178.89l59.65,0Z" style="fill:#fff;fill-rule:nonzero;" /></g></svg>
        <span class="text-sm font-semibold text-white font-montserrat leading-6">Facebook</span>
      <% end %>

      <button data-controller="forms--sign-in" data-action="click->forms--sign-in#emailForm" class="flex w-full items-center justify-center gap-3 rounded-md bg-slate-700 hover:opacity-90 px-3 py-1.5 text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1D9BF0]">
        <%= heroicon "envelope", class: "h-5 w-5" %>
        <span class="text-sm font-semibold font-montserrat leading-6">Email</span>
      </button>
    </div>
  </div>
</div>

<div class="email-form flex min-h-full hidden flex-col justify-center py-12 text-right sm:px-6 lg:px-8 pt-20" dir="ltr">
  <div class="sm:mx-auto sm:w-full sm:max-w-md">
    <img class="mx-auto h-10 w-auto" src="https://scontent-vie1-1.xx.fbcdn.net/v/t39.30808-6/398650437_3485800738399976_5251004330150639205_n.jpg?_nc_cat=103&ccb=1-7&_nc_sid=5f2048&_nc_ohc=yS4kSNZJyG8AX9OYFBL&_nc_ht=scontent-vie1-1.xx&oh=00_AfBWqrQEgiXFon8zDxPzmMnmlLgyLnfCvDNgsM__k73-iw&oe=654B9AE5" alt="Your Company">
    <h2 class="mt-6 text-center text-2xl font-bold leading-9 tracking-tight text-gray-900">تسجيل الدخول</h2>
  </div>

  <div class="mt-10 sm:mx-auto sm:w-full sm:max-w-[480px]">
    <div class="bg-white px-6 space-y-4 py-12 shadow sm:rounded-lg sm:px-12">
      <%= form_for "login", url: login_path, method: :post, class: "space-y-6 font-montserrat" do |form| %>
        <div class="text-left">
          <label for="email" class="block text-sm font-medium leading-6 text-gray-900">Email address</label>
          <div class="mt-2">
            <%= form.text_field :email, id: "email", type: "email", autocomplete: "email", required: true,
              class: "block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
          </div>
        </div>

        <%= form.button "تسجيل دخول", class: "flex font-naskh w-full justify-center rounded-md
                                     text-white bg-gradient-to-l from-cyan-400 to-blue-500 hover:from-cyan-500 hover:to-blue-600 px-3 py-1.5
                                     text-sm font-semibold leading-6 text-white shadow-sm focus-visible:outline focus-visible:outline-2
                                     focus-visible:outline-offset-2 focus-visible:outline-indigo-600" %>
      <% end %>
      <button data-controller="forms--sign-in" data-action="click->forms--sign-in#signInForm" class="font-semibold font-nask text-gray-600 hover:text-gray-500">طريقة أخرى؟</button>
    </div>
  </div>
</div>
