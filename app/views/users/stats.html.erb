<% title "نميم - إحصائيات #{@user.name}" %>

<%= render "shared/nav" %>

<div class="mx-auto max-w-5xl px-4 py-20 sm:px-6 lg:px-8">
  <h1 class="text-2xl font-bold text-gray-900 mb-8">الإحصائيات</h1>

  <!-- Aggregate cards -->
  <dl class="grid grid-cols-2 gap-4 sm:grid-cols-4 mb-10">
    <% [
      ["مشاهدات المقالات", @total_views, @this_week[:views], "bg-orange-400/10"],
      ["زيارات الملف الشخصي", @profile_views, @this_week[:profile], "bg-teal-400/10"],
      ["الإعجابات", @total_likes, @this_week[:likes], "bg-rose-400/10"],
      ["التعليقات", @total_comments, @this_week[:comments], "bg-amber-400/10"]
    ].each do |label, total, week, glow| %>
      <div class="relative overflow-hidden rounded-2xl bg-white/60 backdrop-blur-sm px-5 py-6 shadow-sm ring-1 ring-gray-900/5">
        <div class="absolute -top-6 -left-6 h-24 w-24 rounded-full <%= glow %> blur-2xl"></div>
        <dt class="text-sm font-medium text-gray-500"><%= label %></dt>
        <dd class="mt-2 text-3xl font-bold text-gray-900 tabular-nums"><%= number_with_delimiter(total) %></dd>
        <dd class="mt-1 h-4 text-xs text-gray-500">
          <% if week.positive? %>
            <span class="font-medium text-orange-600 tabular-nums">+<%= number_with_delimiter(week) %></span> هذا الأسبوع
          <% end %>
        </dd>
      </div>
    <% end %>
  </dl>

  <!-- New readers, last 30 days -->
  <% days = @daily_readers.size %>
  <% peak = @daily_readers.map(&:last).max.to_i %>
  <section class="mb-10 rounded-xl bg-white px-6 py-5 shadow-sm ring-1 ring-gray-900/5" aria-labelledby="readers-title">
    <div class="mb-4 flex items-baseline justify-between gap-4">
      <h2 id="readers-title" class="text-lg font-semibold text-gray-900">قرّاء جدد</h2>
      <p class="text-sm text-gray-500">
        <span class="font-semibold text-gray-900 tabular-nums"><%= number_with_delimiter(@daily_readers.sum(&:last)) %></span>
        خلال آخر <%= days %> يومًا
      </p>
    </div>

    <svg viewBox="0 0 <%= days * 10 %> 64" class="h-24 w-full" preserveAspectRatio="none" role="img"
         aria-label="عدد القرّاء الجدد يوميًا خلال آخر <%= days %> يومًا">
      <% @daily_readers.each_with_index do |(date, count), i| %>
        <% height = count.positive? ? [(count.to_f / peak * 60).round(1), 3].max : 2 %>
        <%# Oldest day on the right, today on the left, matching the RTL reading direction %>
        <rect x="<%= (days - 1 - i) * 10 + 1.5 %>" y="<%= 64 - height %>" width="7" height="<%= height %>" rx="1.5"
              class="<%= count.positive? ? "fill-orange-400 hover:fill-orange-600" : "fill-gray-200" %> transition-colors">
          <title><%= l(date, format: :long) %>: <%= count %></title>
        </rect>
      <% end %>
    </svg>
    <div class="mt-2 flex justify-between text-xs text-gray-400">
      <span><%= l(@daily_readers.first.first, format: :short) %></span>
      <span>اليوم</span>
    </div>
  </section>

  <!-- Per-article table -->
  <div id="articles" class="scroll-mt-20 rounded-xl bg-white shadow-sm ring-1 ring-gray-900/5 overflow-hidden">
    <div class="px-6 py-5 border-b border-gray-100">
      <h2 class="text-lg font-semibold text-gray-900">أداء المقالات</h2>
      <p class="mt-1 text-sm text-gray-500"><%= @articles.size %> مقالة منشورة</p>
    </div>
    <div class="overflow-x-auto">
      <table class="min-w-full">
        <thead>
          <tr class="border-b border-gray-100">
            <th scope="col" class="px-6 py-3.5 text-right text-xs font-semibold text-gray-500">العنوان</th>
            <%= stats_sort_header("تاريخ النشر", "date") %>
            <%= stats_sort_header("المشاهدات", "views") %>
            <%= stats_sort_header("الإعجابات", "likes") %>
            <%= stats_sort_header("التعليقات", "comments") %>
          </tr>
        </thead>
        <tbody>
          <% @articles.each do |article| %>
            <% top = article == @top_article %>
            <tr class="group border-b border-gray-50 last:border-0 transition-colors hover:bg-gray-50/80 <%= "bg-orange-50/40" if top %>">
              <td class="px-6 py-4 max-w-xs">
                <div class="flex items-center gap-2">
                  <% if top %>
                    <span class="inline-flex items-center rounded-full bg-orange-100 px-2 py-0.5 text-[10px] font-medium text-orange-700 whitespace-nowrap">الأكثر مشاهدة</span>
                  <% end %>
                  <%= link_to article.title, user_article_path(slug: @user.slug, uuid: article.uuid),
                      class: "text-sm font-medium text-gray-900 group-hover:text-orange-600 transition-colors truncate block" %>
                </div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-400"><%= l(article.published_at.to_date, format: :long) %></td>
              <td class="px-6 py-4 whitespace-nowrap">
                <% share = @total_views.positive? ? (article.real_views_count * 100.0 / @total_views).round : 0 %>
                <div class="flex items-center gap-3" title="<%= share %>٪ من إجمالي المشاهدات">
                  <span class="w-8 text-sm font-medium text-gray-700 tabular-nums"><%= number_with_delimiter(article.real_views_count) %></span>
                  <div class="h-1.5 w-20 overflow-hidden rounded-full bg-gray-100" aria-hidden="true">
                    <div class="h-full rounded-full bg-orange-400"
                         style="width: <%= @max_views.positive? ? (article.real_views_count * 100.0 / @max_views).round(1) : 0 %>%"></div>
                  </div>
                </div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-700 tabular-nums"><%= number_with_delimiter(article.likes_count) %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-700 tabular-nums"><%= number_with_delimiter(article.comments_count) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <% if @articles.empty? %>
      <div class="px-6 py-16 text-center">
        <p class="text-sm text-gray-400">لا توجد مقالات منشورة بعد</p>
      </div>
    <% end %>
  </div>
</div>
