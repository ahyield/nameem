<% title "نميم - إحصائيات #{@user.name}" %>

<%= render "shared/nav" %>

<div class="mx-auto max-w-5xl px-4 py-20 sm:px-6 lg:px-8">
  <h1 class="text-2xl font-bold text-gray-900 mb-8">الإحصائيات</h1>

  <!-- Aggregate cards -->
  <div class="grid grid-cols-2 gap-4 sm:grid-cols-4 mb-10">
    <div class="rounded-lg bg-white px-4 py-5 shadow">
      <dt class="text-sm font-medium text-gray-500">المشاهدات</dt>
      <dd class="mt-1 text-3xl font-semibold text-gray-900"><%= number_with_delimiter(@total_views) %></dd>
    </div>
    <div class="rounded-lg bg-white px-4 py-5 shadow">
      <dt class="text-sm font-medium text-gray-500">الزوار</dt>
      <dd class="mt-1 text-3xl font-semibold text-gray-900"><%= number_with_delimiter(@total_visitors) %></dd>
    </div>
    <div class="rounded-lg bg-white px-4 py-5 shadow">
      <dt class="text-sm font-medium text-gray-500">الإعجابات</dt>
      <dd class="mt-1 text-3xl font-semibold text-gray-900"><%= number_with_delimiter(@total_likes) %></dd>
    </div>
    <div class="rounded-lg bg-white px-4 py-5 shadow">
      <dt class="text-sm font-medium text-gray-500">التعليقات</dt>
      <dd class="mt-1 text-3xl font-semibold text-gray-900"><%= number_with_delimiter(@total_comments) %></dd>
    </div>
  </div>

  <!-- 30-day chart -->
  <% if @timeseries.present? %>
    <% max_val = @timeseries.map { |d| [d[:pageviews], d[:visitors]].max }.max %>
    <% max_val = 1 if max_val.zero? %>
    <div class="rounded-xl bg-white p-6 shadow-sm ring-1 ring-gray-900/5 mb-10" data-controller="stats-chart">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-lg font-semibold text-gray-900">آخر 30 يوم</h2>
        <div class="flex items-center gap-4 text-xs text-gray-500">
          <span class="flex items-center gap-1.5"><span class="inline-block h-2.5 w-2.5 rounded-sm bg-blue-500/70"></span>المشاهدات</span>
          <span class="flex items-center gap-1.5"><span class="inline-block h-2.5 w-2.5 rounded-sm bg-teal-500/70"></span>الزوار</span>
        </div>
      </div>

      <div class="flex items-end gap-px h-48" data-stats-chart-target="chart">
        <% @timeseries.each do |day| %>
          <% views_pct = (day[:pageviews].to_f / max_val * 100).round(1) %>
          <% visitors_pct = (day[:visitors].to_f / max_val * 100).round(1) %>
          <div class="group relative flex-1 flex items-end gap-px h-full min-w-0">
            <div class="flex-1 rounded-t bg-blue-500/70 transition-all duration-200 group-hover:bg-blue-500" style="height: <%= views_pct %>%"></div>
            <div class="flex-1 rounded-t bg-teal-500/70 transition-all duration-200 group-hover:bg-teal-500" style="height: <%= visitors_pct %>%"></div>
            <div class="pointer-events-none absolute bottom-full left-1/2 -translate-x-1/2 mb-2 opacity-0 group-hover:opacity-100 transition-opacity z-10">
              <div class="rounded-lg bg-gray-900 text-white text-xs px-3 py-2 whitespace-nowrap shadow-lg">
                <div class="font-medium mb-1"><%= Date.parse(day[:date]).strftime("%-d/%-m") %></div>
                <div>المشاهدات: <span class="tabular-nums"><%= day[:pageviews] %></span></div>
                <div>الزوار: <span class="tabular-nums"><%= day[:visitors] %></span></div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- Per-article table -->
  <div class="rounded-xl bg-white shadow-sm ring-1 ring-gray-900/5 overflow-hidden">
    <div class="px-6 py-5 border-b border-gray-100">
      <h2 class="text-lg font-semibold text-gray-900">أداء المقالات</h2>
      <p class="mt-1 text-sm text-gray-500"><%= @articles.size %> مقالة منشورة</p>
    </div>
    <div class="overflow-x-auto">
      <table class="min-w-full">
        <thead>
          <tr class="border-b border-gray-100">
            <th scope="col" class="px-6 py-3.5 text-right text-xs font-semibold text-gray-500">العنوان</th>
            <th scope="col" class="px-6 py-3.5 text-right text-xs font-semibold text-gray-500">تاريخ النشر</th>
            <th scope="col" class="px-6 py-3.5 text-right text-xs font-semibold text-gray-500">المشاهدات</th>
            <th scope="col" class="px-6 py-3.5 text-right text-xs font-semibold text-gray-500">الزوار</th>
            <th scope="col" class="px-6 py-3.5 text-right text-xs font-semibold text-gray-500">الإعجابات</th>
            <th scope="col" class="px-6 py-3.5 text-right text-xs font-semibold text-gray-500">التعليقات</th>
          </tr>
        </thead>
        <tbody>
          <% @articles.each_with_index do |article, i| %>
            <tr class="group border-b border-gray-50 last:border-0 transition-colors hover:bg-gray-50/80 <%= "bg-amber-50/40" if @top_article && article == @top_article %>">
              <td class="px-6 py-4 max-w-xs">
                <div class="flex items-center gap-2">
                  <% if @top_article && article == @top_article %>
                    <span class="inline-flex items-center rounded-full bg-amber-100 px-2 py-0.5 text-[10px] font-medium text-amber-700 whitespace-nowrap">الأكثر مشاهدة</span>
                  <% end %>
                  <%= link_to article.title, user_article_path(slug: @user.slug, uuid: article.uuid),
                      class: "text-sm font-medium text-gray-900 group-hover:text-blue-600 transition-colors truncate block" %>
                </div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-400"><%= l(article.published_at.to_date, format: :long) %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-700 tabular-nums"><%= number_with_delimiter(article.views_count) %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-700 tabular-nums"><%= number_with_delimiter(article.visitors_count) %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-700 tabular-nums"><%= number_with_delimiter(article.likes_count) %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-700 tabular-nums"><%= number_with_delimiter(article.comments_count) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <% if @articles.empty? %>
      <div class="px-6 py-16 text-center">
        <p class="text-sm text-gray-400">لا توجد مقالات منشورة بعد</p>
      </div>
    <% end %>
  </div>
</div>
