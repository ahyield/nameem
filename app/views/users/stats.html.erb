<% title "نميم - إحصائيات #{@user.name}" %>

<%= render "shared/nav" %>

<div class="mx-auto max-w-5xl px-4 py-20 sm:px-6 lg:px-8">
  <h1 class="text-2xl font-bold text-gray-900 mb-8">الإحصائيات</h1>

  <!-- Aggregate cards -->
  <div class="grid grid-cols-2 gap-4 sm:grid-cols-4 mb-10">
    <div class="relative overflow-hidden rounded-2xl bg-white/60 backdrop-blur-sm px-5 py-6 shadow-sm ring-1 ring-gray-900/5">
      <div class="absolute -top-6 -left-6 h-24 w-24 rounded-full bg-orange-400/10 blur-2xl"></div>
      <dt class="text-sm font-medium text-gray-500">مشاهدات المقالات</dt>
      <dd class="mt-2 text-3xl font-bold text-gray-900 tabular-nums"><%= number_with_delimiter(@total_views) %></dd>
    </div>
    <div class="relative overflow-hidden rounded-2xl bg-white/60 backdrop-blur-sm px-5 py-6 shadow-sm ring-1 ring-gray-900/5">
      <div class="absolute -top-6 -left-6 h-24 w-24 rounded-full bg-teal-400/10 blur-2xl"></div>
      <dt class="text-sm font-medium text-gray-500">زيارات الملف الشخصي</dt>
      <dd class="mt-2 text-3xl font-bold text-gray-900 tabular-nums"><%= number_with_delimiter(@profile_views) %></dd>
    </div>
    <div class="relative overflow-hidden rounded-2xl bg-white/60 backdrop-blur-sm px-5 py-6 shadow-sm ring-1 ring-gray-900/5">
      <div class="absolute -top-6 -left-6 h-24 w-24 rounded-full bg-rose-400/10 blur-2xl"></div>
      <dt class="text-sm font-medium text-gray-500">الإعجابات</dt>
      <dd class="mt-2 text-3xl font-bold text-gray-900 tabular-nums"><%= number_with_delimiter(@total_likes) %></dd>
    </div>
    <div class="relative overflow-hidden rounded-2xl bg-white/60 backdrop-blur-sm px-5 py-6 shadow-sm ring-1 ring-gray-900/5">
      <div class="absolute -top-6 -left-6 h-24 w-24 rounded-full bg-amber-400/10 blur-2xl"></div>
      <dt class="text-sm font-medium text-gray-500">التعليقات</dt>
      <dd class="mt-2 text-3xl font-bold text-gray-900 tabular-nums"><%= number_with_delimiter(@total_comments) %></dd>
    </div>
  </div>

  <!-- Per-article table -->
  <div class="rounded-xl bg-white shadow-sm ring-1 ring-gray-900/5 overflow-hidden">
    <div class="px-6 py-5 border-b border-gray-100">
      <h2 class="text-lg font-semibold text-gray-900">أداء المقالات</h2>
      <p class="mt-1 text-sm text-gray-500"><%= @articles.size %> مقالة منشورة</p>
    </div>
    <div class="overflow-x-auto">
      <table class="min-w-full">
        <thead>
          <tr class="border-b border-gray-100">
            <th scope="col" class="px-6 py-3.5 text-right text-xs font-semibold text-gray-500">العنوان</th>
            <th scope="col" class="px-6 py-3.5 text-right text-xs font-semibold text-gray-500">تاريخ النشر</th>
            <th scope="col" class="px-6 py-3.5 text-right text-xs font-semibold text-gray-500">المشاهدات</th>
            <th scope="col" class="px-6 py-3.5 text-right text-xs font-semibold text-gray-500">الإعجابات</th>
            <th scope="col" class="px-6 py-3.5 text-right text-xs font-semibold text-gray-500">التعليقات</th>
          </tr>
        </thead>
        <tbody>
          <% @articles.each_with_index do |article, i| %>
            <tr class="group border-b border-gray-50 last:border-0 transition-colors hover:bg-gray-50/80 <%= "bg-orange-50/40" if @top_article && article == @top_article %>">
              <td class="px-6 py-4 max-w-xs">
                <div class="flex items-center gap-2">
                  <% if @top_article && article == @top_article %>
                    <span class="inline-flex items-center rounded-full bg-orange-100 px-2 py-0.5 text-[10px] font-medium text-orange-700 whitespace-nowrap">الأكثر مشاهدة</span>
                  <% end %>
                  <%= link_to article.title, user_article_path(slug: @user.slug, uuid: article.uuid),
                      class: "text-sm font-medium text-gray-900 group-hover:text-orange-600 transition-colors truncate block" %>
                </div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-400"><%= l(article.published_at.to_date, format: :long) %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-700 tabular-nums"><%= number_with_delimiter(article.real_views_count) %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-700 tabular-nums"><%= number_with_delimiter(article.likes_count) %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-700 tabular-nums"><%= number_with_delimiter(article.comments_count) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <% if @articles.empty? %>
      <div class="px-6 py-16 text-center">
        <p class="text-sm text-gray-400">لا توجد مقالات منشورة بعد</p>
      </div>
    <% end %>
  </div>
</div>
