<% title "#{@user.name}" %>
<% description @user.bio %>
<% profile_image = @user.avatar.attached? ? rails_blob_url(@user.avatar) : asset_url("brand/logo.png") %>
<% set_meta_tags og: {
  type: "profile",
  title: @user.name,
  description: @user.bio,
  image: profile_image,
  url: user_url(slug: @user.slug)
},
twitter: {
  image: profile_image
} %>
<%= json_ld_tag(profile_json_ld(@user)) %>

<%= render "shared/nav" %>

<div class="mx-auto max-w-3xl px-4 py-14 sm:px-6 lg:max-w-7xl lg:px-8" data-controller="page-view" data-page-view-viewable-type-value="User" data-page-view-viewable-id-value="<%= @user.id %>">
  <!-- Main 3 column grid -->
  <div class="grid grid-cols-1 items-start gap-1 lg:grid-cols-3">
    <!-- Right column -->
    <div class="mt-9 grid grid-cols-2 lg:col-span-2">
      <section aria-labelledby="section-1-title">
        <div class="p-6">
          <h2 class="text-2xl font-bold leading-7 text-gray-900 sm:text-3xl sm:tracking-tight"><%= @user.name %></h2>
        </div>
      </section>
      <div class="relative ml-auto col-end-4" data-controller="dropdown" data-action="click->dropdown#toggle click@window->dropdown#hide">
        <button type="button" class="block m-3.5 p-2.5 mt-2.5 text-gray-400 hover:text-gray-500" id="options-menu-2-button" aria-expanded="false"
          aria-haspopup="true">
          <span class="sr-only">Open options</span>
          <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path d="M3 10a1.5 1.5 0 113 0 1.5 1.5 0 01-3 0zM8.5 10a1.5 1.5 0 113 0 1.5 1.5 0 01-3 0zM15.5 8.5a1.5 1.5 0 100 3 1.5 1.5 0 000-3z" />
          </svg>
        </button>
        <div class="hidden ml-6 absolute left-0 z-50 w-28 origin-top-right rounded-md bg-white py-2 shadow-lg ring-1 ring-gray-900/5 focus:outline-none"
          role="menu" aria-orientation="vertical" aria-labelledby="options-menu-2-button" tabindex="-1" data-dropdown-target="menu">
          <% if policy(@user).edit? %>
            <%= link_to settings_user_settings_path, class: "block px-3 py-1 text-sm leading-6 text-gray-500 hover:text-gray-900",
              role: "menuitem", tabindex: "-1", id: "options-menu-2-item-0" do %>
              اعدادات الحساب<span class="sr-only">, Reform</span>
            <% end %>
            <%= link_to "الإحصائيات", user_stats_path(@user), class: "block px-3 py-1 text-sm leading-6 text-gray-500 hover:text-gray-900",
              role: "menuitem", tabindex: "-1", id: "options-menu-2-item-stats" %>
          <% end %>
          <div data-controller="clipboard" data-clipboard-success-content-value="تم نسخ الرابط">
            <input type="text" value="<%= user_url(@user) %>" class="hidden" data-clipboard-target="source" autocomplete="off">

            <button type="button" class="block px-3 py-1 text-sm leading-6 text-gray-500 hover:text-gray-900"
            data-action="clipboard#copy" data-clipboard-target="button">رابط الصفحة</button>
          </div>
        </div>
      </div>

      <section aria-labelledby="section-2-title" class="col-span-3">
        <div class="rounded-lg bg-white">
          <div class="p-6">
            <div class="self-start sticky top-0 z-20 bg-white">
              <div class="border-b border-gray-200">
                <nav class="-mb-px flex space-x-4 rtl:space-x-reverse" data-controller="user-profile-active-link" data-turbo-frame="feed" aria-label="Tabs">
                  <%= link_to "المنشورات", user_articles_path, data: { turbo_stream: "articles" },
                    class: "whitespace-nowrap border-b-2 text-lg py-4 px-1 font-medium", "data-user-profile-active-link-target": "link" %>
                  <% if policy(@user).drafts? %>
                    <%= link_to "المسودات", user_drafts_path, data: { turbo_stream: "articles" },
                      class: "whitespace-nowrap border-b-2 text-lg py-4 px-1 font-medium", "data-user-profile-active-link-target": "link" %>
                  <% end %>
                </nav>
              </div>
            </div>
            <div class="my-6 content-center space-y-14 lg:space-y-10">
              <%= turbo_frame_tag "articles", src: user_articles_path(format: "turbo_stream", page: params[:page]), loading: "lazy" do %>
              <% end %>

              <%= turbo_frame_tag "articles_pagination" %>
            </div>
          </div>
        </div>
      </section>
    </div>

    <!-- Left column -->
    <div class="grid my-6 grid-cols-1 gap-4 self-start sticky top-0">
      <section aria-labelledby="section-2-title">
        <h2 class="sr-only" id="section-2-title">اخترنا لك</h2>
        <div class="overflow-hidden rounded-lg bg-white">
          <div class="p-6">

            <div class="flex items-start justify-between">
              <div>
                <% if @user.avatar.attached? %>
                  <%= image_tag @user.avatar.variant(resize_to_fill: [600, 600]), class: "h-24 w-24 rounded-full bg-gray-50" %>
                <% else %>
                  <span class="inline-block h-24 w-24 overflow-hidden rounded-full bg-gray-100">
                    <svg class="h-full w-full text-gray-300" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M24 20.993V24H0v-2.996A14.977 14.977 0 0112.004 15c4.904 0 9.26 2.354 11.996 5.993zM16.002 8.999a4 4 0 11-8 0 4 4 0 018 0z" />
                    </svg>
                  </span>
                <% end %>
              </div>
              <% if Current.user && Current.user != @user %>
                <%= render "follows/user_button", user: @user, following: Current.user.following?(@user) %>
              <% end %>
            </div>
            <div class="mt-6">
              <h3 class="text-lg font-medium text-gray-900"><%= @user.name %></h3>
              <div class="mt-1">
                <%= render "follows/followers_count", user: @user %>
              </div>
              <p class="mt-3 text-sm text-gray-500"><%= @user.bio&.truncate(400) %></p>

              <% if @user.website_url.present? || @user.twitter_handle.present? || @user.instagram_handle.present? || @user.facebook_handle.present? %>
                <div class="mt-3 flex items-center gap-x-2">
                  <% if @user.website_url.present? %>
                    <%= link_to @user.website_url, target: "_blank", rel: "noopener noreferrer", class: "text-gray-400 hover:text-gray-600" do %>
                      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5a17.92 17.92 0 0 1-8.716-2.247m0 0A9.015 9.015 0 0 1 3 12c0-1.605.42-3.113 1.157-4.418" /></svg>
                    <% end %>
                  <% end %>
                  <% if @user.twitter_handle.present? %>
                    <%= link_to "https://x.com/#{@user.twitter_handle}", target: "_blank", rel: "noopener noreferrer", class: "text-gray-400 hover:text-gray-600" do %>
                      <svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" /></svg>
                    <% end %>
                  <% end %>
                  <% if @user.instagram_handle.present? %>
                    <%= link_to "https://instagram.com/#{@user.instagram_handle}", target: "_blank", rel: "noopener noreferrer", class: "text-gray-400 hover:text-gray-600" do %>
                      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><rect x="2" y="2" width="20" height="20" rx="5" /><circle cx="12" cy="12" r="5" /><circle cx="17.5" cy="6.5" r="1.5" /></svg>
                    <% end %>
                  <% end %>
                  <% if @user.facebook_handle.present? %>
                    <%= link_to "https://facebook.com/#{@user.facebook_handle}", target: "_blank", rel: "noopener noreferrer", class: "text-gray-400 hover:text-gray-600" do %>
                      <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 1.092.063 1.376.126v3.205c-.244-.023-.668-.034-.893-.034-1.269 0-1.757.483-1.757 1.736v2.525h3.504l-.756 3.667h-2.748v8.245A9.996 9.996 0 0 0 22 12.014C22 6.489 17.525 2 12.001 2S2 6.489 2 12.014a9.998 9.998 0 0 0 7.101 11.677z" /></svg>
                    <% end %>
                  <% end %>
                </div>
              <% end %>

              <% if Current.user == @user %>
                <div class="mt-6 flex flex-col gap-1 text-sm">
                  <div class="text-orange-400 hover:text-black">
                    <%= link_to "الإحصائيات", user_stats_path(@user) %>
                  </div>
                  <div class="text-orange-400 hover:text-black">
                    <%= link_to "اعدادات الحساب", settings_user_settings_path %>
                  </div>
                </div>
              <% end %>
            </div>

          </div>
        </div>
      </section>

      <%= render "shared/footer" %>
    </div>
  </div>
</div>
