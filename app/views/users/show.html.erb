<%= render "shared/nav" %>

<div class="mx-auto max-w-3xl px-4 py-14 sm:px-6 lg:max-w-7xl lg:px-8">
  <h1 class="sr-only">Page title</h1>
  <!-- Main 3 column grid -->
  <div class="grid grid-cols-1 items-start gap-1 lg:grid-cols-3">
    <!-- Right column -->
    <div class="mt-9 grid grid-cols-2 lg:col-span-2">
      <section aria-labelledby="section-1-title">
        <h2 class="sr-only" id="section-1-title">Section title</h2>
        <div class="rounded-lg bg-white">
          <div class="p-6">
            <h2 class="text-2xl font-bold leading-7 text-gray-900 sm:truncate sm:text-3xl sm:tracking-tight"><%= @user.name %></h2>
          </div>
        </div>
      </section>
      <div class="relative ml-auto col-end-4" data-controller="dropdown" data-action="click->dropdown#toggle click@window->dropdown#hide">
        <button type="button" class="block m-3.5 p-2.5 mt-2.5 text-gray-400 hover:text-gray-500" id="options-menu-2-button" aria-expanded="false"
          aria-haspopup="true">
          <span class="sr-only">Open options</span>
          <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path d="M3 10a1.5 1.5 0 113 0 1.5 1.5 0 01-3 0zM8.5 10a1.5 1.5 0 113 0 1.5 1.5 0 01-3 0zM15.5 8.5a1.5 1.5 0 100 3 1.5 1.5 0 000-3z" />
          </svg>
        </button>
        <div class="hidden ml-6 absolute left-0 z-50 w-24 origin-top-right rounded-md bg-white py-2 shadow-lg ring-1 ring-gray-900/5 focus:outline-none"
          role="menu" aria-orientation="vertical" aria-labelledby="options-menu-2-button" tabindex="-1" data-dropdown-target="menu">
          <% if Current.user == @user %>
            <a href="#" class="block px-3 py-1 text-sm leading-6 text-gray-500 hover:text-gray-900" role="menuitem" tabindex="-1" id="options-menu-2-item-0">تعديل الحساب<span class="sr-only">, Reform</span></a>
          <% end %>
          <a href="#" class="block px-3 py-1 text-sm leading-6 text-gray-500 hover:text-gray-900" role="menuitem" tabindex="-1" id="options-menu-2-item-0">رابط الصفحة<span class="sr-only">, Reform</span></a>
        </div>
      </div>

      <section aria-labelledby="section-2-title" class="col-span-3">
        <h2 class="sr-only" id="section-2-title">Section title</h2>
        <div class="rounded-lg bg-white">
          <div class="p-6">
            <div class="self-start sticky top-0 z-40 bg-white">
              <div class="hidden sm:block">
                <div class="border-b border-gray-200">
                  <nav class="-mb-px flex space-x-4 rtl:space-x-reverse" aria-label="Tabs">
                    <!-- Current: "border-indigo-500 text-indigo-600", Default: "border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700" -->
                    <span class="whitespace-nowrap border-b-2 border-black text-lg py-4 px-1 font-medium">
                      المنشورات
                    </span>
                  </nav>
                </div>
              </div>
            </div>
            <div class="my-6 content-center space-y-14 lg:space-y-10">
              <%= turbo_frame_tag "articles", src: user_articles_path(format: "turbo_stream", page: params[:page]), loading: "lazy" do %>
              <% end %>

              <%= turbo_frame_tag "articles_pagination" %>
            </div>
          </div>
        </div>
      </section>
    </div>

    <!-- Left column -->
    <div class="grid my-6 grid-cols-1 gap-4 self-start sticky top-0">
      <section aria-labelledby="section-2-title">
        <h2 class="sr-only" id="section-2-title">اخترنا لك</h2>
        <div class="overflow-hidden rounded-lg bg-white">
          <div class="p-6">

            <div class="flex items-center gap-x-4">
              <% if @user.avatar.attached? %>
                <%= image_tag @user.avatar.url(:thumb), class: "h-24 w-24 rounded-full bg-gray-50" %>
              <% else %>
                <span class="inline-block h-24 w-24 overflow-hidden rounded-full bg-gray-100">
                  <svg class="h-full w-full text-gray-300" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M24 20.993V24H0v-2.996A14.977 14.977 0 0112.004 15c4.904 0 9.26 2.354 11.996 5.993zM16.002 8.999a4 4 0 11-8 0 4 4 0 018 0z" />
                  </svg>
                </span>
              <% end %>
            </div>
            <div class="mt-6">
              <h3 class="text-lg font-medium text-gray-900"><%= @user.name %></h3>
              <p class="mt-2 text-sm text-gray-500"><%= @user.bio&.truncate(400) %></p>

              <% if Current.user == @user %>
                <div class="mt-6 text-sm text-blue-400 hover:text-black">
                  <%= link_to "تعديل الحساب", user_settings_path %>
                </div>
              <% end %>
            </div>

          </div>
        </div>
      </section>

      <%= render "shared/footer" %>
    </div>
  </div>
</div>
