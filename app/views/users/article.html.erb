<% title "#{@article.title || @article.alternative_titles.first&.truncate(20)} بقلم #{@user.name}" %>
<% description @article.description&.truncate(160) %>
<% set_meta_tags og: {
  type: "article",
  title: @article.title,
  description: @article.description&.truncate(160),
  image: article_cover(@article) || asset_url("brand/logo.png"),
  url: user_article_url(slug: @article.user, uuid: @article)
},
article: {
  published_time: @article.published_at&.iso8601,
  author: @user.name
},
twitter: {
  image: article_cover(@article) || asset_url("brand/logo.png")
} %>
<%= json_ld_tag(article_json_ld(@article, @user)) %>

<%= render "shared/nav" %>

<div class="bg-white px-6 py-32 lg:px-8" data-controller="drawer page-view report" data-page-view-viewable-type-value="Article" data-page-view-viewable-id-value="<%= @article.id %>">
  <div class="mx-auto max-w-3xl text-base leading-7 text-gray-700">
    <h1 class="mt-2 text-3xl font-bold leading-snug text-gray-900 sm:text-4xl [text-wrap:balance]"><%= @article.title %></h1>

    <div class="mt-8 flex items-center gap-3">
      <%= link_to user_path(@article.user), class: "shrink-0", data: { turbo: false }, aria: { hidden: true }, tabindex: -1 do %>
        <% if @user.avatar.attached? %>
          <%= image_tag @user.avatar.variant(resize_to_fill: [96, 96]), alt: "", class: "h-11 w-11 rounded-full bg-gray-50 ring-1 ring-gray-900/5" %>
        <% else %>
          <span class="inline-flex h-11 w-11 items-center justify-center rounded-full bg-orange-50 text-base font-medium text-orange-700">
            <%= @user.name.to_s.first %>
          </span>
        <% end %>
      <% end %>
      <div class="min-w-0">
        <p class="truncate text-sm font-medium text-gray-900">
          <%= link_to @article.user.name, user_path(@article.user), data: { turbo: false },
                      class: "hover:underline hover:underline-offset-4" %>
        </p>
        <p class="mt-0.5 text-sm text-gray-500">
          <% published = @article.published_at || @article.created_at %>
          <time datetime="<%= published.iso8601 %>"><%= short_date(published) %></time>
          <% if @article.reading_time_minutes.present? %>
            <span class="mx-1.5" aria-hidden="true">·</span>
            <span><%= reading_time_label(@article.reading_time_minutes) %></span>
          <% end %>
        </p>
      </div>
    </div>

    <% if @article.tags.any? %>
      <div class="mt-6 flex flex-wrap gap-2">
        <%= render partial: "tags/tag", collection: @article.tags, as: :tag %>
      </div>
    <% end %>

    <div class="mt-8 flex items-center justify-between border-y border-gray-100 py-1.5">
      <%# Likes & Comments (right side in RTL) %>
      <div class="-mr-2 flex items-center gap-1">
        <%= render "article_likes/button", article: @article, liked: @liked %>
        <button type="button" data-action="drawer#open" class="article-action" aria-label="التعليقات">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 20.25c4.97 0 9-3.694 9-8.25s-4.03-8.25-9-8.25S3 7.444 3 12c0 2.104.859 4.023 2.273 5.48.432.447.74 1.04.586 1.641a4.483 4.483 0 01-.923 1.785A5.969 5.969 0 006 21c1.282 0 2.47-.402 3.445-1.087.81.22 1.668.337 2.555.337z" />
          </svg>
          <span id="comments_count" class="text-sm tabular-nums"><%= @article.comments_count if @article.comments_count.positive? %></span>
        </button>
      </div>

      <%# Bookmark & Share & Options (left side in RTL) %>
      <div class="-ml-2 flex items-center gap-1 [&>turbo-frame]:flex [&>turbo-frame]:items-center">
        <%= render "bookmarks/button", article: @article, bookmarked: @bookmarked %>
        <%# Share dropdown %>
        <div data-controller="dropdown" class="relative">
          <button type="button" class="article-action"
            data-action="click->dropdown#toggle click@window->dropdown#hide">
            <span class="sr-only">مشاركة</span>
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
            </svg>
          </button>
          <div class="hidden absolute left-0 z-50 w-48 mt-2 py-1 rounded-lg bg-white shadow-lg ring-1 ring-gray-900/5 focus:outline-none"
               role="menu" data-dropdown-target="menu">
            <div data-controller="clipboard" data-clipboard-success-content-value="تم نسخ الرابط ✓">
              <input type="text" value="<%= user_article_url(slug: @user, uuid: @article) %>" class="hidden" data-clipboard-target="source" autocomplete="off">
              <button type="button" class="flex items-center gap-2 w-full px-3 py-2 text-sm text-gray-600 hover:bg-gray-50 hover:text-gray-900 transition-colors"
              data-action="clipboard#copy" data-clipboard-target="button" role="menuitem">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75a1.125 1.125 0 01-1.125-1.125V7.875c0-.621.504-1.125 1.125-1.125H6.75a9.06 9.06 0 011.5.124m7.5 10.376h3.375c.621 0 1.125-.504 1.125-1.125V11.25c0-4.46-3.243-8.161-7.5-8.876a9.06 9.06 0 00-1.5-.124H9.375c-.621 0-1.125.504-1.125 1.125v3.5m7.5 10.375H9.375a1.125 1.125 0 01-1.125-1.125v-9.25m12 6.625v-1.875a3.375 3.375 0 00-3.375-3.375h-1.5a1.125 1.125 0 01-1.125-1.125v-1.5a3.375 3.375 0 00-3.375-3.375H9.75" />
                </svg>
                نسخ الرابط
              </button>
            </div>
            <a href="https://x.com/intent/tweet?url=<%= CGI.escape(user_article_url(slug: @user, uuid: @article)) %>&text=<%= CGI.escape(@article.title.to_s) %>" target="_blank" rel="noopener"
               class="flex items-center gap-2 w-full px-3 py-2 text-sm text-gray-600 hover:bg-gray-50 hover:text-gray-900 transition-colors" role="menuitem">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
              </svg>
              مشاركة على X
            </a>
            <a href="https://www.facebook.com/sharer/sharer.php?u=<%= CGI.escape(user_article_url(slug: @user, uuid: @article)) %>" target="_blank" rel="noopener"
               class="flex items-center gap-2 w-full px-3 py-2 text-sm text-gray-600 hover:bg-gray-50 hover:text-gray-900 transition-colors" role="menuitem">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" />
              </svg>
              مشاركة على فيسبوك
            </a>
          </div>
        </div>

        <%# Options dropdown (... at far end, like Medium) %>
        <% if policy(@article).edit? %>
          <div data-controller="dropdown modal" class="relative">
            <button type="button" class="article-action"
              data-action="click->dropdown#toggle click@window->dropdown#hide">
              <span class="sr-only">خيارات</span>
              <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="5" cy="12" r="1.5" />
                <circle cx="12" cy="12" r="1.5" />
                <circle cx="19" cy="12" r="1.5" />
              </svg>
            </button>
            <div class="hidden absolute left-0 z-50 w-40 mt-2 py-1 rounded-lg bg-white shadow-lg ring-1 ring-gray-900/5 focus:outline-none"
                role="menu" data-dropdown-target="menu">
              <button type="button" class="flex items-center gap-2 w-full px-3 py-2 text-sm text-gray-600 hover:bg-gray-50 hover:text-gray-900 cursor-pointer transition-colors"
                role="menuitem" data-action="modal#open">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" />
                </svg>
                إحصائيات
              </button>
              <%= link_to user_edit_article_path(slug: @user, uuid: @article),
                class: "flex items-center gap-2 w-full px-3 py-2 text-sm text-gray-600 hover:bg-gray-50 hover:text-gray-900 transition-colors", role: "menuitem", data: { turbo: false } do %>
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" />
                </svg>
                تعديل
              <% end %>
              <%= button_to user_destroy_article_path(slug: @user, uuid: @article), method: :delete,
                class: "flex items-center gap-2 w-full px-3 py-2 text-sm text-red-500 hover:bg-red-50 hover:text-red-700 transition-colors", role: "menuitem", data: { turbo: false } do %>
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
                </svg>
                حذف
              <% end %>
              <% if @article.user != current_user %>
                <button type="button" class="flex items-center gap-2 w-full px-3 py-2 text-sm text-gray-600 hover:bg-gray-50 hover:text-gray-900 cursor-pointer transition-colors"
                  role="menuitem" data-action="report#open"
                  data-report-type-param="Article" data-report-id-param="<%= @article.uuid %>"
                  data-report-title-param="الإبلاغ عن الموضوع">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 3v1.5M3 21v-6m0 0 2.77-.693a9 9 0 0 1 6.208.682l.108.054a9 9 0 0 0 6.086.71l3.114-.732a48.524 48.524 0 0 1-.005-10.499l-3.11.732a9 9 0 0 1-6.085-.711l-.108-.054a9 9 0 0 0-6.208-.682L3 4.5M3 15V4.5" />
                  </svg>
                  إبلاغ
                </button>
              <% end %>
            </div>
            <%= render "articles/analytics", article: @article, likers: @likers || [], commenters: @commenters || [] %>
          </div>
        <% elsif authenticated? %>
          <div data-controller="dropdown" class="relative">
            <button type="button" class="article-action"
              data-action="click->dropdown#toggle click@window->dropdown#hide">
              <span class="sr-only">خيارات</span>
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="5" cy="12" r="1.5" />
                <circle cx="12" cy="12" r="1.5" />
                <circle cx="19" cy="12" r="1.5" />
              </svg>
            </button>
            <div class="hidden absolute left-0 z-50 w-44 mt-2 py-1 rounded-lg bg-white shadow-lg ring-1 ring-gray-900/5 focus:outline-none"
                role="menu" data-dropdown-target="menu">
              <button type="button" class="flex items-center gap-2 w-full px-3 py-2 text-sm text-gray-600 hover:bg-gray-50 hover:text-gray-900 cursor-pointer transition-colors"
                role="menuitem" data-action="report#open"
                data-report-type-param="Article" data-report-id-param="<%= @article.uuid %>"
                data-report-title-param="الإبلاغ عن الموضوع">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 3v1.5M3 21v-6m0 0 2.77-.693a9 9 0 0 1 6.208.682l.108.054a9 9 0 0 0 6.086.71l3.114-.732a48.524 48.524 0 0 1-.005-10.499l-3.11.732a9 9 0 0 1-6.085-.711l-.108-.054a9 9 0 0 0-6.208-.682L3 4.5M3 15V4.5" />
                </svg>
                الإبلاغ عن الموضوع
              </button>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <div class="article-content mt-4" dir="rtl" data-controller="tweet-embed" data-page-view-target="content">
      <%= sanitize @article.content_html,
        tags: %w[p h1 h2 h3 blockquote a img iframe figure figcaption hr div span br strong em u s code pre],
        attributes: %w[href src class data-tweet-id frameborder allowfullscreen alt title dir style target rel width height] %>
    </div>

  </div>

  <% if @related_articles&.any? || @author_articles&.any? %>
    <div class="mx-auto max-w-4xl mt-16 border-t border-gray-200 pt-10 px-6">
      <% if @related_articles&.any? %>
        <h2 class="text-xl font-bold text-gray-900 mb-6">مقالات ذات صلة</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
          <%= render partial: "articles/suggestion_card", collection: @related_articles, as: :article %>
        </div>
      <% end %>

      <% if @author_articles&.any? %>
        <h2 class="text-xl font-bold text-gray-900 mb-6 <%= "mt-14 border-t border-gray-200 pt-10" if @related_articles&.any? %>">المزيد من <%= @user.name %></h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
          <%= render partial: "articles/suggestion_card", collection: @author_articles, as: :article %>
        </div>
      <% end %>
    </div>
  <% end %>

  <% if authenticated? %>
    <%= render "reports/dialog" %>
  <% end %>

  <%# Comments Drawer %>
  <div class="hidden relative z-50" data-drawer-target="container" data-action="keydown@window->drawer#escape" role="dialog" aria-modal="true" aria-label="التعليقات">
  <%# Backdrop %>
  <div class="fixed inset-0 bg-gray-500/75 transition-opacity duration-500 ease-in-out opacity-0" data-drawer-target="overlay"></div>

  <div class="fixed inset-0 overflow-hidden">
    <div class="absolute inset-0 overflow-hidden" data-action="click->drawer#outside">
      <div class="pointer-events-none fixed inset-y-0 left-0 flex max-w-full pr-10">
        <%# Panel %>
        <div class="pointer-events-auto relative w-screen max-w-md transform transition ease-in-out duration-500 -translate-x-full" data-drawer-target="panel">
          <%# Close button %>
          <div class="absolute right-0 top-0 -mr-8 flex pl-2 pt-4 sm:-mr-10 sm:pl-4 transition-opacity duration-500 ease-in-out opacity-0" data-drawer-target="closeButton">
            <button type="button" class="relative rounded-md text-gray-300 hover:text-white focus:outline-none focus:ring-2 focus:ring-white cursor-pointer" data-action="drawer#close">
              <span class="absolute -inset-2.5"></span>
              <span class="sr-only">إغلاق</span>
              <svg class="size-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
              </svg>
            </button>
          </div>

          <div class="flex h-full flex-col bg-white shadow-xl">
            <%# Header %>
            <div class="border-b border-gray-200 px-4 py-4 sm:px-6">
              <h2 class="text-base font-semibold text-gray-900">
                التعليقات (<span id="drawer_comments_count"><%= @article.comments_count %></span>)
              </h2>
            </div>

            <%# Comments list %>
            <div class="relative flex-1 overflow-y-auto px-4 sm:px-6 py-2">
              <div id="comments" class="divide-y divide-gray-100">
                <%= render @comments %>
              </div>
            </div>

            <%# Comment form (sticky footer) %>
            <% if !@article.comments_enabled? %>
              <div class="border-t border-gray-200 px-4 py-4 sm:px-6">
                <p id="comments_closed" class="text-sm text-gray-400 text-center">التعليقات مغلقة على هذا الموضوع</p>
              </div>
            <% elsif authenticated? %>
              <div class="border-t border-gray-200 px-4 py-4 sm:px-6">
                <%= render "comments/form" %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
  </div>
</div>

<%= render "shared/footer" %>
