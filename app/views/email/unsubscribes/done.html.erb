<% title "نميم - تم إلغاء الاشتراك" %>
<% label = Email::Categories::ALL.dig(@category, :label) %>

<div class="mx-auto max-w-md px-6 py-32 text-center" role="status">
  <h1 class="text-2xl font-bold text-gray-900">تم إلغاء الاشتراك</h1>
  <p class="mt-3 text-gray-600">لن تصلك رسائل «<%= label %>» بعد الآن. يمكنك إعادة تفعيلها في أي وقت من إعدادات البريد.</p>
  <p class="mt-8 text-sm">
    <%= link_to "إعدادات البريد", settings_notifications_path, class: "text-gray-900 underline underline-offset-4" %>
    <span class="mx-2 text-gray-300" aria-hidden="true">·</span>
    <%= link_to "العودة إلى نميم", root_path, class: "text-gray-900 underline underline-offset-4" %>
  </p>
</div>
