<% title "نميم - إلغاء الاشتراك" %>
<% label = Email::Categories::ALL.dig(@category, :label) %>

<div class="mx-auto max-w-md px-6 py-32 text-center">
  <h1 class="text-2xl font-bold text-gray-900">إلغاء الاشتراك</h1>
  <p class="mt-3 text-gray-600">لن تصلك رسائل «<%= label %>» على <bdi dir="ltr"><%= @user.email %></bdi> بعد الآن.</p>

  <%= form_with url: email_unsubscribe_path, method: :post, class: "mt-8" do %>
    <%= hidden_field_tag :token, params[:token] %>
    <%= submit_tag "إلغاء الاشتراك",
          class: "cursor-pointer rounded-full bg-gray-900 px-6 py-2.5 text-sm font-semibold text-white transition-[transform,background-color] duration-150 hover:bg-gray-800 active:scale-[0.97]" %>
  <% end %>

  <p class="mt-6 text-sm text-gray-500">
    تريد التحكم في كل الرسائل؟ <%= link_to "إعدادات البريد", settings_notifications_path, class: "underline underline-offset-4 hover:text-gray-900" %>
  </p>
</div>
