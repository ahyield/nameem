<div role="email" aria-roledescription="email" aria-label="ملخص الإشعارات من نميم" lang="ar">
  <div class="bg-white pt-20 sm:px-4 font-sans" dir="rtl">
    <table align="center" cellpadding="0" cellspacing="0" role="none">
      <tr>
        <td class="w-[552px] max-w-full">
          <div class="my-12 sm:my-8 text-center">
            <a href="https://nameem.com">
              <%= image_tag attachments["logo.png"].url, width: "70", alt: "نميم" %>
            </a>
          </div>

          <table class="w-full" cellpadding="0" cellspacing="0" role="none">
            <tr>
              <td class="p-12 sm:px-6 text-base text-slate-700 bg-white rounded shadow text-center">
                <h1 class="m-0 mb-6 text-2xl sm:leading-8 text-black font-semibold">
                  لديك <%= @notifications.size %> إشعارات جديدة
                </h1>

                <table class="w-full text-right" cellpadding="0" cellspacing="0">
                  <% @notifications.each do |notification| %>
                    <tr>
                      <td class="py-3 border-b border-slate-100">
                        <p class="m-0 text-sm text-slate-700">
                          <strong><%= notification.actor.name %></strong>
                          <%= notification_message(notification) %>
                        </p>
                        <% if notification.notifiable_type == "Article" %>
                          <p class="m-0 mt-1 text-sm text-orange-600"><%= notification.notifiable.title %></p>
                        <% elsif notification.notifiable.respond_to?(:article) %>
                          <p class="m-0 mt-1 text-sm text-orange-600"><%= notification.notifiable.article.title %></p>
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                </table>

                <div role="separator" style="line-height: 24px">&zwj;</div>

                <a href="<%= notifications_url %>" style="display: inline-block; padding: 12px 24px; background-color: #3b82f6; color: #ffffff; text-decoration: none; border-radius: 6px; font-weight: 600;">
                  عرض جميع الإشعارات
                </a>

                <div role="separator" class="false bg-slate-200" style="height: 1px; line-height: 1px; margin: 0; margin-top: 32px; margin-bottom: 32px">&zwj;</div>
                <p class="m-0 text-xs text-slate-400">
                  لإيقاف هذه الرسائل، قم بتعطيل إشعارات البريد الإلكتروني من
                  <a href="<%= settings_notifications_url %>" class="text-indigo-700">إعدادات الإشعارات</a>
                </p>
              </td>
            </tr>
            <tr role="separator">
              <td class="leading-12">&zwj;</td>
            </tr>
            <tr>
              <td class="text-center text-slate-600 text-xs px-6">
                <p class="m-0 mb-4 uppercase font">
                  نميم
                </p>

                <p class="cursor-default">
                  <a href="mailto:support@nameem.com" class="text-indigo-700 [text-decoration:none] hover:![text-decoration:underline]">الدعم</a>
                  &bull;
                  <a href="https://twitter.com/nameemofficial" class="text-indigo-700 [text-decoration:none] hover:![text-decoration:underline]">Twitter</a>
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </div>
</div>
