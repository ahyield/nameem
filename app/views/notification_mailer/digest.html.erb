<% content_for :title, "إشعاراتك على نميم" %>
<% content_for :preheader, @notifications.first(2).map { |n| "#{notification_actor_name(n)} #{notification_message(n)}" }.join(" · ") %>

<h1 class="h1">ما فاتك على نميم</h1>

<% @notifications.each do |notification| %>
  <div class="item">
    <p style="margin: 0;">
      <strong style="color: #111827;"><%= notification_actor_name(notification) %></strong>
      <%= notification_message(notification) %>
    </p>
    <% if (article = notification_article(notification)) %>
      <p class="muted small" style="margin: 4px 0 0;">
        <%= link_to article.title.presence || "بدون عنوان", user_article_url(slug: article.user, uuid: article), class: "link" %>
      </p>
    <% end %>
  </div>
<% end %>

<p style="margin-top: 28px; text-align: center;">
  <%= link_to "عرض كل الإشعارات", notifications_url, class: "button" %>
</p>
