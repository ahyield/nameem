<% digest = NotificationDigest.new(@notifications, self) %>
<% groups = digest.groups %>
<% content_for :title, "ما فاتك على نميم" %>
<% content_for :preheader, groups.first(2).map { |group| "#{email_actor_names(group)}: #{group.label}" }.join(" · ") %>

<p class="eyebrow">ملخص اليوم</p>
<h1 class="masthead-title">ما فاتك على نميم</h1>
<% if (summary = digest.summary).present? %>
  <p style="margin: 0 0 20px;"><span class="summary"><%= summary %></span></p>
<% end %>

<table width="100%" cellpadding="0" cellspacing="0" role="presentation">
  <% groups.each do |group| %>
    <tr>
      <td class="activity" style="width: 40px;">
        <%= render "mailer/avatar", name: group.actors.first&.name, team: group.moderation? %>
      </td>
      <td class="activity" style="padding-right: 12px;">
        <p style="margin: 0; font-size: 15px; line-height: 1.6;">
          <strong style="color: #111827;"><%= email_actor_names(group) %></strong>
        </p>
        <span class="label"><%= group.label %></span>
        <% if group.article %>
          <p style="margin: 2px 0 0;">
            <%= link_to (group.article.title.presence || "بدون عنوان").truncate(70),
                        article_link_url(group.article), class: "story-title", style: "font-size: 15px;" %>
          </p>
        <% end %>
        <% if group.comment %>
          <p class="quote excerpt"><%= group.comment.body.to_plain_text.squish.truncate(160) %></p>
        <% end %>
        <p class="meta" style="margin-top: 4px !important;">منذ <%= time_ago_in_words(group.latest.created_at) %></p>
      </td>
    </tr>
  <% end %>
</table>

<p style="margin: 28px 0 0; text-align: center;">
  <%= link_to "عرض كل الإشعارات", notifications_url, class: "button" %>
</p>
