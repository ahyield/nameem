<% heading = @notification.featured? ? "مُيِّز موضوعك" : "اختار المحررون موضوعك" %>
<% article_url = user_article_url(slug: @article.user, uuid: @article) %>
<% content_for :title, heading %>
<% content_for :preheader, "«#{@article.title}» #{@notification.featured? ? 'يظهر الآن في الصفحة الرئيسية' : 'ضمن اختيارات المحررين'}." %>

<p class="eyebrow"><%= @notification.featured? ? "موضوع مميز" : "اختيارات المحررين" %></p>
<h1 class="masthead-title"><%= heading %></h1>

<% if (cover = email_cover_url(@article, [992, 558])) %>
  <p style="margin: 8px 0 16px;"><a href="<%= article_url %>"><img src="<%= cover %>" class="lead-image" width="496" height="279" alt=""></a></p>
<% end %>

<p style="margin-bottom: 4px;"><a href="<%= article_url %>" class="lead-title"><%= @article.title.presence || "بدون عنوان" %></a></p>
<p>
  <%= @notification.featured? ? "يظهر موضوعك الآن ضمن المواضيع المميزة في الصفحة الرئيسية لنميم." : "أصبح موضوعك ضمن اختيارات المحررين، وسيصل إلى قرّاء أكثر." %>
  شكراً لأنك تكتب على نميم. شارك الرابط مع من تحب.
</p>

<p style="margin: 28px 0 0; text-align: center;">
  <%= link_to "شاهد موضوعك", article_url, class: "button" %>
</p>
