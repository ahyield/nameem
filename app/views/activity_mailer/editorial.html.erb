<% heading = @notification.featured? ? "مُيِّز موضوعك" : "اختار المحررون موضوعك" %>
<% content_for :title, heading %>
<% content_for :preheader, "«#{@article.title}» #{@notification.featured? ? 'يظهر الآن في الصفحة الرئيسية' : 'ضمن اختيارات المحررين'}." %>

<h1 class="h1"><%= heading %></h1>
<p>
  <%= link_to @article.title.presence || "بدون عنوان", user_article_url(slug: @article.user, uuid: @article), class: "link" %>
  <%= @notification.featured? ? "يظهر الآن ضمن المواضيع المميزة في الصفحة الرئيسية لنميم." : "أصبح ضمن اختيارات المحررين، وسيصل إلى قرّاء أكثر." %>
</p>
<p>شكراً لأنك تكتب على نميم. شارك الرابط مع من تحب.</p>

<p style="margin: 28px 0 0; text-align: center;">
  <%= link_to "شاهد موضوعك", user_article_url(slug: @article.user, uuid: @article), class: "button" %>
</p>
