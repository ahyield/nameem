<%# One dialog for the article and its comments; report_controller fills in the reported item %>
<dialog data-report-target="dialog" data-action="click->report#backdrop keydown->report#keydown"
        aria-labelledby="report_dialog_title"
        class="w-full max-w-md rounded-xl p-0 shadow-xl backdrop:bg-gray-500/75">
  <div class="flex items-center justify-between border-b border-gray-200 px-6 py-4">
    <h2 id="report_dialog_title" class="text-base font-semibold text-gray-900" data-report-target="title"></h2>
    <button type="button" class="text-gray-400 hover:text-gray-500 cursor-pointer" data-action="report#close">
      <span class="sr-only">إغلاق</span>
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <div class="px-6 py-5">
    <%= form_with url: reports_path, data: { report_target: "form", action: "turbo:submit-end->report#submitted" } do |f| %>
      <%= hidden_field_tag :reportable_type, nil, data: { report_target: "type" } %>
      <%= hidden_field_tag :reportable_id, nil, data: { report_target: "id" } %>

      <fieldset>
        <legend class="mb-3 text-sm text-gray-500">ما المشكلة في هذا المحتوى؟</legend>
        <div class="space-y-2">
          <% Report::REASONS.each do |value, label| %>
            <label class="flex items-center gap-3 cursor-pointer text-sm text-gray-700">
              <%= radio_button_tag "report[reason]", value, false, required: true,
                                   class: "h-4 w-4 border-gray-300 text-gray-900 focus:ring-orange-500" %>
              <%= label %>
            </label>
          <% end %>
        </div>
      </fieldset>

      <%= text_area_tag "report[details]", nil, rows: 3, maxlength: 500,
                        placeholder: "تفاصيل إضافية (مطلوبة عند اختيار سبب آخر)",
                        class: "mt-4 block w-full rounded-lg border-0 bg-gray-50 px-3 py-2 text-sm text-gray-900 placeholder:text-gray-400 focus:bg-white focus:ring-2 focus:ring-inset focus:ring-orange-500 resize-none" %>

      <div class="mt-5 flex justify-end">
        <%= f.submit "إرسال البلاغ", class: "rounded-full bg-gray-900 px-5 py-2 text-sm font-semibold text-white hover:bg-gray-800 cursor-pointer transition-colors" %>
      </div>
    <% end %>

    <div id="report_result" data-report-target="result"></div>
  </div>
</dialog>
