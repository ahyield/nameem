<%# The light/dark choice as a row of three icons, for inside a menu. Choosing keeps the menu open so the change is seen. %>
<div class="flex items-center justify-between gap-3 <%= local_assigns[:class] %>" data-controller="theme" data-theme-url-value="<%= theme_path %>">
  <span id="theme-switch-label-<%= local_assigns[:id] %>" class="text-sm text-gray-500">المظهر</span>
  <div class="flex rounded-full bg-gray-100 p-0.5" role="radiogroup" aria-labelledby="theme-switch-label-<%= local_assigns[:id] %>">
    <% { "light" => ["فاتح", "M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"],
         "dark" => ["داكن", "M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z"],
         "system" => ["تلقائي", "M9 17.25v1.007a3 3 0 0 1-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0 1 15 18.257V17.25m6-12V15a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 15V5.25m18 0A2.25 2.25 0 0 0 18.75 3H5.25A2.25 2.25 0 0 0 3 5.25m18 0V12a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 12V5.25"] }.each do |theme, (label, icon)| %>
      <button type="button" role="radio" aria-checked="<%= current_theme == theme %>" aria-label="<%= label %>" title="<%= label %>"
              data-theme="<%= theme %>" data-theme-target="option" data-action="click->theme#choose:stop"
              class="flex h-7 w-7 items-center justify-center rounded-full text-gray-400 transition-[transform,background-color,color] duration-150 hover:text-gray-700 active:scale-95 aria-checked:bg-surface dark:aria-checked:bg-gray-300 aria-checked:text-gray-900 aria-checked:shadow-sm">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="<%= icon %>" />
        </svg>
      </button>
    <% end %>
  </div>
</div>
