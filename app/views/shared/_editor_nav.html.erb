<nav class="bg-slate border border-solid border-b-1 border-slate-100">
  <div class="max-w-7xl lg:w-10/12 2xl:w-3/4 mx-auto px-2 sm:px-6 lg:px-8">
    <div class="relative flex h-16 items-center justify-between">
      <div class="flex flex-1 items-center justify-center sm:items-stretch sm:justify-start">
        <div class="flex flex-shrink-0 items-center rtl:ml-3">
          <a href="/">
            <img class="h-8 w-auto" src="<%= asset_path("brand/logo.png") %>" alt="نميم">
          </a>
        </div>
      </div>
      <div class="absolute inset-y-0 right-0 flex items-center pr-2 sm:static sm:inset-auto sm:ml-6 sm:pr-0">
        <span id="save-status" class="text-sm text-gray-400 ml-3"></span>
        <%= button_to user_publish_modal_path(uuid: params[:uuid] || "", slug: params[:slug] || current_user || ""),
          form: { id: "publish-form-btn" }, data: { turbo_frame: "modal"}, class: "btn-publish-disabled relative h-8 px-6 m-2 text-lg text-white bg-gradient-to-l from-amber-400 to-orange-500
                                                                                   hover:from-amber-500 hover:to-orange-600 rounded-full focus:outline-none focus:ring-0", method: :get do %>
          <span class="absolute -inset-1.5"></span>
          <span class="btn-publish-text">نشر</span>
        <% end %>

        <!-- Profile dropdown -->
        <div class="relative rtl:mr-3" data-controller="dropdown"
               data-action="click->dropdown#toggle click@window->dropdown#hide">
          <div>
            <button type="button" class="relative flex rounded-full bg-gray-800 text-sm focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-gray-800"
              tabindex="0" id="dropdown-button" aria-expanded="false" aria-haspopup="true">
              <span class="absolute -inset-1.5"></span>
              <span class="sr-only">Open user menu</span>
              <% if Current.user.avatar.attached? %>
                <%= image_tag Current.user.avatar.variant(resize_to_fill: [100, 100]), class: "h-8 w-8 rounded-full" %>
              <% else %>
                  <span class="inline-block h-8 w-8 overflow-hidden rounded-full bg-gray-100">
                  <svg class="h-full w-full text-gray-300" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M24 20.993V24H0v-2.996A14.977 14.977 0 0112.004 15c4.904 0 9.26 2.354 11.996 5.993zM16.002 8.999a4 4 0 11-8 0 4 4 0 018 0z" />
                  </svg>
              <% end %>
            </button>
          </div>

          <div data-dropdown-target="menu"
               data-transition-enter="transition ease-out duration-200"
               data-transition-enter-from="opacity-0 translate-y-1"
               data-transition-enter-to="opacity-100 translate-y-0"
               data-transition-leave="transition ease-in duration-150"
               data-transition-leave-from="opacity-100 translate-y-0"
               data-transition-leave-to="opacity-0 translate-y-1"
               class="absolute hidden right-0 z-10 mt-2 w-40 origin-top-right rounded-md bg-white py-1 shadow-lg ring-1 ring-black ring-opacity-5 focus:outline-none"
               role="menu" aria-orientation="vertical" aria-labelledby="user-menu-button">
            <!-- Active: "bg-gray-100", Not Active: "" -->
            <%= link_to user_path(current_user), class: "block px-4 py-2 hover:transition-all hover:duration-300 hover:text-transparent hover:bg-clip-text hover:bg-gradient-to-tr hover:from-amber-300 hover:to-orange-500", role: "menuitem", tabindex: "-1", id: "user-menu-item-1" do %>
              الصفحة الشخصية
            <% end %>
            <%= link_to settings_user_settings_path, class: "block px-4 py-2 hover:transition-all hover:duration-300 hover:text-transparent hover:bg-clip-text hover:bg-gradient-to-tr hover:from-amber-300 hover:to-orange-500", role: "menuitem", tabindex: "-1", id: "user-menu-item-1" do %>
              اعدادات الحساب
            <% end %>
            <%= link_to logout_path, class: "block px-4 py-2 hover:transition-all hover:duration-300 hover:text-transparent hover:bg-clip-text hover:bg-gradient-to-tr hover:from-amber-300 hover:to-orange-500", role: "menuitem", tabindex: "-1", id: "user-menu-item-2",  method: :delete, 'data-turbo-method': :delete do %>
              خروج
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</nav>
