<meta name="viewport" content="width=device-width,initial-scale=1">
<%# Before anything paints: show dark when chosen, or when following a device that's in dark mode %>
<script>
  (function (root) {
    var theme = root.dataset.theme
    root.classList.toggle("dark", theme === "dark" || (theme === "system" && window.matchMedia("(prefers-color-scheme: dark)").matches))
  })(document.documentElement)
</script>
<%= csrf_meta_tags %>
<%= csp_meta_tag %>
<%= display_meta_tags(
  site: "نميم",
  reverse: true,
  separator: "—",
  og: { site_name: "نميم", locale: "ar_AR", type: "website", image: asset_url("brand/logo.png") },
  twitter: { site: "@nameemofficial", card: "summary_large_image" }
) %>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;700&family=Noto+Naskh+Arabic:wght@400;500;600;700&display=swap" rel="stylesheet">

<link rel="apple-touch-icon" sizes="180x180" href="<%= asset_path "brand/apple-touch-icon.png" %>">
<link rel="icon" type="image/png" sizes="32x32" href="<%= asset_path "brand/favicon-32x32.png" %>">
<link rel="icon" type="image/png" sizes="16x16" href="<%= asset_path "brand/favicon-16x16.png" %>">
<meta name="msapplication-TileColor" content="#da532c">
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#1b1916" media="(prefers-color-scheme: dark)">

<%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
<%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
<%= stylesheet_link_tag "actiontext", "data-turbo-track": "reload" %>

<script src="https://platform.twitter.com/widgets.js"></script>
<% if Rails.env.production? && (rum_key = Rails.application.credentials.dig(:digitup, :rum_key)) %>
  <script src="https://api.digitup.dev/v1/rum.js" data-key="<%= rum_key %>" defer></script>
<% end %>

<%= captcha_javascript_tag %>

<%= javascript_importmap_tags %>
<%= javascript_include_tag "activestorage" %>
