<%# The light/dark switch: a sun or moon (whichever is showing) opening light, dark and automatic %>
<div class="relative" data-controller="dropdown theme" data-theme-url-value="<%= theme_path %>"
     data-action="click->dropdown#toggle click@window->dropdown#hide">
  <button type="button" class="flex h-9 w-9 items-center justify-center rounded-full text-gray-400 transition-[transform,color] duration-150 hover:text-gray-600 active:scale-95 focus:outline-none focus-visible:ring-2 focus-visible:ring-orange-500"
          aria-haspopup="menu" aria-label="المظهر" title="المظهر">
    <svg class="h-5 w-5 dark:hidden" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />
    </svg>
    <svg class="hidden h-5 w-5 dark:block" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" />
    </svg>
  </button>

  <div data-dropdown-target="menu" role="menu" aria-label="المظهر"
       data-transition-enter="transition ease-out duration-150"
       data-transition-enter-from="opacity-0 -translate-y-1"
       data-transition-enter-to="opacity-100 translate-y-0"
       data-transition-leave="transition ease-in duration-100"
       data-transition-leave-from="opacity-100 translate-y-0"
       data-transition-leave-to="opacity-0 -translate-y-1"
       class="absolute left-0 z-20 mt-2 hidden w-36 origin-top-left rounded-xl bg-raised p-1 shadow-lg ring-1 ring-gray-900/10">
    <% [["light", "فاتح"], ["dark", "داكن"], ["system", "تلقائي"]].each do |theme, label| %>
      <button type="button" role="menuitemradio" aria-checked="<%= current_theme == theme %>"
              data-theme="<%= theme %>" data-theme-target="option" data-action="theme#choose"
              class="group flex w-full items-center justify-between rounded-lg px-3 py-2 text-sm text-gray-700 hover:bg-gray-100 aria-checked:font-semibold aria-checked:text-gray-900">
        <%= label %>
        <svg class="h-4 w-4 text-orange-600 invisible group-aria-checked:visible" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
        </svg>
      </button>
    <% end %>
  </div>
</div>
