<nav class="bg-transparent -inset-x-1 top-0 z-30 absolute shadow">
  <div class="mx-auto md:w-full sm:w-full lg:3/5 2xl:w-3/4 px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 justify-between">
      <div class="flex">
        <div class="sm:ml-1 mr-2 flex items-center md:hidden">
          <button type="button" class="relative inline-flex items-center justify-center rounded-md p-2 text-gray-400
                                       hover:bg-gray-100 hover:text-gray-500 focus:outline-none focus:ring-2
                                       focus:ring-inset focus:ring-indigo-500" aria-controls="mobile-menu" aria-expanded="false"
                                       data-controller="navigation--nav-bar-mobile" data-action="click->navigation--nav-bar-mobile#toggleMenu">
            <span class="absolute -inset-0.5"></span>
            <span class="sr-only">Open main menu</span>
            <svg class="block h-6 w-6 icon-menu-open" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
            </svg>
            <svg class="hidden h-6 w-6 icon-menu-closed" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
        <div class="flex flex-shrink-0 items-center">
          <a href="/">
            <img class="h-8 w-auto" src="<%= asset_path("brand/logo.png") %>" alt="نميم">
          </a>
        </div>
        <div class="hidden md:ml-6 md:flex md:space-x-8">
          <a href="/about-nameem" class="inline-flex rtl:ml-6 mr-4 items-center border-b-2 px-1 pt-1 text-lg font-medium <%= active_nav_path?("/about-nameem") %>">عن نميم</a>
          <% if !user_signed_in? %>
            <a href="/login" class="inline-flex items-center border-b-2 px-1 pt-1 text-lg font-medium <%= active_nav_path?("/login") %>">دخول</a>
          <% end %>
          <a href="/terms" class="inline-flex items-center border-b-2 px-1 pt-1 text-lg font-medium <%= active_nav_path?("/terms") %>" data-turbo="false">الشروط</a>
        </div>
      </div>
      <div class="flex items-center">
        <div class="flex-shrink-0">
          <% if !user_signed_in? %>
            <%= link_to signup_path, class: "relative rounded-full flex focus:outline-none focus:ring-0 gap-x-1.5 px-3 py-2 opacity-70 hover:opacity-100" do %>
              <span class="absolute -inset-1.5"></span>
              <%= heroicon "pencil-square" %>
              <span class="rtl:mr-1 font-bold mt-1">أكــتــب</span>
            <% end %>
          <% else %>
            <%= link_to new_story_path, class: "relative rounded-full flex focus:outline-none focus:ring-0 gap-x-1.5 px-3 py-2 opacity-70 hover:opacity-100" do %>
              <span class="absolute -inset-1.5"></span>
              <%= heroicon "pencil-square" %>
              <span class="font-bold mt-1">أكــتــب</span>
            <% end %>
         <% end %>
        </div>
        <div class="hidden md:ml-24 md:flex md:flex-shrink-0 md:items-center">

          <!-- Profile dropdown -->
          <% if user_signed_in? %>
            <div class="relative ml-3" data-controller="dropdown"
                  data-action="click->dropdown#toggle click@window->dropdown#hide">
              <div>
                <button type="button" class="relative flex rounded-full bg-white text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2" id="user-menu-button" aria-expanded="false" aria-haspopup="true">
                  <span class="absolute -inset-1.5"></span>
                  <span class="sr-only">Open user menu</span>
                  <% if Current.user.avatar.attached? %>
                    <%= image_tag Current.user.avatar.variant(resize_to_fill: [100, 100]), class: "h-8 w-8 rounded-full" %>
                  <% else %>
                      <span class="inline-block h-8 w-8 overflow-hidden rounded-full bg-gray-100">
                      <svg class="h-full w-full text-gray-300" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M24 20.993V24H0v-2.996A14.977 14.977 0 0112.004 15c4.904 0 9.26 2.354 11.996 5.993zM16.002 8.999a4 4 0 11-8 0 4 4 0 018 0z" />
                      </svg>
                  <% end %>
                </button>
              </div>

              <div data-dropdown-target="menu"
                  data-transition-enter="transition ease-out duration-200"
                  data-transition-enter-from="opacity-0 translate-y-1"
                  data-transition-enter-to="opacity-100 translate-y-0"
                  data-transition-leave="transition ease-in duration-150"
                  data-transition-leave-from="opacity-100 translate-y-0"
                  data-transition-leave-to="opacity-0 translate-y-1"
                  class="absolute hidden right-0 z-10 mt-2 w-40 origin-top-right rounded-md bg-white py-1 shadow-lg ring-1 ring-black ring-opacity-5 focus:outline-none"
                  role="menu" aria-orientation="vertical" aria-labelledby="user-menu-button">
                <%= link_to "الصفحة الشخصية", user_path(Current.user), data: { turbo: false }, class: "block px-4 py-2 hover:transition-all hover:duration-300
                hover:text-transparent hover:bg-clip-text hover:bg-gradient-to-tr hover:from-cyan-300 hover:to-blue-500", role: "menuitem", tabindex: "-1", id: "user-menu-item-0" %>
                <%= link_to settings_user_settings_path, class: "block px-4 py-2 hover:transition-all hover:duration-300 hover:text-transparent hover:bg-clip-text hover:bg-gradient-to-tr hover:from-cyan-300 hover:to-blue-500",
                  role: "menuitem", tabindex: "-1", id: "user-menu-item-1", data: { turbo: false }  do %>
                  اعدادات الحساب
                <% end %>

                <%= link_to "تسجيل خروج", logout_path, class: "block px-4 py-2 hover:transition-all hover:duration-300
                                                                          hover:text-transparent hover:bg-clip-text hover:bg-gradient-to-tr
                                                                          hover:from-cyan-300 hover:to-blue-500", role: "menuitem", method: :delete, 'data-turbo-method': :delete %>
              </div>
            </div>
          <% else %>
            <%= button_to signup_path, class: "relative h-8 px-6 m-2 text-lg text-white bg-gradient-to-l from-cyan-400 to-blue-500 hover:from-cyan-500 hover:to-blue-600 rounded-full focus:outline-none focus:ring-0", method: :get do %>
              <span class="absolute -inset-1.5"></span>
              <span class="btn-publish-text">حساب جديد</span>
            <% end %>
        <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Mobile menu, show/hide based on menu state. -->
  <div class="hidden lg:hidden bg-white mobile-menu" id="mobile-menu">
    <div class="space-y-1 pb-3 pt-2">
      <a href="/about-nameem" class="block border-l-4 border-transparent py-2 pl-3 pr-4 text-base font-medium <%= active_nav_path?("/about-nameem") %> sm:pl-5 sm:pr-6">عن نميم</a>
      <% if !user_signed_in? %>
        <a href="/login" class="block border-l-4 border-transparent py-2 pl-3 pr-4 text-base font-medium <%= active_nav_path?("/login") %> sm:pl-5 sm:pr-6">دخول</a>
      <% end %>
      <a href="/terms" class="block border-l-4 border-transparent py-2 pl-3 pr-4 text-base font-medium <%= active_nav_path?("/terms") %> sm:pl-5 sm:pr-6">الشروط</a>
    </div>
    <div class="border-t border-gray-200 pb-3 pt-4">
      <% if user_signed_in? %>
        <div class="flex items-center px-4 sm:px-6">
          <div class="flex-shrink-0">
            <% if Current.user.avatar.attached? %>
              <%= image_tag Current.user.avatar, class: "h-8 w-8 rounded-full" %>
            <% else %>
                <span class="inline-block h-8 w-8 overflow-hidden rounded-full bg-gray-100">
                <svg class="h-full w-full text-gray-300" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M24 20.993V24H0v-2.996A14.977 14.977 0 0112.004 15c4.904 0 9.26 2.354 11.996 5.993zM16.002 8.999a4 4 0 11-8 0 4 4 0 018 0z" />
                </svg>
            <% end %>
          </div>
          <div class="mr-3">
            <div class="text-base font-medium text-gray-800"><%= Current.user.name %></div>
          </div>
        </div>
        <div class="mt-3 space-y-1">
          <%= link_to "الصفحة الشخصية", user_path(Current.user), data: { turbo: false }, class: "block px-4 py-2 text-base font-medium text-gray-500 hover:bg-gray-100 hover:text-gray-800 sm:px-6" %>
          <%= link_to settings_user_settings_path, data: { turbo: false }, class: "block px-4 py-2 text-base font-medium text-gray-500 hover:bg-gray-100 hover:text-gray-800 sm:px-6" do %>
            اعدادات الحساب
          <% end %>
          <%= link_to "تسجيل الخروج", logout_path, class: "block px-4 py-2 text-base font-medium text-gray-500 hover:bg-gray-100 hover:text-gray-800 sm:px-6", method: :delete, 'data-turbo-method': :delete %>
        </div>
      <% else %>
        <%= button_to signup_path, class: "relative h-8 px-6 m-2 text-lg text-white bg-gradient-to-l from-cyan-400 to-blue-500 hover:from-cyan-500 hover:to-blue-600 rounded-full focus:outline-none focus:ring-0", method: :get do %>
          <span class="absolute -inset-1.5"></span>
          <span class="btn-publish-text">حساب جديد</span>
        <% end %>
      <% end %>
    </div>
  </div>
</nav>
