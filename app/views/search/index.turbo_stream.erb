<%= turbo_stream.append "search_results" do %>
  <% @articles.each do |article| %>
    <%= render "feed/article", article: article %>
  <% end %>
<% end %>

<% if @pagy&.next %>
  <%= turbo_stream.append "search_pagination" do %>
    <%= turbo_frame_tag "search_pagination", src: search_path(q: @query, page: @pagy.next, format: :turbo_stream), loading: "lazy" %>
  <% end %>
<% end %>
