<%= turbo_frame_tag "modal", target: "_top" do %>
  <div class="relative z-10 font-naskh" data-controller="modals--article-modal" aria-labelledby="modal-title" role="dialog" aria-modal="true" dir="rtl">
    <div class="fixed modal inset-0 bg-white transition-opacity"></div>
      <div class="fixed inset-0 z-10 w-screen overflow-y-auto">
        <div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0">
          <div class="relative modal-panel lg:grid md:grid md:grid-cols-1 transform overflow-hidden rounded-lg bg-white px-4 pb-4 pt-5 text-left shadow-xl transition-all sm:my-8 sm:w-3/12 sm:p-6">
            <div class="absolute left-0 top-0 hidden pl-4 pt-4 sm:block">
              <button type="button" data-action="click->modals--article-modal#closeModal" class="rounded-md bg-white text-gray-400 hover:text-gray-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2">
                <span class="sr-only">Close</span>
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
              </button>
            </div>

            <div class="mt-3 text-right sm:mt-5">
              <h3 class="text-base font-bold leading-6 text-gray-900" id="modal-title">معاينة الموضوع</h3>
              <div class="mt-2">
                <div class="w-full h-56 flex justify-center items-center rounded-2xl border-2 border-dashed border-gray-300">
                  <% if !@article.article_images.empty? %>
                    <%= image_tag article_cover(@article), class: "p-1 rounded-xl object-cover h-full w-full" %>
                  <% else %>
                    <span class="mt-2 text-sm font-semibold text-gray-900">أدرج صورة عالية الجودة في قصتك لجعلها أكثر جاذبية للقراء.</span>
                  <% end %>
                </div>
                <div class="mt-4 title-box">
                  <% if @article.title.blank? && @article.alternative_titles.blank? %>
                    <span class="title-needed mt-2 text-sm font-semibold text-gray-400">العنوان مطلوب </span>
                  <% else %>
                    <h3 class="text-base font-extrabold leading-6 text-gray-900 truncate" id="modal-title"><%= @article.title.presence || first_paragraph(@article) %></h3>
                  <% end %>
                </div>
                <hr class="mt-2">
                <div class="mt-4">
                  <span class="text-base leading-6 text-gray-400">معاينة الموضوع لن تؤثر على ما يتضمنه الموضوع من محتوى، هي مجرد معاينة لشكل الموضوع عند مشاركته على منصات أخرى أو في الصفحة الرئيسية.</span>
                </div>
              </div>
            </div>

            <div class="mt-5 sm:mt-6 flex w-2/5 sm:gap-3">
              <%= button_to "نشر", article_path(params[:uuid], published: true), class: "flex-1 rounded-lg px-3 py-2 text-sm
                            font-semibold text-white shadow-sm text-white bg-gradient-to-l from-cyan-400 to-blue-500
                            publish-btn hover:from-cyan-500 hover:to-blue-600 focus-visible:outline
                            focus-visible:outline-2 focus-visible:outline-offset-2 text-lg w-24", method: :put, data: { turbo: false } %>

              <%= button_to "حفظ كمسودة", article_path(params[:uuid], published: false), class: "flex-1 rounded-md bg-gray-500 px-3 py-2 text-sm font-semibold
                            text-white shadow-sm hover:bg-gray-600 focus-visible:outline focus-visible:outline-2
                            focus-visible:outline-offset-2 focus-visible:outline-indigo-600", method: :put, data: { turbo: false } %>
            </div>

          </div>
        </div>
      </div>
    </div>
  </div>
<% end %>
