<%# Analytics Modal %>
<div id="article-analytics" class="hidden relative z-50" data-modal-target="container" data-action="keydown@window->modal#escape" role="dialog" aria-modal="true" aria-label="إحصائيات المقال">
  <%# Backdrop %>
  <div class="fixed inset-0 bg-gray-500/75 transition-opacity duration-200 ease-out opacity-0" data-modal-target="overlay"></div>

  <div class="fixed inset-0 z-10 overflow-y-auto">
    <div class="flex min-h-full items-center justify-center p-4" data-action="click->modal#outside">
      <%# Panel %>
      <div class="relative w-full max-w-lg transform rounded-xl bg-white shadow-xl transition-all duration-200 ease-out opacity-0 scale-95" data-modal-target="panel">
        <%# Header %>
        <div class="flex items-center justify-between border-b border-gray-200 px-6 py-4">
          <h2 class="text-base font-semibold text-gray-900">إحصائيات المقال</h2>
          <button type="button" class="text-gray-400 hover:text-gray-500 cursor-pointer" data-action="modal#close">
            <span class="sr-only">إغلاق</span>
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <%# Stat numbers %>
        <div class="grid grid-cols-3 gap-4 px-6 pt-6">
          <div class="rounded-lg bg-gray-50 p-4 text-center">
            <p class="text-2xl font-bold text-gray-900"><%= number_with_delimiter(article.real_views_count) %></p>
            <p class="text-sm text-gray-500">المشاهدات</p>
          </div>
          <div class="rounded-lg bg-gray-50 p-4 text-center">
            <p class="text-2xl font-bold text-gray-900"><%= number_with_delimiter(article.likes_count) %></p>
            <p class="text-sm text-gray-500">الإعجابات</p>
          </div>
          <div class="rounded-lg bg-gray-50 p-4 text-center">
            <p class="text-2xl font-bold text-gray-900"><%= number_with_delimiter(article.comments_count) %></p>
            <p class="text-sm text-gray-500">التعليقات</p>
          </div>
        </div>

        <%# Likers list %>
        <% if likers.any? %>
          <div class="px-6 pt-5">
            <h3 class="text-sm font-medium text-gray-900 mb-3">أعجبهم المقال (<%= article.likes_count %>)</h3>
            <div class="max-h-48 overflow-y-auto space-y-2">
              <% likers.each do |user| %>
                <%= link_to user_path(user), class: "flex items-center gap-3 rounded-lg p-2 hover:bg-gray-50 transition-colors", data: { turbo: false } do %>
                  <% if user.avatar.attached? %>
                    <%= image_tag user.avatar.variant(resize_to_fill: [64, 64]), class: "h-8 w-8 rounded-full bg-gray-50 shrink-0", alt: user.name %>
                  <% else %>
                    <span class="inline-block h-8 w-8 shrink-0 overflow-hidden rounded-full bg-gray-100">
                      <svg class="h-full w-full text-gray-300" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M24 20.993V24H0v-2.996A14.977 14.977 0 0112.004 15c4.904 0 9.26 2.354 11.996 5.993zM16.002 8.999a4 4 0 11-8 0 4 4 0 018 0z" />
                      </svg>
                    </span>
                  <% end %>
                  <span class="text-sm text-gray-700"><%= user.name %></span>
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>

        <%# Commenters list %>
        <% if commenters.any? %>
          <div class="px-6 pt-5 pb-6">
            <h3 class="text-sm font-medium text-gray-900 mb-3">علّقوا على المقال (<%= article.comments_count %>)</h3>
            <div class="max-h-48 overflow-y-auto space-y-2">
              <% commenters.each do |user| %>
                <%= link_to user_path(user), class: "flex items-center gap-3 rounded-lg p-2 hover:bg-gray-50 transition-colors", data: { turbo: false } do %>
                  <% if user.avatar.attached? %>
                    <%= image_tag user.avatar.variant(resize_to_fill: [64, 64]), class: "h-8 w-8 rounded-full bg-gray-50 shrink-0", alt: user.name %>
                  <% else %>
                    <span class="inline-block h-8 w-8 shrink-0 overflow-hidden rounded-full bg-gray-100">
                      <svg class="h-full w-full text-gray-300" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M24 20.993V24H0v-2.996A14.977 14.977 0 0112.004 15c4.904 0 9.26 2.354 11.996 5.993zM16.002 8.999a4 4 0 11-8 0 4 4 0 018 0z" />
                      </svg>
                    </span>
                  <% end %>
                  <span class="text-sm text-gray-700"><%= user.name %></span>
                <% end %>
              <% end %>
            </div>
          </div>
        <% else %>
          <div class="pb-6"></div>
        <% end %>
      </div>
    </div>
  </div>
</div>
