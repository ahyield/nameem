<% title "نميم | حساب جديد" %>

<%= render "shared/nav" %>
<%= render "flashes/error", error: flash[:error] if !flash[:error].nil? %>

<div class="new-account-form flex min-h-full flex-col justify-center py-12 sm:px-6 lg:px-8 pt-20" dir="ltr">
  <div class="sm:mx-auto sm:w-full sm:max-w-md">
    <img class="mx-auto h-10 w-auto" src="<%= asset_path("brand/logo.png") %>" alt="Nameem">
    <h2 class="mt-6 text-center text-2xl font-bold leading-9 tracking-tight text-gray-900">حساب جديد</h2>
  </div>
  <div class="mt-10 sm:mx-auto sm:w-full sm:max-w-[480px]">
    <div class="bg-white px-6 space-y-4 py-12 shadow sm:rounded-lg sm:px-12">
      <%= form_for "sign_up", url: signup_path, method: :post, class: "space-y-6 font-montserrat" do |form| %>
        <div class="text-left">
          <label for="email" class="block text-sm font-medium leading-6 text-gray-900 text-right">البريد الاليكتروني</label>
          <div class="mt-2">
            <%= form.text_field :email, id: "email", type: "email", autocomplete: "email", required: true,
              class: "block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" %>
          </div>
        </div>
        <%= form.button "تسجيل", class: "flex font-naskh w-full justify-center rounded-md
                                     text-white bg-gradient-to-l from-cyan-400 to-blue-500 hover:from-cyan-500 hover:to-blue-600 px-3 py-1.5 text-sm font-semibold
                                     leading-6 text-white shadow-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2
                                     focus-visible:outline-indigo-600" %>
      <div data-controller="cloudflare-turnstile">
        <%= captcha_placeholder_tag action: "signup" %>
      </div>
      <% end %>
    </div>
  </div>
</div>
<%= render "shared/footer" %>
