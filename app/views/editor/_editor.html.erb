<div id="editor" data-controller="editor" class="relative mx-auto w-full px-5 sm:w-3/5 sm:px-0">
  <div class="tooltip-controls hidden" data-action="click@window->editor#hideToolTip">
    <div class="tooltip-inner" role="toolbar" aria-label="تنسيق">
      <button data-action="click->editor#toggleBold" title="عريض" aria-label="عريض" class="tooltip-btn-text" style="font-weight: 700">B</button>
      <button data-action="click->editor#toggleItalic" title="مائل" aria-label="مائل" class="tooltip-btn-text" style="font-family: Georgia, serif; font-size: 17px; font-style: italic">I</button>
      <button data-action="click->editor#toggleLink" title="رابط" aria-label="رابط">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244" /></svg>
      </button>
      <span class="tooltip-separator" aria-hidden="true"></span>
      <button data-action="click->editor#toggleHead1" title="عنوان رئيسي" aria-label="عنوان رئيسي" class="tooltip-btn-text" style="font-weight: 700">H1</button>
      <button data-action="click->editor#toggleHead2" title="عنوان فرعي" aria-label="عنوان فرعي" class="tooltip-btn-text" style="font-size: 12px; font-weight: 700">H2</button>
      <button data-action="click->editor#toggleQuote" title="اقتباس" aria-label="اقتباس" class="tooltip-btn-text" style="font-size: 22px; padding-top: 9px; font-family: Georgia, serif">&ldquo;</button>
      <button data-action="click->editor#toggleCode" title="كود ضمن السطر" aria-label="كود ضمن السطر">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75 22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3-4.5 16.5" /></svg>
      </button>
    </div>
    <div class="tooltip-arrow"></div>
  </div>
  <input type="text" autocomplete="off" placeholder="الصق الرابط واضغط Enter..." dir="ltr" id="link"
        data-action="click@window->editor#hideLinkTip keydown.enter->editor#enterLinkTip keydown.esc->editor#closeTips"
        class="link-tip hidden shadow-none focus:ring-0 border-0 placeholder:italic placeholder:text-gray-500 text-sm" name="link">
  <input type="text" autocomplete="off" placeholder="الصق رابط الفيديو واضغط Enter..." dir="ltr" id="video"
        data-action="click@window->editor#hideVideoTip keydown.enter->editor#enterVideoTip keydown.esc->editor#closeTips"
        class="video-input hidden shadow-none focus:ring-0 border-0 placeholder:italic placeholder:text-gray-500 text-sm" name="video">
  <input type="text" autocomplete="off" placeholder="الصق رابط التغريدة واضغط Enter..." dir="ltr" id="tweet"
        data-action="click@window->editor#hideTweetTip keydown.enter->editor#enterTweetTip keydown.esc->editor#closeTips"
        class="tweet-input hidden shadow-none focus:ring-0 border-0 placeholder:italic placeholder:text-gray-500 text-sm" name="tweet">

  <div class="show-controls">
    <button data-action="click->editor#toggleControls" class="insert-toggle" aria-label="إدراج" title="إدراج">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
    </button>
  </div>

  <div class="hidden sidebar-controls">
    <div class="sidebar-inner" role="toolbar" aria-label="إدراج">
      <button data-action="click->editor#imageUpload" title="صورة" aria-label="صورة">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" /></svg>
      </button>
      <button data-action="click->editor#toggleVideoInput" title="فيديو" aria-label="فيديو">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z M15.91 11.672a.375.375 0 0 1 0 .656l-5.603 3.113a.375.375 0 0 1-.557-.328V8.887c0-.286.307-.466.557-.327l5.603 3.112Z" /></svg>
      </button>
      <button data-action="click->editor#toggleTweetInput" title="تغريدة" aria-label="تغريدة">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="tweet-icon"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" /></svg>
      </button>
      <button data-action="click->editor#toggleDivder" title="فاصل" aria-label="فاصل">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14" /></svg>
      </button>
      <button data-action="click->editor#insertCode" title="كود" aria-label="كود">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75 22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3-4.5 16.5" /></svg>
      </button>
      <span class="sidebar-separator" aria-hidden="true"></span>
      <button data-action="click->editor#toggleControls" title="إغلاق" aria-label="إغلاق" class="sidebar-close">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
      </button>
    </div>
  </div>

  <div class="h-full mt-8 sm:mt-20 title">
    <input type="text" autocomplete="off" placeholder="العنوان" dir="rtl" id="article-title" data-action="keyup->editor#upsertTitle" class="border-0 px-0 placeholder:opacity-50 text-gray-950
    placeholder:text-grey-300 w-full focus:ring-0 text-3xl sm:text-5xl">
  </div>
  <hr class="h-px bg-slate-200 border-0 w-1/2">

  <%# Language of the code block the caret is in; options are filled from CODE_LANGUAGES in editor_config.js %>
  <select class="code-language" hidden aria-label="لغة الكود" data-action="change->editor#setCodeLanguage"></select>

  <div class="h-full editor-container mt-6 sm:mt-10" contenteditable="true" dir="rtl">
  </div>
</div>

<%= render "editor/help" %>
<%= turbo_frame_tag "modal" %>
