<div id="editor" data-controller="editor" class="relative mx-auto w-full px-5 sm:w-3/5 sm:px-0">
  <div class="tooltip-controls hidden" data-action="click@window->editor#hideToolTip">
    <div class="tooltip-inner">
      <button data-action="click->editor#toggleBold" title="عريض"><i class="fa-solid fa-bold"></i></button>
      <button data-action="click->editor#toggleItalic" title="مائل"><i class="fa-solid fa-italic"></i></button>
      <button data-action="click->editor#toggleLink" title="رابط"><i class="fa-solid fa-link"></i></button>
      <span class="tooltip-separator"></span>
      <button data-action="click->editor#toggleHead1" title="عنوان رئيسي" class="tooltip-btn-text">H1</button>
      <button data-action="click->editor#toggleHead2" title="عنوان فرعي" class="tooltip-btn-text">H2</button>
      <button data-action="click->editor#toggleQuote" title="اقتباس"><i class="fa-solid fa-quote-right"></i></button>
    </div>
    <div class="tooltip-arrow"></div>
  </div>
  <input type="text" autocomplete="off" placeholder="الصق الرابط واضغط Enter..." dir="ltr" id="link"
        data-action="click@window->editor#hideLinkTip keydown.enter->editor#enterLinkTip keydown.esc->editor#closeTips"
        class="link-tip hidden shadow-none focus:ring-0 border-0 placeholder:italic placeholder:text-gray-500 bg-[#1e1e1e] text-white text-sm rounded-lg px-3 py-2" name="link">
  <input type="text" autocomplete="off" placeholder="الصق رابط الفيديو واضغط Enter..." dir="ltr" id="video"
        data-action="click@window->editor#hideVideoTip keydown.enter->editor#enterVideoTip keydown.esc->editor#closeTips"
        class="video-input hidden shadow-none focus:ring-0 border-0 placeholder:italic placeholder:text-gray-500 bg-[#1e1e1e] text-white text-sm rounded-lg px-3 py-2" name="video">
  <input type="text" autocomplete="off" placeholder="الصق رابط التغريدة واضغط Enter..." dir="ltr" id="tweet"
        data-action="click@window->editor#hideTweetTip keydown.enter->editor#enterTweetTip keydown.esc->editor#closeTips"
        class="tweet-input hidden shadow-none focus:ring-0 border-0 placeholder:italic placeholder:text-gray-500 bg-[#1e1e1e] text-white text-sm rounded-lg px-3 py-2" name="tweet">

  <div class="show-controls">
    <button data-action="click->editor#toggleControls" class="insert-toggle">
      <i class="fa-solid fa-plus"></i>
    </button>
  </div>

  <div class="hidden sidebar-controls">
    <div class="sidebar-inner">
      <button data-action="click->editor#imageUpload" title="صورة">
        <i class="fa-solid fa-image"></i>
      </button>
      <button data-action="click->editor#toggleVideoInput" title="فيديو">
        <i class="fa-brands fa-youtube"></i>
      </button>
      <button data-action="click->editor#toggleTweetInput" title="تغريدة">
        <i class="fa-brands fa-twitter"></i>
      </button>
      <button data-action="click->editor#toggleDivder" title="فاصل">
        <i class="fa-solid fa-minus"></i>
      </button>
      <button data-action="click->editor#toggleControls" title="إغلاق" class="sidebar-close">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>
  </div>

  <div class="h-full mt-8 sm:mt-20 title">
    <input type="text" autocomplete="off" placeholder="العنوان" dir="rtl" id="article-title" data-action="keyup->editor#upsertTitle" class="border-0 px-0 placeholder:opacity-50 text-gray-950
    placeholder:text-grey-300 w-full focus:ring-0 text-3xl sm:text-5xl">
  </div>
  <hr class="h-px bg-slate-200 border-0 w-1/2">

  <div class="h-full editor-container mt-6 sm:mt-10" contenteditable="true" dir="rtl">
  </div>
</div>

<%= turbo_frame_tag "modal" %>
