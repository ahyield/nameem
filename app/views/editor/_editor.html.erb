<div id="editor" data-controller="editor">
  <div class="tooltip-controls">
    <button id="bold-button" data-action="click->editor#toggleBold"><i class="fa-solid fa-bold"></i></button>
    <button id="italic-button" data-action="click->editor#toggleItalic"><i class="fa-solid fa-italic"></i></button>
    <button id="link-button"><i class="fa-solid fa-link"></i></button>
    <button id="blockquote-button" data-action="click->editor#toggleQuote"><i class="fa-solid fa-quote-left"></i></button>
    <button id="header-1-button" data-action="click->editor#toggleHead1"><i class="fa-solid fa-heading"></i><small>1</small></button>
    <button id="header-2-button" data-action="click->editor#toggleHead2"><i class="fa-solid fa-heading"></i><small>2</small></button>
  </div>
  <div id="sidebar-controls">
    <button id="show-controls"><i class="fa fa-plus"></i></button>
    <span class="controls">
      <button id="image-button"><i class="fa-solid fa-image"></i></button>
      <button id="video-button"><i class="fa-brands fa-youtube"></i></button>
      <button id="tweet-button"><i class="fa-brands fa-twitter" aria-hidden="true"></i></button>
      <button id="divider-button"><%= heroicon "ellipsis-horizontal" %></button>
    </span>
  </div>

  <div class="h-full mt-20 border-dashed border-2 editor-container">
  </div>
</div>
