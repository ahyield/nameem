<div id="editor" data-controller="editor" class="w-3/5 mx-auto">
  <div class="tooltip-controls hidden space-x-3 bg-gradient-to-r from-cyan-500 to-blue-500 rounded-lg" data-action="click@window->editor#hideToolTip">
    <button id="bold-button" data-action="click->editor#toggleBold"><i class="fa-solid fa-bold"></i></button>
    <button id="italic-button" class="pr-4" data-action="click->editor#toggleItalic"><i class="fa-solid fa-italic"></i></button>
    <button id="link-button" data-action="click->editor#toggleLink"><i class="fa-solid fa-link"></i></button>
    <span class="tooltip-separator"></span>
    <button id="blockquote-button" data-action="click->editor#toggleQuote"><i class="fa-solid fa-quote-left"></i></button>
    <button id="header-1-button" data-action="click->editor#toggleHead1"><i class="fa-solid fa-t head1"></i></button>
    <button id="header-2-button" data-action="click->editor#toggleHead2"><i class="fa-solid fa-t head2"></i></button>
  </div>
  <input type="text" autocomplete="off" placeholder="Paste or write link.." dir="ltr" id="link"
        data-action="click@window->editor#hideLinkTip keydown.enter->editor#enterLinkTip keydown.esc->editor#closeTips"
        class="link-tip hidden shaddow-none focus:ring-0 border-0 placeholder:italic placeholder:text-slate-200 bg-gradient-to-r from-cyan-500 text-slate-50 to-blue-500 rounded-lg" name="link">
  <div class="hidden sidebar-controls h-7 space-x-3 bg-gradient-to-r from-cyan-300 to-blue-500 rounded-full text-slate-50">
    <button id="image-button" data-action="click->editor#imageUpload">
      <i class="fa-solid fa-image"></i>
      <div class="absolute inset-0 ring-inset"></div>
    </button>
      <!--
      <hr class="h-px bg-slate-200 border-0">
      <li><button id="video-button"><i class="fa-brands fa-youtube"></i></button></li>
      <hr class="h-px bg-slate-200 border-0">
      <li><button id="tweet-button"><i class="fa-brands fa-twitter" aria-hidden="true"></i></button></li>
      -->
  </div>

  <div class="h-full mt-20 title">
    <input type="text" autocomplete="off" placeholder="العنوان" dir="rtl" id="article-title" data-action="keyup->editor#upsertTitle" class="border-0 placeholder:opacity-50 text-black
    placeholder:text-grey-300 w-full focus:ring-0 text-5xl">
  </div>
  <hr class="h-px bg-slate-200 border-0 w-1/2">
  <div class="h-full editor-container mt-10">
  </div>
</div>

<%= turbo_frame_tag "modal" %>
