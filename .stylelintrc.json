{
  "ignoreFiles": ["./app/assets/stylesheets/application.tailwind.css", "./app/assets/stylesheets/actiontext.css", "./public/404.html", "./public/500.html", "./public/422.html", "./public/500.html"],
  "extends": ["stylelint-config-standard"],
  "rules": {
      "declaration-block-no-duplicate-properties": [
          true,
          {
              "ignore": ["consecutive-duplicates-with-different-values"]
          }
      ],
      "at-rule-no-unknown": [
        true,
        {
          "ignoreAtRules": ["tailwind"]
        }
      ]
  }
}
