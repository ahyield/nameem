# Copy to .env.development (or .env.production for deploys) and fill in.
# These files are gitignored.

MYSQL_USERNAME=root
MYSQL_ROOT_PASSWORD=
RAILS_MAX_THREADS=5

# Only needed for deploys
# RAILS_MASTER_KEY=
# KAMAL_REGISTRY_PASSWORD=
# WEB_HOST=
# DB_HOST=

# Email (production). Each one falls back to Rails credentials when empty.
# RESEND_API_KEY=            # resend.com > API Keys (credentials: resend.api_key)
# RESEND_WEBHOOK_SECRET=     # resend.com > Webhooks > signing secret, starts with whsec_ (credentials: resend.webhook_secret)
# MAILER_POSTAL_ADDRESS=     # shown in marketing email footers; quote it if it has spaces (credentials: mailer.postal_address)
